<?xml version="1.0" encoding="utf-8"?>
<!--
  Where DNN Manager's packages come from: nuget.org only. <clear/> drops every source a machine-wide or user
  NuGet.Config adds (a private feed, an offline cache), and the source mapping sends every package (pattern *) to
  nuget.org - a package of the same name on another feed is never used. packages.lock.json pins the versions and
  their hashes; this file pins where they are looked up. CI and releases restore with the same file.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
