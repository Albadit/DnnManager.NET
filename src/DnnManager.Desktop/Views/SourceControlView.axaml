<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:DnnManager.Desktop.Views"
             x:Class="DnnManager.Desktop.Views.SourceControlView"
             x:DataType="v:SourceControlView">
  <!-- Source Control, laid out as VS Code's (and as the Windows app's Pages/SourceControlPage): in the side bar an icon
       each for Source Control, the Explorer and Search (Ctrl+Shift+G, E, F); Source Control's view has the servers (its
       repositories), the message and Push, the changes in groups - staged, to push, to pull, conflicts - each with its
       status letter, and the history (its graph). The editor has the open files as tabs - a change's diff, a project's
       file as it is - or the chosen operation of the history. -->
  <UserControl.Styles>
    <!-- A section's title, as VS Code writes it: small capitals, muted. -->
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="{DynamicResource TextSmall}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="FontSize" Value="{DynamicResource TextHint}" />
    </Style>
    <Style Selector="TextBlock.ico">
      <Setter Property="FontFamily" Value="{x:Static v:Icon.Font}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A small icon button: 24 px square. -->
    <Style Selector="Button.small">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="{x:Static v:Icon.Font}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- VS Code's status letters and their colours: M modified, A added, D deleted, ! conflict. -->
    <Style Selector="TextBlock.letter">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Width" Value="16" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A row's buttons show while the pointer is on it, or it is chosen - VS Code's inline actions. -->
    <Style Selector="StackPanel.actions">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBoxItem:pointerover StackPanel.actions, ListBoxItem:selected StackPanel.actions">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- A tab's or an open editor's ×: there while the pointer is on its row, or it is chosen - its place kept. -->
    <Style Selector="Button.hoverclose">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Button.hoverclose, ListBoxItem:selected Button.hoverclose">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- The rows of the side bar's lists, as WPF's: a little in from the edges. -->
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="CornerRadius" Value="{DynamicResource SmallRadius}" />
    </Style>
    <!-- A chevron that turns down when open (a section of the side bar). -->
    <Style Selector="ToggleButton.chev">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bd" Background="Transparent" Width="24" Height="24" CornerRadius="{DynamicResource ControlRadius}">
            <TextBlock Name="Glyph" Text="{x:Static v:Icon.ChevronRight}" FontFamily="{x:Static v:Icon.Font}" FontSize="10"
                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.chev:pointerover /template/ Border#Bd">
      <Setter Property="Background" Value="{DynamicResource HoverBg}" />
    </Style>
    <Style Selector="ToggleButton.chev:checked /template/ TextBlock#Glyph">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <!-- The side bar's views, as VS Code's activity bar on top: an icon each, the one shown with a line under it. -->
    <Style Selector="ToggleButton.viewtab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="Padding" Value="9,8" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ToggleButton.viewtab /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.viewtab:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.viewtab:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.viewtab:checked /template/ ContentPresenter#PART_ContentPresenter,
                     ToggleButton.viewtab:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ToggleButton.viewtab /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="ToggleButton.viewtab:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.viewtab:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="ToggleButton.viewtab:pointerover, ToggleButton.viewtab:checked">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="ToggleButton.viewtab Border.line">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.viewtab:checked Border.line">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="ToggleButton.viewtab Path">
      <Setter Property="StrokeThickness" Value="1.2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <!-- A part of the Push bar: VS Code's Commit button is one blue bar, its ▾ a part of it behind a thin line. -->
    <Style Selector="Button.split">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.split:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.split:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.split:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHover}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.split:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <!-- A small toggle in the search box - Match Case, Match Whole Word, Use Regular Expression - as VS Code's. -->
    <Style Selector="ToggleButton.find">
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="FontSize" Value="{DynamicResource TextSmall}" />
    </Style>
    <!-- The tabs, as VS Code's: the chosen one on the editor's colour with a line along its top. -->
    <Style Selector="ListBox#Tabs ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox#Tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox#Tabs ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox#Tabs ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WindowBg}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="ListBox#Tabs ListBoxItem Border.tabline">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#Tabs ListBoxItem:selected Border.tabline">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.warn">
      <Setter Property="Background" Value="{DynamicResource WarnBannerBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarnBannerBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="TextBox.search">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="6,2" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <v:LetterBrushConverter x:Key="LetterBrush" />
  </UserControl.Resources>

  <Grid x:Name="Root" ColumnDefinitions="300,4,*">
    <!-- ─── The side bar ─── -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarBg}">
      <DockPanel x:Name="SideGrid">
        <!-- Source Control, Explorer and Search: an icon each across the top, the chosen view under them. -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="7,0">
          <StackPanel Orientation="Horizontal">
            <ToggleButton x:Name="ScmTab" Classes="viewtab" IsChecked="True" Click="ViewTab_Click"
                          AutomationProperties.Name="Source Control" ToolTip.Tip="Source Control (Ctrl+Shift+G)">
              <Grid>
                <Viewbox Width="14" Height="14">
                  <Grid Width="16" Height="16"><Path Data="{StaticResource SourceControlGeometry}" Stroke="{Binding $parent[ToggleButton].Foreground}" /></Grid>
                </Viewbox>
                <!-- How many files differ - VS Code's badge. -->
                <Border x:Name="ChangeBadge" Background="{DynamicResource Accent}" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-9,-5" IsVisible="False">
                  <TextBlock x:Name="ChangeBadgeText" Foreground="{DynamicResource OnAccent}" FontSize="9" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Classes="line" Height="2" VerticalAlignment="Bottom" Margin="-3,0,-3,-8" />
              </Grid>
            </ToggleButton>
            <ToggleButton x:Name="ExplorerTab" Classes="viewtab" Click="ViewTab_Click"
                          AutomationProperties.Name="Explorer" ToolTip.Tip="Explorer - the project's files and the open editors (Ctrl+Shift+E)">
              <Grid>
                <Viewbox Width="14" Height="14">
                  <Grid Width="16" Height="16"><Path Data="{StaticResource ExplorerGeometry}" Stroke="{Binding $parent[ToggleButton].Foreground}" /></Grid>
                </Viewbox>
                <Border Classes="line" Height="2" VerticalAlignment="Bottom" Margin="-3,0,-3,-8" />
              </Grid>
            </ToggleButton>
            <ToggleButton x:Name="SearchTab" Classes="viewtab" Click="ViewTab_Click"
                          AutomationProperties.Name="Search" ToolTip.Tip="Search - find and replace in the project's files (Ctrl+Shift+F)">
              <Grid>
                <Viewbox Width="14" Height="14">
                  <Grid Width="16" Height="16"><Path Data="{StaticResource SearchGeometry}" Stroke="{Binding $parent[ToggleButton].Foreground}" /></Grid>
                </Viewbox>
                <Border Classes="line" Height="2" VerticalAlignment="Bottom" Margin="-3,0,-3,-8" />
              </Grid>
            </ToggleButton>
          </StackPanel>
        </Border>

        <Panel>
          <!-- ═══ SOURCE CONTROL ═══ -->
          <Grid x:Name="ScmView" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,220">
            <!-- SOURCE CONTROL, and what VS Code has on its title: compare (refresh), add, more. -->
            <DockPanel Grid.Row="0" Margin="16,10,8,4">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ScanButton" Classes="icon small" Content="{x:Static v:Icon.Refresh}" Click="Scan_Click"
                        ToolTip.Tip="Compare with the server (F5) - what changed in the project, on the server, or in both" AutomationProperties.Name="Compare" />
                <Button Classes="icon small" Content="{x:Static v:Icon.Add}" Click="Add_Click" ToolTip.Tip="Add a server to a project"
                        AutomationProperties.Name="Add a server" />
                <Button x:Name="MoreButton" Classes="icon small" Content="{x:Static v:Icon.More}" Click="More_Click"
                        ToolTip.Tip="More actions: stage all, unstage all, edit, test or remove the server" AutomationProperties.Name="More actions" />
              </StackPanel>
              <TextBlock Classes="title" Text="SOURCE CONTROL" />
            </DockPanel>
            <ProgressBar x:Name="ProgressBar" Grid.Row="1" Height="2" MinHeight="2" Foreground="{DynamicResource Accent}" Background="Transparent"
                         Opacity="0" AutomationProperties.Name="Progress" />

            <!-- SERVERS - every project's, VS Code's repositories. Ctrl+click or Shift+click chooses more than one. -->
            <StackPanel Grid.Row="2">
              <DockPanel Margin="4,2,8,0">
                <ToggleButton x:Name="ServersToggle" DockPanel.Dock="Left" Classes="chev" IsChecked="True" AutomationProperties.Name="Servers" />
                <TextBlock Classes="title" Text="SERVERS" Margin="2,0,0,0" />
              </DockPanel>
              <ListBox x:Name="ServersList" Classes="rows" SelectionMode="Multiple" MaxHeight="190" Margin="4,0,4,4"
                       SelectionChanged="Server_Changed" AutomationProperties.Name="Servers" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       IsVisible="{Binding #ServersToggle.IsChecked}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="v:ServerRow">
                    <DockPanel ToolTip.Tip="{Binding Tip}" Background="Transparent">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Counts}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                 Margin="8,0,0,0" FontSize="{DynamicResource TextSmall}" />
                      <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Health}" />
                      <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Site}" FontWeight="SemiBold" />
                        <Run Text="{Binding Name}" />
                        <Run Text="{Binding Detail}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextSmall}" />
                      </TextBlock>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Compare" InputGesture="F5" Click="Scan_Click" />
                    <MenuItem Header="Edit connection…" Click="Edit_Click" />
                    <MenuItem Header="Test connection" Click="Test_Click" />
                    <MenuItem Header="Open the local folder" Click="OpenFolder_Click" />
                    <Separator />
                    <MenuItem Header="Remove connection…" Click="Remove_Click" />
                  </ContextMenu>
                </ListBox.ContextMenu>
              </ListBox>
              <TextBlock x:Name="NoServers" Classes="hint" Margin="16,4,12,6" TextWrapping="Wrap" IsVisible="False"
                         Text="No servers yet. Add one with + - a project's FTP or SFTP server, to compare the project with it and push and pull its files." />
            </StackPanel>

            <!-- CHANGES - its header; the message, Push (its ▾ the rest), and the groups. -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="4,4,8,0">
              <DockPanel>
                <TextBlock x:Name="ScanSummary" DockPanel.Dock="Right" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextSmall}"
                           VerticalAlignment="Center" />
                <ToggleButton DockPanel.Dock="Left" Classes="chev" IsChecked="True" IsEnabled="False" />
                <TextBlock DockPanel.Dock="Left" Classes="title" Text="CHANGES" Margin="2,0,0,0" />
                <!-- Several servers chosen: which one's changes these are - a click shows another's. -->
                <Button x:Name="ChangesServer" Classes="link" Margin="8,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                        IsVisible="False" Click="ChangesServer_Click" ToolTip.Tip="Several servers are chosen - show another one's changes"
                        AutomationProperties.Name="Show another chosen server's changes">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ChangesServerText" FontSize="{DynamicResource TextSmall}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                    <TextBlock Classes="ico" Text="{x:Static v:Icon.ChevronDown}" FontSize="9" Margin="4,0,0,0" />
                  </StackPanel>
                </Button>
              </DockPanel>
            </Border>
            <StackPanel x:Name="CommitArea" Grid.Row="4" Margin="16,6,12,6">
              <TextBox x:Name="CommitMessage" Classes="search" PlaceholderText="Message (Ctrl+Enter to push)" AutomationProperties.Name="Message"
                       MaxLength="500" />
              <!-- One blue bar as tall as the message box: Push, a thin line, its ▾ - VS Code's Commit button. -->
              <Border x:Name="PushBar" Margin="0,6,0,0" Height="26" CornerRadius="4" Background="{DynamicResource Accent}">
                <Grid ColumnDefinitions="*,1,28">
                  <Button x:Name="PrimaryButton" Classes="split" CornerRadius="4,0,0,4" Click="Primary_Click" IsEnabled="False"
                          AutomationProperties.Name="Push">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <TextBlock x:Name="PrimaryGlyph" Classes="ico" Text="{x:Static v:Icon.Upload}" Margin="0,0,6,0" />
                      <TextBlock x:Name="PrimaryLabel" Text="Push" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Border Grid.Column="1" Background="{DynamicResource OnAccent}" Opacity="0.35" Margin="0,5" />
                  <Button x:Name="ActionsButton" Grid.Column="2" Classes="split" CornerRadius="0,4,4,0" Click="Actions_Click"
                          ToolTip.Tip="More: pull, pull into a review folder, compare" AutomationProperties.Name="More push and pull actions">
                    <TextBlock Classes="ico" Text="{x:Static v:Icon.ChevronDown}" FontSize="10" HorizontalAlignment="Center" />
                  </Button>
                </Grid>
              </Border>
              <TextBlock x:Name="ProgressText" Classes="hint" TextTrimming="CharacterEllipsis" IsVisible="False" Margin="0,4,0,0" />
            </StackPanel>
            <Panel Grid.Row="5" MinHeight="80">
              <ListBox x:Name="Changes" Classes="rows" Margin="0,0,0,4" SelectionChanged="Change_Changed" DoubleTapped="Changes_DoubleTapped"
                       AutomationProperties.Name="Changes" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="v:ChangeRow">
                    <Panel MinHeight="22">
                      <!-- A group's header: chevron, title, count - and stage or unstage all of it. -->
                      <DockPanel IsVisible="{Binding IsHeader}" Background="Transparent" Cursor="Hand" Tapped="Header_Tapped" ToolTip.Tip="Open or close the group">
                        <Border DockPanel.Dock="Right" Background="{DynamicResource HoverBg}" CornerRadius="8" Padding="6,0" Margin="4,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Count}" FontSize="{DynamicResource TextSmall}" />
                        </Border>
                        <StackPanel DockPanel.Dock="Right" Classes="actions">
                          <Button Classes="icon small" Content="{x:Static v:Icon.Add}" Click="StageGroup_Click" Tag="{Binding}"
                                  ToolTip.Tip="Stage all - files that look like secrets stay unstaged" IsVisible="{Binding CanStageAll}" />
                          <Button Classes="icon small" Content="{x:Static v:Icon.Dash}" Click="UnstageGroup_Click" Tag="{Binding}"
                                  ToolTip.Tip="Unstage all" IsVisible="{Binding CanUnstageAll}" />
                        </StackPanel>
                        <TextBlock Classes="ico" FontSize="9" Width="16" Text="{Binding Chevron}" Foreground="{DynamicResource TextMuted}" TextAlignment="Center" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                      <!-- A file: its icon, name, folder (muted), its buttons, its letter. -->
                      <DockPanel IsVisible="{Binding IsFile}" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                        <TextBlock DockPanel.Dock="Right" Classes="letter" Text="{Binding Letter}" Foreground="{Binding Letter, Converter={StaticResource LetterBrush}}" />
                        <StackPanel DockPanel.Dock="Right" Classes="actions">
                          <Button Classes="icon small" Content="{x:Static v:Icon.Add}" Click="Stage_Click" Tag="{Binding}"
                                  ToolTip.Tip="Stage - to push or pull it with the others staged" IsVisible="{Binding CanStage}" />
                          <Button Classes="icon small" Content="{x:Static v:Icon.Dash}" Click="Unstage_Click" Tag="{Binding}"
                                  ToolTip.Tip="Unstage" IsVisible="{Binding CanUnstage}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Classes="ico" Text="{Binding Icon}" Foreground="{Binding IconBrush}" Width="16"
                                   TextAlignment="Center" Margin="16,0,6,0" />
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Arrow}" Foreground="{DynamicResource TextMuted}" /><Run Text="{Binding Name}" />
                          <Run Text="{Binding Folder}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextSmall}" />
                        </TextBlock>
                      </DockPanel>
                    </Panel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                  <ContextMenu x:Name="ChangesMenu">
                    <MenuItem x:Name="StageFolderItem" Header="Stage everything in the folder" Click="StageFolder_Click" />
                    <MenuItem x:Name="UnstageFolderItem" Header="Unstage everything in the folder" Click="UnstageFolder_Click" />
                    <Separator />
                    <MenuItem Header="Copy path" Click="CopyPath_Click" />
                    <MenuItem x:Name="RevealItem" Header="Open in File Explorer" Click="Reveal_Click" />
                  </ContextMenu>
                </ListBox.ContextMenu>
              </ListBox>
              <TextBlock x:Name="ChangesMessage" Classes="hint" TextWrapping="Wrap" Margin="16,8" VerticalAlignment="Top" IsVisible="False" />
              <!-- The header of the group scrolled through, over the list's top: closed from here without scrolling up. -->
              <Border x:Name="StickyHeader" VerticalAlignment="Top" Margin="4,0" Padding="4,1" IsVisible="False" Background="{DynamicResource SidebarBg}"
                      BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Cursor="Hand" Tapped="StickyHeader_Tapped">
                <DockPanel MinHeight="22" Background="Transparent">
                  <Border DockPanel.Dock="Right" Background="{DynamicResource HoverBg}" CornerRadius="8" Padding="6,0" Margin="4,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StickyCount" FontSize="{DynamicResource TextSmall}" />
                  </Border>
                  <TextBlock Classes="ico" FontSize="9" Width="16" Text="{x:Static v:Icon.ChevronDown}" Foreground="{DynamicResource TextMuted}" TextAlignment="Center" />
                  <TextBlock x:Name="StickyTitle" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </Border>
            </Panel>

            <!-- Dragged up or down: the history bigger or smaller, as VS Code's views. -->
            <GridSplitter x:Name="HistorySash" Grid.Row="6" Height="4" ResizeDirection="Rows" Background="Transparent" />
            <!-- HISTORY - VS Code's graph, at the bottom. -->
            <DockPanel Grid.Row="7">
              <Border x:Name="HistoryHeader" DockPanel.Dock="Top" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="4,4,8,4">
                <DockPanel>
                  <ToggleButton x:Name="HistoryToggle" DockPanel.Dock="Left" Classes="chev" IsChecked="True" AutomationProperties.Name="History"
                                Click="HistoryToggle_Click" />
                  <TextBlock Classes="title" Text="HISTORY" Margin="2,0,0,0" />
                </DockPanel>
              </Border>
              <Panel x:Name="HistoryBody">
                <ListBox x:Name="HistoryList" Classes="rows" Margin="4,0,4,8" SelectionChanged="Operation_Changed"
                         AutomationProperties.Name="History" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="v:OperationRow">
                      <DockPanel ToolTip.Tip="{Binding Tip}" Background="Transparent">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Foreground="{DynamicResource TextMuted}"
                                   FontSize="{DynamicResource TextSmall}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Arrow}" Width="18" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="{Binding Opacity}" />
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="HistoryMessage" Classes="hint" Margin="16,8" TextWrapping="Wrap" IsVisible="False"
                           Text="Nothing pushed or pulled with this server yet." />
              </Panel>
            </DockPanel>
          </Grid>

          <!-- ═══ EXPLORER - the open editors, and the project's files as a push sees them (the server's ignore rules). ═══ -->
          <DockPanel x:Name="ExplorerView" IsVisible="False">
            <DockPanel DockPanel.Dock="Top" Margin="16,10,8,4">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Classes="icon small" Content="{x:Static v:Icon.Refresh}" Click="ExplorerRefresh_Click"
                        ToolTip.Tip="Refresh Explorer" AutomationProperties.Name="Refresh Explorer" />
                <Button Classes="icon small" Content="{x:Static v:Icon.ChevronUp}" Click="ExplorerCollapse_Click"
                        ToolTip.Tip="Collapse folders in Explorer" AutomationProperties.Name="Collapse folders in Explorer" />
              </StackPanel>
              <TextBlock Classes="title" Text="EXPLORER" />
            </DockPanel>
            <!-- OPEN EDITORS - the tabs: a click shows one, its × closes it. -->
            <DockPanel DockPanel.Dock="Top" Margin="4,2,8,0">
              <ToggleButton x:Name="OpenEditorsToggle" DockPanel.Dock="Left" Classes="chev" IsChecked="True" AutomationProperties.Name="Open editors" />
              <TextBlock Classes="title" Text="OPEN EDITORS" Margin="2,0,0,0" />
            </DockPanel>
            <Panel DockPanel.Dock="Top" IsVisible="{Binding #OpenEditorsToggle.IsChecked}">
              <ListBox x:Name="OpenEditors" Classes="rows" MaxHeight="200" Margin="0,0,0,4" SelectionChanged="OpenEditors_Changed"
                       AutomationProperties.Name="Open editors" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="v:EditorTab">
                    <DockPanel Background="Transparent" MinHeight="22" ToolTip.Tip="{Binding Tip}" PointerPressed="Tab_PointerPressed">
                      <TextBlock DockPanel.Dock="Right" Classes="letter" Text="{Binding Letter}" Foreground="{Binding Letter, Converter={StaticResource LetterBrush}}" />
                      <Panel DockPanel.Dock="Left" Width="20">
                        <Button Classes="icon small hoverclose" Width="18" Height="18" FontSize="10" Content="{x:Static v:Icon.Close}"
                                Click="CloseTab_Click" Tag="{Binding}" ToolTip.Tip="Close" AutomationProperties.Name="Close" />
                      </Panel>
                      <TextBlock DockPanel.Dock="Left" Classes="ico" Text="{Binding Icon}" Foreground="{Binding IconBrush}" Width="16"
                                 TextAlignment="Center" Margin="0,0,6,0" />
                      <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Name}" FontStyle="{Binding NameStyle}" />
                        <Run Text="{Binding Folder}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextSmall}" />
                      </TextBlock>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="OpenEditorsMessage" Classes="hint" Margin="24,2,8,6" Text="No file is open." />
            </Panel>
            <!-- The project's folder, by its name: its files, folders first. -->
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="4,4,8,2">
              <DockPanel>
                <ToggleButton x:Name="ProjectFilesToggle" DockPanel.Dock="Left" Classes="chev" IsChecked="True" AutomationProperties.Name="Project files" />
                <TextBlock x:Name="ProjectFilesTitle" Classes="title" Text="PROJECT" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Border>
            <Panel IsVisible="{Binding #ProjectFilesToggle.IsChecked}">
              <ListBox x:Name="ExplorerTree" Classes="rows" Margin="0,0,0,4" KeyDown="ExplorerTree_KeyDown"
                       AutomationProperties.Name="Project files" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="v:ExplorerRow">
                    <DockPanel Background="Transparent" MinHeight="22" ToolTip.Tip="{Binding Path}" Tapped="ExplorerItem_Tapped" DoubleTapped="ExplorerItem_DoubleTapped">
                      <TextBlock DockPanel.Dock="Right" Classes="letter" Text="{Binding Letter}" Foreground="{Binding Letter, Converter={StaticResource LetterBrush}}" />
                      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="{Binding Indent}">
                        <TextBlock Classes="ico" FontSize="9" Width="16" Text="{Binding Chevron}" Foreground="{DynamicResource TextMuted}" TextAlignment="Center" />
                        <TextBlock Classes="ico" Text="{Binding Icon}" Foreground="{Binding IconBrush}" Width="16" TextAlignment="Center" Margin="0,0,4,0" />
                      </StackPanel>
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy path" Click="ExplorerCopyPath_Click" />
                    <MenuItem x:Name="ExplorerRevealItem" Header="Open in File Explorer" Click="ExplorerReveal_Click" />
                  </ContextMenu>
                </ListBox.ContextMenu>
              </ListBox>
              <TextBlock x:Name="ExplorerMessage" Classes="hint" TextWrapping="Wrap" Margin="16,8" VerticalAlignment="Top" IsVisible="False" />
            </Panel>
          </DockPanel>

          <!-- ═══ SEARCH - find in the project's files, and replace: VS Code's search view. ═══ -->
          <DockPanel x:Name="SearchView" IsVisible="False">
            <DockPanel DockPanel.Dock="Top" Margin="16,10,8,4">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Classes="icon small" Content="{x:Static v:Icon.Refresh}" Click="SearchRefresh_Click"
                        ToolTip.Tip="Search again" AutomationProperties.Name="Search again" />
                <Button Classes="icon small" Content="{x:Static v:Icon.Cancel}" Click="SearchClear_Click"
                        ToolTip.Tip="Clear search results" AutomationProperties.Name="Clear search results" />
                <Button x:Name="SearchCollapseButton" Classes="icon small" Content="{x:Static v:Icon.ChevronUp}" Click="SearchCollapse_Click"
                        ToolTip.Tip="Collapse all" AutomationProperties.Name="Collapse all" />
              </StackPanel>
              <TextBlock Classes="title" Text="SEARCH" />
            </DockPanel>
            <Grid DockPanel.Dock="Top" Margin="4,0,12,0" ColumnDefinitions="20,*" RowDefinitions="Auto,Auto,Auto">
              <!-- Replace shown or hidden, as VS Code's chevron beside the boxes. -->
              <ToggleButton x:Name="ReplaceToggle" Grid.RowSpan="2" Classes="chev" VerticalAlignment="Top" Margin="-2,1,0,0" Width="20"
                            Click="ReplaceToggle_Click" AutomationProperties.Name="Toggle Replace" ToolTip.Tip="Toggle Replace" />
              <Panel Grid.Column="1">
                <TextBox x:Name="SearchText" Classes="search" PlaceholderText="Search" AutomationProperties.Name="Search" Padding="6,2,78,2"
                         TextChanged="SearchText_Changed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0">
                  <ToggleButton x:Name="MatchCase" Classes="icon find" Click="FindOption_Click" ToolTip.Tip="Match Case (Alt+C)"
                                AutomationProperties.Name="Match Case" Content="Aa" />
                  <ToggleButton x:Name="WholeWord" Classes="icon find" Click="FindOption_Click" ToolTip.Tip="Match Whole Word (Alt+W)"
                                AutomationProperties.Name="Match Whole Word">
                    <TextBlock Text="ab" TextDecorations="Underline" />
                  </ToggleButton>
                  <ToggleButton x:Name="UseRegex" Classes="icon find" Click="FindOption_Click" ToolTip.Tip="Use Regular Expression (Alt+R)"
                                AutomationProperties.Name="Use Regular Expression" Content=".*" />
                </StackPanel>
              </Panel>
              <!-- Replace, and Replace All beside it (Ctrl+Alt+Enter). -->
              <DockPanel x:Name="ReplaceRow" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" IsVisible="False">
                <Button x:Name="ReplaceAllButton" DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,0" MinHeight="26"
                        Height="26" Content="Replace all" Click="ReplaceAll_Click" IsEnabled="False"
                        ToolTip.Tip="Replace every match shown, in the project's files (Ctrl+Alt+Enter)" />
                <TextBox x:Name="ReplaceText" Classes="search" PlaceholderText="Replace" AutomationProperties.Name="Replace" TextChanged="ReplaceText_Changed" />
              </DockPanel>
              <TextBlock x:Name="SearchSummary" Grid.Row="2" Grid.Column="1" Classes="hint" TextWrapping="Wrap" Margin="0,6,0,4" />
            </Grid>
            <ListBox x:Name="SearchResults" Classes="rows" Margin="0,0,0,4" KeyDown="SearchResults_KeyDown"
                     AutomationProperties.Name="Search results" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="v:SearchRow">
                  <Panel Background="Transparent" Tapped="SearchItem_Tapped" DoubleTapped="SearchItem_DoubleTapped">
                    <!-- A result's file: chevron, icon, name, folder, how many matches. A click opens or closes it. -->
                    <DockPanel IsVisible="{Binding IsFile}" MinHeight="22" ToolTip.Tip="{Binding Tip}">
                      <Border DockPanel.Dock="Right" Background="{DynamicResource HoverBg}" CornerRadius="8" Padding="6,0" Margin="4,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Count}" FontSize="{DynamicResource TextSmall}" />
                      </Border>
                      <TextBlock DockPanel.Dock="Left" Classes="ico" FontSize="9" Width="16" Text="{Binding Chevron}" Foreground="{DynamicResource TextMuted}" TextAlignment="Center" />
                      <TextBlock DockPanel.Dock="Left" Classes="ico" Text="{Binding Icon}" Foreground="{Binding IconBrush}" Width="16" TextAlignment="Center" Margin="0,0,4,0" />
                      <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Name}" />
                        <Run Text="{Binding Folder}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextSmall}" />
                      </TextBlock>
                    </DockPanel>
                    <!-- A match: a little of the line before it, the match marked - struck through, the replacement after it,
                         while Replace has text - and the rest of the line. A click opens the file there. -->
                    <TextBlock IsVisible="{Binding IsMatch}" Margin="32,0,0,0" MinHeight="20" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Tip}">
                      <Run Text="{Binding Before}" /><Run Text="{Binding Text}" Background="{DynamicResource SearchMatchBg}"
                           TextDecorations="{Binding Strike}" /><Run Text="{Binding Replacement}" Background="{DynamicResource DiffAddedBg}" /><Run
                           Text="{Binding After}" />
                    </TextBlock>
                  </Panel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Panel>
      </DockPanel>
    </Border>

    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

    <!-- ─── The editor: a file's diff, or an operation of the history ─── -->
    <Panel x:Name="EditorGrid" Grid.Column="2">
      <!-- No server yet. -->
      <Border x:Name="EmptyState" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
              CornerRadius="{DynamicResource CardRadius}" Padding="18,14" VerticalAlignment="Top" Margin="16,12" IsVisible="False">
        <StackPanel>
          <TextBlock Text="Connect a server" FontSize="{DynamicResource TextHeading}" FontWeight="SemiBold" Margin="0,0,0,10" />
          <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,0,0,12"
                     Text="Add a project's live, staging or development server (SFTP, FTPS or FTP). DNN Manager then compares it with the project like git compares with a remote: what changed here is yours to push, what changed there - someone edited the live site - yours to pull, file by file, each with its diff, never overwriting anything unseen. Every push and pull is kept, and can be rolled back." />
          <Button HorizontalAlignment="Left" Classes="primary" Content="Add server…" Click="Add_Click" />
        </StackPanel>
      </Border>

      <!-- A file. -->
      <DockPanel x:Name="FileView">
        <!-- The open files, as VS Code's tabs: the chosen one on the editor's colour with a line along its top, a preview's
             name in italics; × closes one (a middle-click too), a double-click keeps a preview open. A tab dragged to
             another place moves there (Ctrl+Shift+PageUp / PageDown from the keyboard). -->
        <Border x:Name="TabStrip" DockPanel.Dock="Top" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1" IsVisible="False">
          <Panel>
            <ListBox x:Name="Tabs" SelectionChanged="Tab_Changed" AutomationProperties.Name="Open files"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="v:EditorTab">
                  <Panel ToolTip.Tip="{Binding Tip}" Background="Transparent">
                    <Border Classes="tabline" Height="1" VerticalAlignment="Top" />
                    <StackPanel Orientation="Horizontal" Height="34" Margin="10,0,4,0">
                      <TextBlock Classes="ico" Text="{Binding Icon}" Foreground="{Binding IconBrush}" Margin="0,0,6,0" />
                      <TextBlock Text="{Binding Name}" FontStyle="{Binding NameStyle}" VerticalAlignment="Center" />
                      <TextBlock Classes="letter" Text="{Binding Letter}" Foreground="{Binding Letter, Converter={StaticResource LetterBrush}}" Margin="4,0,0,0" />
                      <Button Classes="icon small hoverclose" Width="22" Height="22" FontSize="10" Content="{x:Static v:Icon.Close}" Click="CloseTab_Click"
                              Tag="{Binding}" ToolTip.Tip="Close" AutomationProperties.Name="Close" Margin="2,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </Panel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <!-- Dragging a tab: a line where it will go when it is dropped - the tabs stay where they are till then. -->
            <Canvas IsHitTestVisible="False">
              <Border x:Name="TabDropLine" Width="2" Height="35" Background="{DynamicResource Accent}" IsVisible="False" />
            </Canvas>
          </Panel>
        </Border>
        <!-- Where the file is, and what happened to it - VS Code's breadcrumbs. -->
        <TextBlock x:Name="Breadcrumb" DockPanel.Dock="Top" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextSmall}"
                   Margin="12,6,12,2" TextTrimming="CharacterEllipsis" IsVisible="False" />
        <Border x:Name="ConflictBar" DockPanel.Dock="Top" Classes="warn" Margin="12,4,12,4" IsVisible="False">
          <StackPanel>
            <TextBlock x:Name="ConflictText" TextWrapping="Wrap" Margin="0,0,0,8" />
            <WrapPanel>
              <Button Content="Keep the project's" Margin="0,0,8,0" Click="KeepLocal_Click"
                      ToolTip.Tip="Keep the project's version - the server's change is set aside; push it to replace the server's" />
              <Button Content="Take the server's" Margin="0,0,8,0" Click="TakeRemote_Click"
                      ToolTip.Tip="Take the server's version - it replaces the project's, which is kept to roll back to" />
              <Button x:Name="MergeButton" Content="Merge…" Click="Merge_Click"
                      ToolTip.Tip="Merge - what only one side changed is merged; you edit what both changed" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <v:DiffView x:Name="Diff" />
      </DockPanel>

      <!-- An operation of the history. -->
      <DockPanel x:Name="OperationView" IsVisible="False">
        <DockPanel DockPanel.Dock="Top" Margin="16,12,12,8">
          <WrapPanel DockPanel.Dock="Right">
            <Button x:Name="RollbackButton" Margin="6,0,0,0" Click="Rollback_Click"
                    ToolTip.Tip="Roll back - put every file of this operation back as it was before it">
              <StackPanel Orientation="Horizontal"><TextBlock Classes="ico" Text="{x:Static v:Icon.Undo}" Margin="0,0,6,0" /><TextBlock Text="Roll back…" /></StackPanel>
            </Button>
            <Button x:Name="RestoreButton" Margin="6,0,0,0" Click="Restore_Click" Content="Restore the version before"
                    ToolTip.Tip="Restore into the project - the chosen file as it was before this operation; push it to send it on" />
            <Button x:Name="OpenReviewButton" Margin="6,0,0,0" Content="Open review folder" Click="OpenReview_Click" IsVisible="False" />
          </WrapPanel>
          <StackPanel>
            <TextBlock x:Name="OperationTitle" FontSize="{DynamicResource TextHeading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="OperationText" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>
        <ListBox x:Name="OperationFiles" DockPanel.Dock="Top" MaxHeight="160" Margin="16,0,12,4" SelectionChanged="OperationFile_Changed"
                 AutomationProperties.Name="Files of the operation" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="v:OperationFileRow">
              <DockPanel Background="Transparent">
                <TextBlock DockPanel.Dock="Right" Classes="letter" Text="{Binding Letter}" Foreground="{Binding Letter, Converter={StaticResource LetterBrush}}" />
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Name}" />
                  <Run Text="{Binding Folder}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextSmall}" />
                  <Run Text="{Binding Where}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextSmall}" />
                </TextBlock>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <v:DiffView x:Name="HistoryDiff" />
      </DockPanel>
    </Panel>
  </Grid>
</UserControl>
