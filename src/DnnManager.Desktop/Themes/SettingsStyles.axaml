<!-- Settings' and Troubleshoot's own styles - the WPF pages' (SettingsPage.xaml, TroubleshootPage.xaml) and the shared
     ones they use from the WPF theme (LayoutStyles.xaml: Hint, FieldLabel, ErrorLine, Card, CardTitle, WarnBanner,
     PageSubtitle). Included by SettingsView and TroubleshootView themselves (UserControl.Styles), so nothing else has
     to know about them. -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══ Text ═══ -->
  <!-- A hint under a field: muted, smaller, wrapped. -->
  <Style Selector="TextBlock.hint">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource TextCaption}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
  <!-- A field's name above it. -->
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="Margin" Value="0,8,0,4" />
  </Style>
  <!-- What is wrong, in red. -->
  <Style Selector="TextBlock.errorLine">
    <Setter Property="Foreground" Value="{DynamicResource ErrorText}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
  <!-- A category's name at the top of it ("General"). -->
  <Style Selector="TextBlock.categoryTitle">
    <Setter Property="FontSize" Value="{DynamicResource TextTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <!-- A group of settings within a category ("Scale and font size"). -->
  <Style Selector="TextBlock.groupLabel">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource TextMedium}" />
    <Setter Property="Margin" Value="0,22,0,8" />
  </Style>
  <!-- The header's name: "Settings", "Troubleshoot". -->
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="{DynamicResource TextLarge}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.pageSubtitle">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,16" />
  </Style>
  <!-- A row's title (Help, Troubleshoot): semi-bold. -->
  <Style Selector="TextBlock.rowTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="{DynamicResource TextHeading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <!-- A folder's path in About: trimmed with … -->
  <Style Selector="TextBlock.folderPath">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The status word of a card's line (Docker, IIS): semi-bold, coloured from code. -->
  <Style Selector="TextBlock.statusValue">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ═══ Boxes ═══ -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
    <Setter Property="Padding" Value="18,14" />
    <Setter Property="Margin" Value="0,0,0,14" />
  </Style>
  <Style Selector="Border.warnBanner">
    <Setter Property="Background" Value="{DynamicResource WarnBannerBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarnBannerBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
    <Setter Property="Padding" Value="18,14" />
    <Setter Property="Margin" Value="0,0,0,14" />
  </Style>
  <!-- The header (name and ✕) and the footer (Close, Save) of Settings and Troubleshoot. -->
  <Style Selector="Border.pageHeader">
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="28,14,20,14" />
  </Style>
  <Style Selector="Border.pageFooter">
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="28,12" />
  </Style>
  <!-- A row of Help or Troubleshoot: what it is on the left, its button on the right, a line under it. -->
  <Style Selector="Border.actionRow">
    <Setter Property="BorderBrush" Value="{DynamicResource GridLine}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,16" />
  </Style>
  <Style Selector="Border.helpRow">
    <Setter Property="BorderBrush" Value="{DynamicResource GridLine}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,14" />
  </Style>
  <Style Selector="Border.actionRow Button.action, Border.helpRow Button.action">
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="Margin" Value="16,0,0,0" />
  </Style>
  <!-- A status line of a card (Docker, IIS): a line above it. -->
  <Style Selector="Border.statusRow">
    <Setter Property="BorderBrush" Value="{DynamicResource GridLine}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,8" />
  </Style>

  <!-- ═══ The categories on the left: icon and name, the one shown highlighted. ═══ -->
  <Style Selector="ListBox.categories ListBoxItem">
    <Setter Property="Padding" Value="8,8,10,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="ListBox.categories ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                   ListBox.categories ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="ListBox.categories TextBlock.glyph">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Width" Value="30" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="ListBox.categories TextBlock.label">
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The search boxes (settings, shortcuts): as WPF's SearchBox. -->
  <Style Selector="TextBox.search">
    <Setter Property="MinHeight" Value="{DynamicResource SearchHeight}" />
    <Setter Property="Padding" Value="{DynamicResource SearchPadding}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A multi-line text box: the text from the top. -->
  <Style Selector="TextBox.multiline">
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- The radios and check boxes of a form: some room between them. -->
  <Style Selector="RadioButton.option">
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
</Styles>
