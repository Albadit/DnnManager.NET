<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DnnManager.Desktop.App"
             Name="DNN Manager"
             RequestedThemeVariant="Default">
  <!-- DNN Manager's look - the Windows app's (WPF), the same on every system: VS Code's Dark Modern and Light Modern.
       The palette, the sizes and the icons are generated from the WPF theme (Themes/Palette, Tokens, Icons.axaml -
       .github/scripts/port-theme.py); the controls are styled as WPF's in Themes/Controls.axaml. Light and dark follow
       the setting appearance.theme (system, light, dark). -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Palette.axaml" />
        <ResourceInclude Source="/Themes/Tokens.axaml" />
        <ResourceInclude Source="/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Fluent's own accent (check boxes, focus, progress): VS Code's blue, as WPF's Accent. -->
      <Color x:Key="SystemAccentColor">#0078D4</Color>
      <Color x:Key="SystemAccentColorLight1">#3794FF</Color>
      <Color x:Key="SystemAccentColorDark1">#026EC1</Color>
      <!-- Segoe UI, as WPF's windows - Inter (bundled) where there is no Segoe UI: macOS and Linux. -->
      <FontFamily x:Key="UiFont">Segoe UI, Inter</FontFamily>
      <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas, Menlo, SF Mono, DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
