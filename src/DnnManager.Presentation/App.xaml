<Application x:Class="DnnManager.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:DnnManager.Presentation.Themes"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The palette: LightTheme or DarkTheme, swapped at runtime by ThemeManager. Brushes are
                     always referenced with DynamicResource so a switch repaints everything live. -->
                <t:LightTheme />
                <!-- Sizes and corner radii shared by the control styles below. -->
                <t:Tokens />
                <!-- The reusable controls, one dictionary per kind (Themes\Controls). A plain <Button />, <TextBox />,
                     <ComboBox />, <CheckBox />… is styled without a Style; the variants are keyed (Primary, SearchBox,
                     ToggleSwitch…). -->
                <t:LayoutStyles />
                <t:ButtonStyles />
                <t:InputStyles />
                <t:SelectionStyles />
                <t:MenuStyles />
                <t:ListStyles />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!-- Sidebar navigation entries (RadioButtons so exactly one page is selected). -->
            <Style TargetType="RadioButton" x:Key="NavItem">
                <Setter Property="Foreground" Value="{DynamicResource SidebarFg}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" Padding="18,10" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarSelected}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter Property="Foreground" Value="{DynamicResource SidebarActiveFg}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets (same code points) on Windows 10. -->
            <Style TargetType="TextBlock" x:Key="NavGlyph">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Width" Value="30" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
