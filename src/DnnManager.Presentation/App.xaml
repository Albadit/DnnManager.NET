<Application x:Class="DnnManager.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:DnnManager.Presentation.Themes"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The palette: LightTheme or DarkTheme, swapped at runtime by ThemeManager. Brushes are
                     always referenced with DynamicResource so a switch repaints everything live. -->
                <t:LightTheme />
                <!-- Sizes and corner radii shared by the control styles below. -->
                <t:Tokens />
                <!-- The drawn icons (path geometries), to reuse anywhere. -->
                <t:Icons />
                <!-- The reusable controls, one dictionary per kind (Themes\Controls). A plain <Button />, <TextBox />,
                     <ComboBox />, <CheckBox />… is styled without a Style; the variants are keyed (Primary, SearchBox,
                     ToggleSwitch…). -->
                <t:LayoutStyles />
                <t:ButtonStyles />
                <t:InputStyles />
                <t:SelectionStyles />
                <t:MenuStyles />
                <t:ListStyles />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="{DynamicResource TextBody}" />
            </Style>

            <!-- Sidebar navigation entries (RadioButtons so exactly one page is selected): a rounded highlight, inset from
                 the sidebar's edges, as VS Code's activity bar. -->
            <Style TargetType="RadioButton" x:Key="NavItem">
                <Setter Property="Foreground" Value="{DynamicResource SidebarFg}" />
                <Setter Property="FontSize" Value="{DynamicResource TextMedium}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="{DynamicResource NavMargin}" />
                <Setter Property="Padding" Value="{DynamicResource NavPadding}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource CardRadius}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarSelected}" />
                                    <Setter Property="Foreground" Value="{DynamicResource SidebarActiveFg}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A navigation entry's icon: a glyph of the icon font (Themes\Icons.xaml), centred in 30 px - the icons-only
                 sidebar's entries are as wide. -->
            <Style TargetType="TextBlock" x:Key="NavGlyph">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Width" Value="30" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- A navigation entry's name, after its NavGlyph: the sidebar's (SidebarLabel), Settings' categories. -->
            <Style TargetType="TextBlock" x:Key="NavLabel">
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
