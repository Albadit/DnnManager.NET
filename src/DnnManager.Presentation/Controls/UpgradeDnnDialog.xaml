<Window x:Class="DnnManager.Presentation.Controls.UpgradeDnnDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DnnManager.Presentation.Controls"
        Title="Upgrade DNN" Icon="pack://application:,,,/DnnManager;component/src/DnnManager.Presentation/Assets/dnn.ico" Width="700" Height="640"
        MinWidth="560" MinHeight="480" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}">
    <!-- Which DNN to end at, and the plan DNN's upgrade path makes of it - each step with what was checked. Nothing starts
         while something blocks. -->
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Intro" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
            <StackPanel x:Name="RepositoryPanel" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Repository" Margin="0,12,0,4" />
                <ComboBox AutomationProperties.Name="Repository" x:Name="RepositoryBox" DisplayMemberPath="Label" SelectionChanged="Repository_Changed" />
            </StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Upgrade to" Margin="0,12,0,4" />
            <ComboBox AutomationProperties.Name="Upgrade to" x:Name="VersionBox" DisplayMemberPath="Label" SelectionChanged="Version_Changed" />
            <TextBlock x:Name="VersionHint" Style="{StaticResource Hint}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="Problem" Style="{StaticResource ErrorLine}" c:FieldError.For="{Binding ElementName=OkButton}" Visibility="Collapsed" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="OkButton" Content="Start upgrade" Style="{StaticResource Primary}" MinWidth="80" IsDefault="True" IsEnabled="False"
                        Click="Ok_Click" ToolTip="Back up and upgrade, step by step (Enter)" />
                <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" ToolTip="Cancel (Esc)" />
            </StackPanel>
        </StackPanel>

        <!-- The plan: the steps, and what the analyser found - Compatible, Warning, Blocking, Unknown. -->
        <Border Margin="0,14,0,0" CornerRadius="{StaticResource ControlRadius}" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                <ItemsControl x:Name="PlanList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="{Binding Margin}">
                                <TextBlock x:Name="Mark" DockPanel.Dock="Left" Width="74" Text="{Binding Mark}" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock x:Name="Text" Text="{Binding Text}" TextWrapping="Wrap" ToolTip="{Binding Tip}" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Heading">
                                    <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="Mark" Property="Width" Value="0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Compatible">
                                    <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource SuccessText}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                    <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource OutWarnText}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Blocking">
                                    <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource ErrorText}" />
                                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource ErrorText}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
