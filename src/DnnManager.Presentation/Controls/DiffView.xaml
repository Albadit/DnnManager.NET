<UserControl x:Class="DnnManager.Presentation.Controls.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DnnManager.Presentation.Controls"
             xmlns:s="clr-namespace:System;assembly=System.Runtime">
    <!-- A file's two versions, line by line: unified (one column, - and +) or side by side (old left, new right), each
         line coloured by its language. Only the changes and the lines around them - or the whole file. Flush with the
         editor's edges, as VS Code's; the line numbers as wide as the file's longest needs, the code as wide as its longest
         line - scrolled sideways (NumberWidth, CodeWidth: set by Render). -->
    <UserControl.Resources>
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
        <GridLength x:Key="NumberWidth">40</GridLength>
        <!-- The old line's number - none for a file shown as it is (ShowFileAsync): one column of numbers, as an editor's. -->
        <GridLength x:Key="OldNumberWidth">40</GridLength>
        <s:Double x:Key="CodeWidth">0</s:Double>
        <!-- How wide a whole line shown with Show more wraps (set by Render: the code's width, or a side's). -->
        <s:Double x:Key="WrapWidth">0</s:Double>
        <!-- Side by side: both sides' code moved sideways together by SplitScroll, as VS Code scrolls them. -->
        <TranslateTransform x:Key="CodeShift" />
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="0,0,6,0" />
        </Style>
        <Style x:Key="Code" TargetType="c:HighlightedText">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="4,0,8,0" />
        </Style>
        <!-- A side of a row: its colour by what it is. -->
        <Style x:Key="SideCell" TargetType="Border">
            <!-- The code is text to select (DiffView's selection): the I-beam, as in an editor. -->
            <Setter Property="Cursor" Value="IBeam" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added"><Setter Property="Background" Value="{DynamicResource DiffAddedBg}" /></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed"><Setter Property="Background" Value="{DynamicResource DiffRemovedBg}" /></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Empty"><Setter Property="Background" Value="{DynamicResource DiffEmptyBg}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Mark" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Text" Value="{Binding Mark}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added"><Setter Property="Foreground" Value="{DynamicResource DiffAddedMark}" /></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed"><Setter Property="Foreground" Value="{DynamicResource DiffRemovedMark}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Unified: the numbers of both, the mark, the line. -->
        <DataTemplate x:Key="UnifiedRow" DataType="{x:Type c:DiffRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource OldNumberWidth}" />
                    <ColumnDefinition Width="{DynamicResource NumberWidth}" />
                    <ColumnDefinition Width="*" MinWidth="{DynamicResource CodeWidth}" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" Background="{DynamicResource DiffHunkBg}" Visibility="{Binding HunkVisibility}">
                    <TextBlock Text="{Binding Hunk}" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextMuted}" Padding="8,2" />
                </Border>
                <TextBlock Style="{StaticResource Number}" Text="{Binding Left.Number}" Visibility="{Binding LineVisibility}" />
                <TextBlock Grid.Column="1" Style="{StaticResource Number}" Text="{Binding Right.Number}" Visibility="{Binding LineVisibility}" />
                <Border Grid.Column="2" Style="{StaticResource SideCell}" DataContext="{Binding Unified}" Visibility="{Binding DataContext.LineVisibility, RelativeSource={RelativeSource AncestorType=Grid}}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Mark}" />
                        <c:HighlightedText Style="{StaticResource Code}" Line="{Binding}" />
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Side by side: the old line on the left, the new one on the right - each half the width, the code cut off at its
             edge and moved sideways by the one scroll bar under them (CodeShift): a long line on the left doesn't push the
             right side off the screen. -->
        <DataTemplate x:Key="SplitRow" DataType="{x:Type c:DiffRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource NumberWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{DynamicResource NumberWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="4" Background="{DynamicResource DiffHunkBg}" Visibility="{Binding HunkVisibility}">
                    <TextBlock Text="{Binding Hunk}" FontFamily="{StaticResource Mono}" Foreground="{DynamicResource TextMuted}" Padding="8,2" />
                </Border>
                <TextBlock Style="{StaticResource Number}" Text="{Binding Left.Number}" Visibility="{Binding LineVisibility}" />
                <Border Grid.Column="1" Style="{StaticResource SideCell}" DataContext="{Binding Left}" ClipToBounds="True" Visibility="{Binding DataContext.LineVisibility, RelativeSource={RelativeSource AncestorType=Grid}}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Mark}" />
                        <!-- Clipped here, not at the cell: moved sideways, the code passes under the mark, never over it. On a
                             canvas, the code is as wide as its line - laid out in the side's width it would end there, and
                             scrolling would show nothing past it. The canvas as tall as the code. -->
                        <Border ClipToBounds="True">
                            <Canvas Height="{Binding ActualHeight, ElementName=LeftCode}">
                                <c:HighlightedText x:Name="LeftCode" Style="{StaticResource Code}" Line="{Binding}" RenderTransform="{StaticResource CodeShift}" />
                            </Canvas>
                        </Border>
                    </DockPanel>
                </Border>
                <TextBlock Grid.Column="2" Style="{StaticResource Number}" Text="{Binding Right.Number}" Visibility="{Binding LineVisibility}" />
                <Border Grid.Column="3" Style="{StaticResource SideCell}" DataContext="{Binding Right}" ClipToBounds="True" Visibility="{Binding DataContext.LineVisibility, RelativeSource={RelativeSource AncestorType=Grid}}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Mark}" />
                        <!-- Clipped here, not at the cell: moved sideways, the code passes under the mark, never over it. On a
                             canvas, the code is as wide as its line - laid out in the side's width it would end there, and
                             scrolling would show nothing past it. The canvas as tall as the code. -->
                        <Border ClipToBounds="True">
                            <Canvas Height="{Binding ActualHeight, ElementName=RightCode}">
                                <c:HighlightedText x:Name="RightCode" Style="{StaticResource Code}" Line="{Binding}" RenderTransform="{StaticResource CodeShift}" />
                            </Canvas>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- What is compared with what, and how it is shown. -->
        <!-- Icon toggles, as VS Code's editor actions: Unified or Side by side (one of the two), and Whole file. The icons
             as tall as the body text, so they grow with the font size chosen in Settings. Still a radio button and a check
             box underneath - a screen reader says which is on, the arrow keys move between the two modes. -->
        <DockPanel DockPanel.Dock="Top" Margin="12,3,8,3">
            <StackPanel x:Name="Modes" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <Style x:Key="ModeToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggleButton}">
                        <Setter Property="Width" Value="NaN" />
                        <Setter Property="Height" Value="NaN" />
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                    </Style>
                    <Style x:Key="ModeIcon" TargetType="Viewbox">
                        <Setter Property="Height" Value="{DynamicResource TextBody}" />
                        <Setter Property="Margin" Value="7" />
                    </Style>
                    <Style x:Key="ModePath" TargetType="Path" BasedOn="{StaticResource IconStroke}">
                        <Setter Property="StrokeThickness" Value="1.5" />
                        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </Style>
                </StackPanel.Resources>
                <RadioButton x:Name="UnifiedMode" Style="{StaticResource ModeToggle}" GroupName="DiffMode" IsChecked="True" Margin="0,0,2,0" Checked="Mode_Changed"
                             AutomationProperties.Name="Unified"
                             ToolTip="Unified - one column: removed lines (-) above the lines that replace them (+)">
                    <Viewbox Style="{StaticResource ModeIcon}"><Grid Width="16" Height="14"><Path Style="{StaticResource ModePath}" Data="{StaticResource DiffUnified}" /></Grid></Viewbox>
                </RadioButton>
                <RadioButton x:Name="SplitMode" Style="{StaticResource ModeToggle}" GroupName="DiffMode" Margin="0,0,8,0" Checked="Mode_Changed"
                             AutomationProperties.Name="Side by side"
                             ToolTip="Side by side - the old version on the left, the new one on the right">
                    <Viewbox Style="{StaticResource ModeIcon}"><Grid Width="16" Height="14"><Path Style="{StaticResource ModePath}" Data="{StaticResource DiffSplit}" /></Grid></Viewbox>
                </RadioButton>
                <CheckBox x:Name="WholeFile" Style="{StaticResource ModeToggle}" Click="Mode_Changed"
                          AutomationProperties.Name="Whole file"
                          ToolTip="Whole file - every line, not only the changes and the lines around them">
                    <Viewbox Style="{StaticResource ModeIcon}"><Grid Width="16" Height="14"><Path Style="{StaticResource ModePath}" Data="{StaticResource DiffWholeFile}" /></Grid></Viewbox>
                </CheckBox>
            </StackPanel>
            <TextBlock x:Name="Titles" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
        </DockPanel>
        <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Side by side: both sides' code sideways at once. -->
                <ScrollBar x:Name="SplitScroll" Grid.Row="1" Orientation="Horizontal" Visibility="Collapsed" ValueChanged="SplitScroll_Changed"
                           AutomationProperties.Name="Scroll both sides sideways" />
                <!-- The code is selected as in an editor: drag, Shift+click, double-click a word, triple-click a line,
                     Ctrl+A - on one side at a time; Ctrl+C or the menu copies it. -->
                <ListBox x:Name="Rows" BorderThickness="0" Background="{DynamicResource CardBg}" ItemTemplate="{StaticResource UnifiedRow}"
                         SizeChanged="Rows_SizeChanged" PreviewMouseWheel="Rows_PreviewMouseWheel"
                         PreviewMouseLeftButtonDown="Rows_PreviewMouseLeftButtonDown" PreviewMouseMove="Rows_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="Rows_PreviewMouseLeftButtonUp" LostMouseCapture="Rows_LostMouseCapture"
                         PreviewKeyDown="Rows_PreviewKeyDown" ContextMenuOpening="Rows_ContextMenuOpening"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         AutomationProperties.Name="Differences">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="CopyItem" Header="Copy" InputGestureText="Ctrl+C" Click="Copy_Click" />
                            <MenuItem Header="Select all" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- Transparent, not empty: a click past the end of an unchanged line still lands on its row. -->
                                        <Border Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <TextBlock x:Name="Message" Grid.RowSpan="2" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="16" HorizontalAlignment="Center"
                           VerticalAlignment="Center" TextAlignment="Center" Text="Choose a file to see what changed." />
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
