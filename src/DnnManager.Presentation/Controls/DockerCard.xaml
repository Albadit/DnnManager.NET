<UserControl x:Class="DnnManager.Presentation.Controls.DockerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A status line: name | status (coloured from code) | detail | action button. -->
        <Style x:Key="StatusRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource GridLine}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,8" />
        </Style>
        <Style x:Key="StatusName" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style x:Key="StatusDetail" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="StatusAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}">
        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" x:Name="TestButton" Content="Test" MinWidth="80" Click="Test_Click"
                        ToolTip="Test" />
                <TextBlock Style="{StaticResource CardTitle}" Text="Docker" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <Grid Grid.IsSharedSizeScope="True">
                <StackPanel>
                    <Border Style="{StaticResource StatusRow}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Status" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource StatusName}" Text="Docker Desktop" Margin="0,0,24,0" />
                            <TextBlock Style="{StaticResource StatusValue}" Grid.Column="1" x:Name="DockerStatus" Text="Not tested" Margin="0,0,16,0" />
                            <TextBlock Style="{StaticResource StatusDetail}" Grid.Column="2" x:Name="DockerDetail" />
                            <Button Style="{StaticResource StatusAction}" Grid.Column="3" x:Name="InstallDockerButton" Content="Install Docker Desktop" Click="InstallDocker_Click"
                                    ToolTip="Install Docker Desktop" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource StatusRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Status" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource StatusName}" Text="Docker engine" Margin="0,0,24,0" />
                            <TextBlock Style="{StaticResource StatusValue}" Grid.Column="1" x:Name="EngineStatus" Text="Not tested" Margin="0,0,16,0" />
                            <TextBlock Style="{StaticResource StatusDetail}" Grid.Column="2" x:Name="EngineDetail" />
                            <Button Style="{StaticResource StatusAction}" Grid.Column="3" x:Name="StartDockerButton" Content="Start Docker Desktop" Click="StartDocker_Click"
                                    ToolTip="Start Docker Desktop" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource StatusRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Status" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource StatusName}" Text="SQL Server container" Margin="0,0,24,0" />
                            <TextBlock Style="{StaticResource StatusValue}" Grid.Column="1" x:Name="ContainerStatus" Text="Not tested" Margin="0,0,16,0" />
                            <TextBlock Style="{StaticResource StatusDetail}" Grid.Column="2" x:Name="ContainerDetail" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <WrapPanel Margin="0,10,0,0">
                <Button x:Name="SetupComposeButton" Style="{StaticResource Primary}" Content="Set up docker-compose"
                        Margin="0,0,8,0" Click="SetupCompose_Click"
                        ToolTip="Set up docker-compose" />
                <Button x:Name="ShowYamlButton" Content="Show docker-compose.yml" Click="ShowYaml_Click"
                        ToolTip="Show docker-compose.yml" />
            </WrapPanel>
            <StackPanel x:Name="YamlPanel" Visibility="Collapsed" Margin="0,10,0,0">
                <Grid>
                    <TextBox x:Name="YamlBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource TextCaption}" MaxHeight="380" Padding="8,8,8,8"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    <!-- Over the top-right corner of the box, clear of its vertical scrollbar. -->
                    <Button x:Name="CopyYamlButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,24,0"
                            Padding="10,3" ToolTip="Copy" Click="CopyYaml_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="CopyYamlText" Text="Copy" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
