<Window x:Class="DnnManager.Presentation.Controls.RenameProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DnnManager.Presentation.Controls"
        Title="Rename project" Icon="pack://application:,,,/DnnManager;component/src/DnnManager.Presentation/Assets/dnn.ico" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}">
    <!-- A project's new name, and whether its host name and database follow it. -->
    <StackPanel Margin="20">
        <TextBlock x:Name="Intro" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="New name" />
        <TextBox AutomationProperties.Name="New name" x:Name="NameBox" TextChanged="NameBox_TextChanged" />
        <TextBlock x:Name="Problem" Style="{StaticResource ErrorLine}" c:FieldError.For="{Binding ElementName=NameBox}" Visibility="Collapsed" />
        <!-- Only for a project that has a host name, and one that has a database: the texts follow the typed name. -->
        <CheckBox x:Name="HostBox" IsChecked="True" Margin="0,12,0,0">
            <TextBlock x:Name="HostText" TextWrapping="Wrap" />
        </CheckBox>
        <StackPanel x:Name="DatabasePanel" Margin="0,8,0,0">
            <CheckBox x:Name="DatabaseBox" IsChecked="True">
                <TextBlock x:Name="DatabaseText" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,0" Text="The site is stopped while the database is renamed." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="Rename" Style="{StaticResource Primary}" MinWidth="80" IsDefault="True" IsEnabled="False" Click="Ok_Click"
                    ToolTip="Rename (Enter)" />
            <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" ToolTip="Cancel (Esc)" />
        </StackPanel>
    </StackPanel>
</Window>
