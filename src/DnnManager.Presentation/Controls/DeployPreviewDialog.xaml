<Window x:Class="DnnManager.Presentation.Controls.DeployPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review" Icon="pack://application:,,,/DnnManager;component/src/DnnManager.Presentation/Assets/dnn.ico" Width="640" Height="560"
        MinWidth="480" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}">
    <!-- Every operation of a push or pull before it runs (a dry run): nothing changes until it is confirmed here. -->
    <DockPanel Margin="20">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" Style="{StaticResource CardTitle}" TextWrapping="Wrap" />
        <TextBlock x:Name="Summary" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel x:Name="PullTarget" Visibility="Collapsed" Margin="0,0,0,8">
                <RadioButton x:Name="IntoProject" Content="Into the project" GroupName="Target" IsChecked="True" />
                <RadioButton x:Name="IntoReview" Content="Into a review folder of its own - the project doesn't change" GroupName="Target" Margin="0,4,0,0"
                             ToolTip="Into a review folder - to look at the server's files before you take them; nothing in the project or the baseline changes" />
            </StackPanel>
            <CheckBox x:Name="SensitiveBox" Visibility="Collapsed" Margin="0,0,0,6" Checked="Box_Changed" Unchecked="Box_Changed">
                <TextBlock x:Name="SensitiveText" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox x:Name="ProductionBox" Visibility="Collapsed" Margin="0,0,0,6" Checked="Box_Changed" Unchecked="Box_Changed">
                <TextBlock x:Name="ProductionText" TextWrapping="Wrap" />
            </CheckBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="OkButton" Style="{StaticResource Primary}" MinWidth="100" Click="Ok_Click" />
                <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" IsDefault="True" ToolTip="Cancel (Esc) - nothing changes" />
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="Plan" AutomationProperties.Name="What will be done" BorderThickness="1" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="What" Width="160" Binding="{Binding What}" />
                <DataGridTextColumn Header="File" Width="330" Binding="{Binding Path}" />
                <DataGridTextColumn Header="Size" Width="80" Binding="{Binding Size}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
