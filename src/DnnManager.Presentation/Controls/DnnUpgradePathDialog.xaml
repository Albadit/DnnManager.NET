<Window x:Class="DnnManager.Presentation.Controls.DnnUpgradePathDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DnnManager.Presentation.Controls"
        Title="Edit DNN upgrade path" Icon="pack://application:,,,/DnnManager;component/src/DnnManager.Presentation/Assets/dnn.ico"
        Width="860" Height="680" MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}">
    <!-- The whole upgrade path, a row per version - saved as its edits of the path DNN Manager knows (projects.dnnUpgradeStops).
         As the guide and What's new: as big as it is made, the rows taking the room and the note growing with the width. -->
    <DockPanel>
        <!-- The path as a file on the left (to keep, or to use on another PC - an import only fills the rows, Save keeps
             it); Save and Cancel on the right. -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="OkButton" Content="Save" Style="{StaticResource Primary}" MinWidth="80" IsDefault="True" IsEnabled="False" Click="Ok_Click"
                            ToolTip="Save (Enter)" />
                    <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" ToolTip="Cancel (Esc)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Import…" MinWidth="80" Click="Import_Click" ToolTip="Fill the path from a file exported before - Save keeps it" />
                    <Button x:Name="ExportButton" Content="Export…" MinWidth="80" Margin="8,0,0,0" Click="Export_Click"
                            ToolTip="Save the path as it is here to a file" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Margin="20,20,20,12">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"
                           Text="Upgrade DNN stops at every version of this path on the way. When DNN lists a new version on its suggested upgrade path, add it here; change what a version needs, or take one off. A version DNN released without listing it needs nothing: pick it in Upgrade DNN as it is." />
                <Button Style="{StaticResource LinkButton}" Content="Open DNN's suggested upgrade path" HorizontalAlignment="Left" Margin="0,4,0,0" Click="Source_Click" />
                <TextBlock Style="{StaticResource FieldLabel}" FontWeight="SemiBold" Margin="0,12,0,0" Text="The path" />
                <TextBlock x:Name="Known" Style="{StaticResource Hint}" Margin="0" TextWrapping="Wrap" />
                <!-- The columns of the rows below (AddRow), and room for their remove button and the scroll bar. -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Static c:DnnUpgradePathDialog.VersionWidth}" />
                        <ColumnDefinition Width="{x:Static c:DnnUpgradePathDialog.MinimumWidth}" />
                        <ColumnDefinition Width="{x:Static c:DnnUpgradePathDialog.MinimumWidth}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{x:Static c:DnnUpgradePathDialog.RemoveWidth}" />
                        <ColumnDefinition Width="{x:Static c:DnnUpgradePathDialog.ScrollBarWidth}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Version" />
                    <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}" Text="Needs .NET Framework" Margin="8,8,0,4" />
                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Needs SQL Server" Margin="8,8,0,4" />
                    <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Note in the upgrade plan" Margin="8,8,0,4" />
                </Grid>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock x:Name="Removed" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="AddButton" Style="{StaticResource LinkButton}" Content="Add version" Click="Add_Click" />
                    <Button x:Name="ResetButton" Style="{StaticResource LinkButton}" Content="Reset to DNN Manager's path" Margin="16,0,0,0" Click="Reset_Click"
                            ToolTip="The path as DNN Manager came with it - every change made here undone" />
                </StackPanel>
                <TextBlock x:Name="Problem" Style="{StaticResource ErrorLine}" c:FieldError.For="{Binding ElementName=OkButton}" Visibility="Collapsed" />
            </StackPanel>

            <!-- Filled in code: one row per version, newest first, as DNN's page lists them - taking the room the window has. -->
            <ScrollViewer x:Name="RowsScroller" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="The upgrade path">
                <StackPanel x:Name="RowsPanel" />
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</Window>
