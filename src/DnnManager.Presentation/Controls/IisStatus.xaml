<UserControl x:Class="DnnManager.Presentation.Controls.IisStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="IisButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
    </UserControl.Resources>

    <!-- The status bar's first cell, as wide as the sidebar above it (like the engine status in Docker Desktop):
         the dot, "IIS running" in its colour and the buttons on the right. Compact: the dot and a ⋮ menu. -->
    <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,1,0"
            Height="30" TextElement.FontSize="12">
        <DockPanel x:Name="Layout" Margin="14,0,6,0">
            <StackPanel x:Name="Buttons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartButton" Style="{StaticResource IisButton}" Content="&#xE768;" ToolTip="Start IIS"
                        Click="Start_Click" Visibility="Collapsed" />
                <Button x:Name="RestartButton" Style="{StaticResource IisButton}" Content="&#xE72C;"
                        ToolTip="Restart IIS (every site stops for a few seconds)" Click="Restart_Click" Visibility="Collapsed" />
                <Button x:Name="StopButton" Style="{StaticResource IisButton}" Content="&#xE71A;" ToolTip="Stop IIS (every site on this PC)"
                        Click="Stop_Click" Visibility="Collapsed" />
            </StackPanel>
            <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{StaticResource IisButton}" FontFamily="Segoe UI" FontSize="14"
                    Content="⋮" ToolTip="IIS actions" Click="More_Click" Visibility="Collapsed" />
            <StackPanel x:Name="State" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                <Ellipse x:Name="Dot" Width="9" Height="9" StrokeThickness="1.5" VerticalAlignment="Center" />
                <TextBlock x:Name="StateText" Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Text="IIS…" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
