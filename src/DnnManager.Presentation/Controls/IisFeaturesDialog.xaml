<Window x:Class="DnnManager.Presentation.Controls.IisFeaturesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DnnManager.Presentation.Controls"
        Title="Edit Windows features" Icon="pack://application:,,,/DnnManager;component/src/DnnManager.Presentation/Assets/dnn.ico" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}">
    <!-- The IIS Windows features DNN Manager checks and enables (iis.requiredFeatures) - one row each. -->
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"
                   Text="The Windows features Test checks and Set up IIS enables. dism /online /get-features lists their names." />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Shown as" Width="230" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Windows feature name" Margin="8,8,0,4" />
        </StackPanel>
        <!-- Filled in code: one row per feature. -->
        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RowsPanel" />
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Style="{StaticResource LinkButton}" Content="Add feature" Click="Add_Click" />
            <Button Style="{StaticResource LinkButton}" Content="Use the defaults" Margin="16,0,0,0" Click="Defaults_Click" />
        </StackPanel>
        <TextBlock x:Name="Problem" Style="{StaticResource ErrorLine}" c:FieldError.For="{Binding ElementName=OkButton}" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="Save" Style="{StaticResource Primary}" MinWidth="80" IsDefault="True" IsEnabled="False" Click="Ok_Click"
                    ToolTip="Save (Enter)" />
            <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" ToolTip="Cancel (Esc)" />
        </StackPanel>
    </StackPanel>
</Window>
