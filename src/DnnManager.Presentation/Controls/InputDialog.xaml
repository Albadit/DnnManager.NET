<Window x:Class="DnnManager.Presentation.Controls.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DnnManager.Presentation.Controls"
        Title="DNN Manager" Icon="pack://application:,,,/DnnManager;component/src/DnnManager.Presentation/Assets/dnn.ico" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Question" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />
        <TextBox x:Name="Text" TextChanged="Text_TextChanged" AutomationProperties.LabeledBy="{Binding ElementName=Question}" />
        <TextBlock x:Name="Problem" Style="{StaticResource ErrorLine}" c:FieldError.For="{Binding ElementName=Text}" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="OK" Style="{StaticResource Primary}" MinWidth="80" IsDefault="True" Click="Ok_Click" ToolTip="OK (Enter)" />
            <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" ToolTip="Cancel (Esc)" />
        </StackPanel>
    </StackPanel>
</Window>
