<Window x:Class="DnnManager.Presentation.Controls.DetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DnnManager.Presentation.Controls"
        Title="DNN Manager" Icon="pack://application:,,,/dnnmgr;component/src/DnnManager.Presentation/Assets/dnn.ico" Width="700" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" Style="{StaticResource CardTitle}" FontSize="17" Margin="0,0,0,12" />

        <Border Style="{StaticResource Card}" Margin="0" Padding="14,4,14,10">
            <!-- Tall projects scroll inside the card rather than growing past the screen. -->
            <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Rows" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="Row" Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Label" Text="{Binding Label}" Foreground="{DynamicResource TextMuted}" />
                                <!-- Read-only text box so a value (a path, a database name…) can be selected and copied. -->
                                <TextBox x:Name="Value" Grid.Column="2" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"
                                         VerticalContentAlignment="Top" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <!-- A section heading spans the row; it has no value. -->
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static c:DetailKind.Section}">
                                    <Setter TargetName="Row" Property="Margin" Value="0,12,0,4" />
                                    <Setter TargetName="Label" Property="Grid.ColumnSpan" Value="3" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                    <Setter TargetName="Value" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static c:DetailKind.Good}">
                                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource SuccessText}" />
                                    <Setter TargetName="Value" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static c:DetailKind.Bad}">
                                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource ErrorText}" />
                                    <Setter TargetName="Value" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static c:DetailKind.Warning}">
                                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource LogWarn}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Copy all" MinWidth="80" Click="Copy_Click" />
            <Button Content="Close" Style="{StaticResource Primary}" MinWidth="80" Margin="8,0,0,0" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
