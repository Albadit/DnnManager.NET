<UserControl x:Class="DnnManager.Presentation.Controls.DatabaseServerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DnnManager.Presentation.Controls">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="TestButton" Content="Test" MinWidth="80" Margin="8,0,0,0"
                        VerticalAlignment="Center" Click="Test_Click" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Database server" Margin="0" />
                    <TextBlock x:Name="Summary" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
            <c:DatabaseCheckList x:Name="CheckList" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
