<Window x:Class="DnnManager.Presentation.Controls.WhatsNewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's new in DNN Manager" Icon="pack://application:,,,/DnnManager;component/src/DnnManager.Presentation/Assets/dnn.ico"
        Width="720" Height="640" MinWidth="440" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}">
    <!-- The release notes of the versions since the one before an update - as each GitHub release shows them. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource Primary}" MinWidth="80" IsDefault="True" IsCancel="True"
                        ToolTip="Close (Esc)" />
                <Button x:Name="ReleasesLink" Style="{StaticResource LinkButton}" Content="All releases on GitHub" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Click="Releases_Click" />
            </DockPanel>
        </Border>
        <FlowDocumentScrollViewer x:Name="Viewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  IsToolBarVisible="False" Focusable="False" />
    </DockPanel>
</Window>
