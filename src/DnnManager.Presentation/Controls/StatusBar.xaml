<UserControl x:Class="DnnManager.Presentation.Controls.StatusBar"
             xmlns:s="clr-namespace:DnnManager.Presentation.Services"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Equal-width digits, so a changing number only moves the figures after it when it gains or loses a digit; the
             same gap after each. The bars' text is lifted by 1.5 px of bottom margin: Segoe UI
             keeps room for descenders under the line, so a centred line's capitals sit 0.75 px below the middle - beside
             icons that are centred exactly (IisStatus, the title bar's name and search do the same). -->
        <Style x:Key="Figure" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,1.5" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </UserControl.Resources>

    <!-- Along the bottom of the window, right of IIS (IisStatus, under the sidebar): this PC's resources, then the
         version on the right. (The running operation is a toast - OperationToast.) -->
    <Border Background="{DynamicResource StatusBarBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="{DynamicResource StatusBarBorder}"
            Height="{DynamicResource StatusBarHeight}" TextElement.FontSize="{DynamicResource TextCaption}">
        <DockPanel Margin="14,0,0,0">

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,14,0">
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="12,0,0,1.5" />
            </StackPanel>

            <!-- Clipped rather than wrapped when the window is narrow. Each figure keeps the width of its widest value
                 (the hidden texts: this PC's memory, 100%, the drive's size), so nothing moves as one goes from 9.99 to
                 10.00. The texts are placeholders until the first sample with all three figures (StatusBar.ShowResources). -->
            <StackPanel Orientation="Horizontal" ClipToBounds="True">
                <Grid>
                    <TextBlock x:Name="RamWidest" Style="{StaticResource Figure}" Visibility="Hidden" />
                    <TextBlock x:Name="RamText" Style="{StaticResource Figure}" Text="RAM 0.00 GB" />
                </Grid>
                <Grid>
                    <TextBlock Style="{StaticResource Figure}" Text="CPU 100.00%" Visibility="Hidden" />
                    <TextBlock x:Name="CpuText" Style="{StaticResource Figure}" Text="CPU 0.00%" />
                </Grid>
                <Grid>
                    <TextBlock x:Name="DiskWidest" Style="{StaticResource Figure}" Visibility="Hidden" />
                    <TextBlock x:Name="DiskText" Style="{StaticResource Figure}" Text="Disk: --.-- GB used (limit --.-- GB)" />
                </Grid>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
