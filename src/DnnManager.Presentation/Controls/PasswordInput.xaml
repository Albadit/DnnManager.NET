<UserControl x:Class="DnnManager.Presentation.Controls.PasswordInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Right padding leaves room for the eye button drawn over the box. -->
        <!-- Both boxes carry the name the password field is given (its label): a screen reader says which password it is -
             and its help text: what is wrong with it (FieldError). -->
        <PasswordBox x:Name="Hidden" Padding="6,4,34,4" PasswordChanged="Hidden_PasswordChanged"
                     AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=UserControl}}"
                     AutomationProperties.HelpText="{Binding Path=(AutomationProperties.HelpText), RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <TextBox x:Name="Shown" Padding="6,4,34,4" Visibility="Collapsed" TextChanged="Shown_TextChanged"
                 AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=UserControl}}"
                 AutomationProperties.HelpText="{Binding Path=(AutomationProperties.HelpText), RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <!-- The next tab stop after the box (WCAG 2.1.1); its name says what pressing it does now (Eye_Toggled). -->
        <ToggleButton x:Name="Eye" HorizontalAlignment="Right" Width="30" Margin="0,1,1,1"
                      AutomationProperties.Name="Show password" FocusVisualStyle="{StaticResource FocusRing}"
                      Cursor="Hand" ToolTip="Show password" Checked="Eye_Toggled" Unchecked="Eye_Toggled">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                        <TextBlock x:Name="Glyph" Text="{StaticResource GlyphShow}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- "Hide" (eye struck through) while the password is visible. -->
                            <Setter TargetName="Glyph" Property="Text" Value="{StaticResource GlyphHide}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
    </Grid>
</UserControl>
