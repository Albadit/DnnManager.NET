<Window x:Class="DnnManager.Presentation.Controls.DeployConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DnnManager.Presentation.Controls"
        Title="Server connection" Icon="pack://application:,,,/DnnManager;component/src/DnnManager.Presentation/Assets/dnn.ico" Width="640" Height="720"
        MinWidth="540" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="MoreVisible" />
        <!-- FileZilla's layout: the label in a column of its own, the field beside it. -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>
    <!-- A server a project deploys to, laid out as FileZilla's Site Manager: protocol, host and port, encryption, logon
         type, user and password - then the project's folder there and what is left out. Test connection checks it before it
         is saved; a server's identity is trusted only after the user has seen it. -->
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <DockPanel>
                <Button x:Name="TestButton" DockPanel.Dock="Left" Content="Test connection" Click="Test_Click"
                        ToolTip="Test connection - sign in, check the server's identity and that its folder is there; nothing changes" />
                <ProgressBar x:Name="Testing" DockPanel.Dock="Left" Width="60" Height="3" Margin="12,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Accent}" Background="{DynamicResource GridLine}" BorderThickness="0" Visibility="Collapsed" />
                <TextBlock x:Name="TestResult" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock x:Name="Problem" Style="{StaticResource ErrorLine}" c:FieldError.For="{Binding ElementName=OkButton}" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OkButton" Content="Save" Style="{StaticResource Primary}" MinWidth="80" IsDefault="True" Click="Ok_Click" ToolTip="Save (Enter)" />
                <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" ToolTip="Cancel (Esc)" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0" Grid.IsSharedSizeScope="True">
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Label" Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowLabel}" Text="Name:" />
                    <TextBox x:Name="NameBox" Grid.Column="1" AutomationProperties.Name="Name" ToolTip="What you call this server, e.g. Live" />
                    <TextBlock Grid.Column="2" Style="{StaticResource RowLabel}" Text="Environment:" Margin="12,0,8,0" />
                    <ComboBox x:Name="EnvironmentBox" Grid.Column="3" AutomationProperties.Name="Environment"
                              ToolTip="Environment - Production asks you to confirm every push and deletion" />
                </Grid>

                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Label" Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowLabel}" Text="Protocol:" />
                    <ComboBox x:Name="ProtocolBox" Grid.Column="1" AutomationProperties.Name="Protocol" SelectionChanged="Protocol_Changed" />
                </Grid>

                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Label" Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowLabel}" Text="Host:" />
                    <TextBox x:Name="HostBox" Grid.Column="1" AutomationProperties.Name="Host"
                             ToolTip="The server's name or address, e.g. waws-prod-am2-363.ftp.azurewebsites.windows.net" />
                    <TextBlock Grid.Column="2" Style="{StaticResource RowLabel}" Text="Port:" Margin="12,0,8,0" />
                    <TextBox x:Name="PortBox" Grid.Column="3" AutomationProperties.Name="Port"
                             ToolTip="Port - empty for the usual one: 22 for SFTP, 990 for implicit FTP over TLS, 21 for the rest" />
                </Grid>

                <Grid x:Name="EncryptionRow" Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Label" Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowLabel}" Text="Encryption:" />
                    <ComboBox x:Name="EncryptionBox" Grid.Column="1" AutomationProperties.Name="Encryption" SelectionChanged="Encryption_Changed" />
                </Grid>
                <Border x:Name="PlainFtpWarning" Style="{StaticResource WarnBanner}" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock x:Name="PlainFtpText" TextWrapping="Wrap" />
                </Border>

                <Grid Style="{StaticResource Row}" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Label" Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowLabel}" Text="Logon Type:" />
                    <ComboBox x:Name="LogonBox" Grid.Column="1" AutomationProperties.Name="Logon type" SelectionChanged="Logon_Changed" />
                </Grid>

                <Grid x:Name="UserRow" Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Label" Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowLabel}" Text="User:" />
                    <TextBox x:Name="UserBox" Grid.Column="1" AutomationProperties.Name="User" ToolTip="The user to sign in as - on Azure e.g. site\$site" />
                </Grid>

                <Grid x:Name="PasswordRow" Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Label" Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowLabel}" Text="Password:" />
                    <c:PasswordInput x:Name="PasswordBox" Grid.Column="1" AutomationProperties.Name="Password" />
                </Grid>
                <TextBlock x:Name="PasswordHint" Style="{StaticResource Hint}" Margin="0,-4,0,8" TextWrapping="Wrap" Visibility="Collapsed" />

                <Grid x:Name="KeyRow" Style="{StaticResource Row}" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Label" Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowLabel}" Text="Key file:" />
                    <TextBox x:Name="KeyStatus" Grid.Column="1" IsReadOnly="True" AutomationProperties.Name="Key file" Text="No key chosen" />
                    <Button Grid.Column="2" Content="Browse…" Margin="8,0,0,0" Click="ChooseKey_Click"
                            ToolTip="Choose the key file (OpenSSH, PEM or PuTTY) - its content is saved encrypted; the file itself isn't needed afterwards" />
                </Grid>
                <Grid x:Name="PassphraseRow" Style="{StaticResource Row}" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Label" Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowLabel}" Text="Passphrase:" />
                    <c:PasswordInput x:Name="PassphraseBox" Grid.Column="1" AutomationProperties.Name="Passphrase" />
                </Grid>

                <Grid Style="{StaticResource Row}" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Label" Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowLabel}" Text="Remote folder:" />
                    <TextBox x:Name="RootBox" Grid.Column="1" AutomationProperties.Name="Remote folder"
                             ToolTip="The project's folder on the server, e.g. /site/wwwroot (Azure) or /var/www/shop - nothing outside it is read or changed" />
                </Grid>

                <!-- The app's own chevron, not WPF's Expander - whose header keeps the system's black text in the dark theme. -->
                <StackPanel Orientation="Horizontal" Margin="-4,8,0,0">
                    <ToggleButton x:Name="MoreToggle" Style="{StaticResource ExpandToggle}" Focusable="True" Foreground="{DynamicResource TextPrimary}"
                                  AutomationProperties.Name="Transfers, backups and ignored files" />
                    <TextBlock Text="Transfers, backups and ignored files" VerticalAlignment="Center" Margin="4,0,0,0" Cursor="Hand"
                               MouseLeftButtonUp="MoreLabel_Click" />
                </StackPanel>
                <Grid Visibility="{Binding IsChecked, ElementName=MoreToggle, Converter={StaticResource MoreVisible}}">
                    <StackPanel Margin="24,4,0,0">
                        <DockPanel Margin="0,4,0,0">
                            <TextBox x:Name="ParallelBox" DockPanel.Dock="Right" Width="60" AutomationProperties.Name="Files at the same time" />
                            <TextBlock Text="Files at the same time (1 - 16)" VerticalAlignment="Center"
                                       ToolTip="Each over a connection of its own - more is faster on a fast line, if the server allows that many" />
                        </DockPanel>
                        <CheckBox x:Name="BackupsBox" Content="Keep what a push or pull replaces, to roll back to" Margin="0,10,0,0" IsChecked="True" />
                        <CheckBox x:Name="VerifyBox" Content="Check each upload by its SHA-256" Margin="0,6,0,0" IsChecked="True"
                                  ToolTip="Check each upload by its SHA-256 - asked of the server, or read back; off: only its size is checked" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Ignored files (like .gitignore - one pattern a line)" />
                        <TextBox x:Name="RulesBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="180" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Ignored files"
                                 VerticalContentAlignment="Top" />
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="Neither sent nor fetched nor compared, in the project and on the server. The defaults leave out the site's own web.config, App_Data, logs and caches - each environment has its own." />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="IdentityLine" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,14,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
