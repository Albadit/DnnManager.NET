<UserControl x:Class="DnnManager.Presentation.Controls.TerminalPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DnnManager.Presentation.Controls"
             xmlns:s="clr-namespace:DnnManager.Presentation.Services">
    <!-- The bottom panel, like VS Code's: Output (what DNN Manager does), Logs (a website's log files and events),
         Terminal (shells, listed on the right). The tabs on the left of its header; new terminal, search, maximize and
         hide on the right; copy / paste / clear and back to the newest line in a strip right of the shown tab. -->
    <UserControl.Resources>
        <Style x:Key="PanelButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{DynamicResource LogMuted}" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
        </Style>
        <!-- A tab of the header: rounded, on a background while shown - as VS Code's. -->
        <Style x:Key="PanelTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource LogMuted}" />
            <Setter Property="FontSize" Value="{DynamicResource TextCaption}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" Padding="8,3" Margin="2,0" CornerRadius="{StaticResource ControlRadius}"
                                VerticalAlignment="Center">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource LogHeaderFg}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource LogHeaderFg}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A terminal in the list on the right: the shown one highlighted. -->
        <!-- A terminal in the list. Like VS Code's lists: the one with the keyboard is outlined in the accent (a click puts
             the keyboard there too - Del, F2 and Enter act on it); the shown one is highlighted, dimmer while the keyboard
             is elsewhere (typing in the terminal). -->
        <Style x:Key="TabItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Foreground" Value="{DynamicResource LogMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- The outline below shows the focus - for the mouse too, so no second ring. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TabItem_PreviewMouseLeftButtonDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="7,2,5,2" Margin="4,1"
                                CornerRadius="{StaticResource ControlRadius}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource LogHeaderFg}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}" />
                            </Trigger>
                            <!-- Shown, but the keyboard is elsewhere: still marked, less strongly. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </MultiDataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- An option of the search (Match Case, Whole Word, Regular Expression): framed in the accent colour while on. -->
        <Style x:Key="SearchOption" TargetType="ToggleButton">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- VS Code's input option hover - the buttons' hover would hardly show on the box's colour. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputOptionHoverBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A shell's icon - as in VS Code's terminal list: its Codicons terminal-powershell, terminal-cmd and terminal-bash
             (Microsoft, https://github.com/microsoft/vscode-codicons, CC BY 4.0), in the text's colour. The content is the
             icon's key: "powershell" (also PowerShell 7), "cmd" or "bash". -->
        <DataTemplate x:Key="ShellIcon">
            <Grid Width="16" Height="16">
                <Grid.Resources>
                    <Style TargetType="Path">
                        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                        <Setter Property="Stretch" Value="Uniform" />
                    </Style>
                </Grid.Resources>
                <Path x:Name="PowerShell" Data="{StaticResource ShellPowerShell}" />
                <Path x:Name="Cmd" Visibility="Collapsed" Data="{StaticResource ShellCmd}" />
                <Path x:Name="Bash" Visibility="Collapsed" Data="{StaticResource ShellBash}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="cmd">
                    <Setter TargetName="PowerShell" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Cmd" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="bash">
                    <Setter TargetName="PowerShell" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Bash" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource LogBg}">
        <!-- About as much room at the ends as above and below what is there: 33 high above the line, the tabs 22 (5.5 above
             and below; 4 here and their own 2 on the left) and the buttons 26 (3.5 above and below, 4 on the right) -
             whole pixels, so the text stays sharp. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource LogHeaderBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1" Height="34" Padding="4,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Terminal: a new one with the default shell, or with another shell - or one with administrator rights. -->
                    <StackPanel x:Name="TerminalTools" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="NewButton" AutomationProperties.Name="New terminal" Style="{StaticResource PanelButton}" Content="{StaticResource GlyphAdd}" s:CommandTip.Command="terminal.new" Click="New_Click" />
                        <Button AutomationProperties.Name="Choose shell or Administrator terminal" x:Name="ShellsButton" Style="{StaticResource PanelButton}" Width="18" FontSize="9" Content="{StaticResource GlyphChevronDown}"
                                ToolTip="Choose shell - or New Administrator terminal" Click="Shells_Click" />
                    </StackPanel>
                    <!-- Output: empty it. Copy and paste are Ctrl+C / Ctrl+V and the right-click menu on every tab. -->
                    <Button AutomationProperties.Name="Clear output" x:Name="ClearButton" Style="{StaticResource PanelButton}" Content="{StaticResource GlyphDelete}" ToolTip="Clear output"
                            s:CommandTip.Command="panel.clearOutput" Click="Clear_Click" />
                    <Button AutomationProperties.Name="Find" Style="{StaticResource PanelButton}" Content="{StaticResource GlyphSearch}" ToolTip="Find" s:CommandTip.Command="view.search"
                            Click="Search_Click" />
                    <Border Width="1" Height="16" Margin="6,0" Background="{DynamicResource CardBorder}" />
                    <!-- Corners outward: maximize; inward: restore (MaximizeIcon's data is swapped in code). -->
                    <Button AutomationProperties.Name="Maximize panel" x:Name="MaximizeButton" Style="{StaticResource PanelButton}" ToolTip="Maximize panel"
                            s:CommandTip.Command="panel.maximize" Click="Maximize_Click">
                        <Path x:Name="MaximizeIcon" Data="{StaticResource PanelMaximize}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button AutomationProperties.Name="Hide panel" Style="{StaticResource PanelButton}" FontSize="11" Content="{StaticResource GlyphClose}" ToolTip="Hide panel" s:CommandTip.Command="panel.toggle"
                            Click="Close_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="OutputTab" Style="{StaticResource PanelTab}" GroupName="PanelTabs" IsChecked="True"
                                 Checked="PanelTab_Checked" ToolTip="Output - what DNN Manager is doing, step by step"
                                 s:CommandTip.Command="panel.output">
                        <!-- The red dot: the last operation failed - until Output is opened again. -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Output" />
                            <Ellipse x:Name="OutputDot" Width="6" Height="6" Margin="5,1,0,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource OutError}" Visibility="Collapsed" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LogsTab" Style="{StaticResource PanelTab}" GroupName="PanelTabs" Content="Logs"
                                 Checked="PanelTab_Checked" ToolTip="Logs - what a website, IIS, Windows or DNN Manager wrote down; look here when something goes wrong" />
                    <RadioButton x:Name="TerminalTab" Style="{StaticResource PanelTab}" GroupName="PanelTabs" Content="Terminal"
                                 Checked="PanelTab_Checked" ToolTip="Terminal - a command line, for advanced users"
                                 s:CommandTip.Command="terminal.toggle" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Terminal: the open shells, on the right - as wide as you drag its left edge (ListResizer). -->
        <Border x:Name="TerminalList" DockPanel.Dock="Right" Width="176" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <ListBox x:Name="Tabs" Background="Transparent" BorderThickness="0" Margin="0,4,0,0" ItemContainerStyle="{StaticResource TabItem}"
                     SelectionChanged="Tabs_SelectionChanged" PreviewKeyDown="Tabs_PreviewKeyDown"
                     PreviewMouseLeftButtonDown="Tabs_PreviewMouseLeftButtonDown" PreviewMouseMove="Tabs_PreviewMouseMove"
                     PreviewMouseLeftButtonUp="Tabs_PreviewMouseLeftButtonUp" AllowDrop="True" DragOver="Tabs_DragOver" Drop="Tabs_Drop"
                     AutomationProperties.Name="Terminals"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Hover: the shell, process ID, program and folder. Double-click, F2 or the right-click
                             menu renames it; the bin ends it. -->
                        <DockPanel Background="Transparent" MinHeight="24" MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                   ToolTipService.ShowDuration="30000">
                            <DockPanel.ToolTip>
                                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <StackPanel MaxWidth="520">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <ItemsControl ItemsSource="{Binding Details}" Margin="0,6,0,0" Grid.IsSharedSizeScope="True">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Key}" Foreground="{DynamicResource TextMuted}" Margin="0,0,14,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ToolTip>
                            </DockPanel.ToolTip>
                            <DockPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rename" InputGestureText="F2" Click="RenameTab_Click" />
                                    <MenuItem Header="Close terminal" InputGestureText="Del" Click="CloseTab_Click" />
                                </ContextMenu>
                            </DockPanel.ContextMenu>
                            <!-- Only while the mouse is on the terminal (Hidden, not Collapsed: the name doesn't move). -->
                            <Button AutomationProperties.Name="Close terminal" DockPanel.Dock="Right" Width="22" Height="22" FontSize="11"
                                    Content="{StaticResource GlyphDelete}" ToolTip="Close terminal (Del)" Click="CloseTab_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PanelButton}">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Its shell's own icon. -->
                            <ContentControl DockPanel.Dock="Left" Content="{Binding Icon}" ContentTemplate="{StaticResource ShellIcon}"
                                            Focusable="False" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Grid>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Visibility="{Binding IsNotRenaming, Converter={StaticResource BoolToVis}}" />
                                <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Terminal name" MinHeight="22" Padding="3,1" Margin="-4,0,2,0"
                                         FontWeight="Normal" MaxLength="60"
                                         Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                         IsVisibleChanged="Rename_IsVisibleChanged" KeyDown="Rename_KeyDown" LostKeyboardFocus="Rename_LostFocus" />
                            </Grid>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- The terminal list's left edge: drag it to make the list wider or narrower; lit while the mouse is on it. -->
        <Thumb x:Name="ListResizer" DockPanel.Dock="Right" Width="4" Cursor="SizeWE" Visibility="Collapsed"
               DragDelta="ListResizer_DragDelta" ToolTip="Drag to resize the list of terminals">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="Transparent" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <Grid>
            <!-- Output: the operations, stage by stage (the Pipeline Rail) - read-only, the log's text can be selected and copied. -->
            <c:PipelineView x:Name="Pipeline" />

            <c:LogsView x:Name="Logs" Visibility="Collapsed" />

            <!-- Terminal: the shown shell and its scrollbar - and, over an Administrator terminal, one line saying so. -->
            <Grid x:Name="TerminalPane" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="AdministratorWarning" Grid.ColumnSpan="2" Visibility="Collapsed" Padding="8,3"
                        Background="{DynamicResource WarnBannerBg}" BorderBrush="{DynamicResource WarnBannerBorder}" BorderThickness="0,0,0,1"
                        AutomationProperties.LiveSetting="Polite">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource OutWarnText}" FontSize="{DynamicResource TextCaption}"
                               Text="Administrator terminal - every command typed here runs with administrator rights." />
                </Border>
                <ContentControl x:Name="TerminalHost" Grid.Row="1" Focusable="False" />
                <ScrollBar x:Name="TerminalScroll" Grid.Row="1" Grid.Column="1" Orientation="Vertical" SmallChange="1"
                           ValueChanged="TerminalScroll_ValueChanged" />
                <TextBlock x:Name="NoTerminal" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource LogMuted}" Text="No terminal open - + starts one." Visibility="Collapsed" />
            </Grid>

            <!-- Search (Ctrl+F): over the top right of the shown tab, like VS Code's. -->
            <Grid x:Name="SearchBar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,20,0" Panel.ZIndex="10" Visibility="Collapsed">
                <!-- The shadow a layer of its own: an effect on the bar would draw its text as a bitmap, without ClearType. -->
                <Border Background="{DynamicResource CardBg}" CornerRadius="4" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
                    </Border.Effect>
                </Border>
                <Border Padding="4" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                    <!-- The text, with the three options inside the box on its right, as in VS Code. -->
                    <Grid>
                        <TextBox x:Name="SearchBox" AutomationProperties.Name="Find" Width="260" MinHeight="{StaticResource SearchHeight}" Padding="6,2,78,2" TextChanged="SearchBox_TextChanged"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown" ToolTip="Find" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0">
                            <ToggleButton AutomationProperties.Name="Match Case" x:Name="MatchCase" Style="{StaticResource SearchOption}" ToolTip="Match Case (Alt+C)"
                                          Click="SearchOption_Click">
                                <TextBlock Text="Aa" />
                            </ToggleButton>
                            <ToggleButton AutomationProperties.Name="Match Whole Word" x:Name="WholeWord" Style="{StaticResource SearchOption}" ToolTip="Match Whole Word (Alt+W)"
                                          Click="SearchOption_Click">
                                <TextBlock Text="ab" TextDecorations="Underline" />
                            </ToggleButton>
                            <ToggleButton AutomationProperties.Name="Use Regular Expression" x:Name="UseRegex" Style="{StaticResource SearchOption}" ToolTip="Use Regular Expression (Alt+R)"
                                          Click="SearchOption_Click">
                                <TextBlock Text=".*" FontWeight="Bold" />
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="SearchCount" MinWidth="70" Margin="8,0,4,0" VerticalAlignment="Center" FontSize="{DynamicResource TextCaption}"
                               Foreground="{DynamicResource TextMuted}" Text="No results" />
                    <Button AutomationProperties.Name="Previous match" Style="{StaticResource PanelButton}" Content="{StaticResource GlyphChevronUp}" ToolTip="Previous match (Shift+Enter)" Click="SearchPrevious_Click" />
                    <Button AutomationProperties.Name="Next match" Style="{StaticResource PanelButton}" Content="{StaticResource GlyphChevronDown}" ToolTip="Next match (Enter)" Click="SearchNext_Click" />
                    <Button AutomationProperties.Name="Close" Style="{StaticResource PanelButton}" FontSize="10" Content="{StaticResource GlyphClose}" ToolTip="Close (Esc)" Click="SearchClose_Click" />
                </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>