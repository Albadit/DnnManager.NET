            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="cmd">
                    <Setter TargetName="PowerShell" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Cmd" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="bash">
                    <Setter TargetName="PowerShell" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Bash" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource LogBg}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource LogHeaderBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1" Height="34" Padding="6,0,6,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Terminal: a new one with the default shell, or with another shell. -->
                    <StackPanel x:Name="TerminalTools" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="NewButton" Style="{StaticResource PanelButton}" Content="&#xE710;" s:CommandTip.Command="terminal.new" Click="New_Click" />
                        <Button x:Name="ShellsButton" Style="{StaticResource PanelButton}" Width="18" FontSize="9" Content="&#xE70D;"
                                ToolTip="Choose shell" Click="Shells_Click" />
                    </StackPanel>
                    <!-- Output: empty it. Copy and paste are Ctrl+C / Ctrl+V and the right-click menu on every tab. -->
                    <Button x:Name="ClearButton" Style="{StaticResource PanelButton}" Content="&#xE74D;" ToolTip="Clear output"
                            s:CommandTip.Command="panel.clearOutput" Click="Clear_Click" />
                    <Button Style="{StaticResource PanelButton}" Content="&#xE721;" ToolTip="Find" s:CommandTip.Command="view.search"
                            Click="Search_Click" />
                    <Border Width="1" Height="16" Margin="6,0" Background="{DynamicResource CardBorder}" />
                    <!-- Corners outward: maximize; inward: restore (MaximizeIcon's data is swapped in code). -->
                    <Button x:Name="MaximizeButton" Style="{StaticResource PanelButton}" ToolTip="Maximize panel"
                            s:CommandTip.Command="panel.maximize" Click="Maximize_Click">
                        <Path x:Name="MaximizeIcon" Data="M1,4.5 V1 H4.5 M7.5,1 H11 V4.5 M11,7.5 V11 H7.5 M4.5,11 H1 V7.5" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource PanelButton}" FontSize="11" Content="&#xE8BB;" ToolTip="Hide panel" s:CommandTip.Command="panel.toggle"
                            Click="Close_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="OutputTab" Style="{StaticResource PanelTab}" GroupName="PanelTabs" IsChecked="True"
                                 Checked="PanelTab_Checked" ToolTip="Output"
                                 s:CommandTip.Command="panel.output">
                        <!-- The red dot: the last operation failed - until Output is opened again. -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Output" />
                            <Ellipse x:Name="OutputDot" Width="6" Height="6" Margin="5,1,0,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource OutError}" Visibility="Collapsed" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LogsTab" Style="{StaticResource PanelTab}" GroupName="PanelTabs" Content="Logs"
                                 Checked="PanelTab_Checked" ToolTip="Logs" />
                    <RadioButton x:Name="TerminalTab" Style="{StaticResource PanelTab}" GroupName="PanelTabs" Content="Terminal"
                                 Checked="PanelTab_Checked" ToolTip="Terminal"
                                 s:CommandTip.Command="terminal.toggle" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Terminal: the open shells, on the right - as wide as you drag its left edge (ListResizer). -->
        <Border x:Name="TerminalList" DockPanel.Dock="Right" Width="176" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <ListBox x:Name="Tabs" Background="Transparent" BorderThickness="0" Margin="0,4,0,0" ItemContainerStyle="{StaticResource TabItem}"
                     SelectionChanged="Tabs_SelectionChanged" PreviewKeyDown="Tabs_PreviewKeyDown"
                     PreviewMouseLeftButtonDown="Tabs_PreviewMouseLeftButtonDown" PreviewMouseMove="Tabs_PreviewMouseMove"
                     PreviewMouseLeftButtonUp="Tabs_PreviewMouseLeftButtonUp" AllowDrop="True" DragOver="Tabs_DragOver" Drop="Tabs_Drop"
                     AutomationProperties.Name="Terminals"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Hover: the shell, process ID, program and folder. Double-click, F2 or the right-click
                             menu renames it; the bin ends it. -->
                        <DockPanel Background="Transparent" MinHeight="24" MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                   ToolTipService.ShowDuration="30000">
                            <DockPanel.ToolTip>
                                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <StackPanel MaxWidth="520">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <ItemsControl ItemsSource="{Binding Details}" Margin="0,6,0,0" Grid.IsSharedSizeScope="True">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Key}" Foreground="{DynamicResource TextMuted}" Margin="0,0,14,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ToolTip>
                            </DockPanel.ToolTip>
                            <DockPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rename" InputGestureText="F2" Click="RenameTab_Click" />
                                    <MenuItem Header="Close terminal" InputGestureText="Del" Click="CloseTab_Click" />
                                </ContextMenu>
                            </DockPanel.ContextMenu>
                            <!-- Only while the mouse is on the terminal (Hidden, not Collapsed: the name doesn't move). -->
                            <Button DockPanel.Dock="Right" Width="22" Height="22" FontSize="11"
                                    Content="&#xE74D;" ToolTip="Close terminal (Del)" Click="CloseTab_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PanelButton}">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Its shell's own icon. -->
                            <ContentControl DockPanel.Dock="Left" Content="{Binding Icon}" ContentTemplate="{StaticResource ShellIcon}"
                                            Focusable="False" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Grid>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Visibility="{Binding IsNotRenaming, Converter={StaticResource BoolToVis}}" />
                                <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" MinHeight="22" Padding="3,1" Margin="-4,0,2,0"
                                         FontWeight="Normal" MaxLength="60"
                                         Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                         IsVisibleChanged="Rename_IsVisibleChanged" KeyDown="Rename_KeyDown" LostKeyboardFocus="Rename_LostFocus" />
                            </Grid>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- The terminal list's left edge: drag it to make the list wider or narrower; lit while the mouse is on it. -->
        <Thumb x:Name="ListResizer" DockPanel.Dock="Right" Width="4" Cursor="SizeWE" Visibility="Collapsed"
               DragDelta="ListResizer_DragDelta" ToolTip="Drag to resize the list of terminals">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="Transparent" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <Grid>
            <!-- Output: the operations, stage by stage (the Pipeline Rail) - read-only, the log's text can be selected and copied. -->
            <c:PipelineView x:Name="Pipeline" />

            <c:LogsView x:Name="Logs" Visibility="Collapsed" />

            <!-- Terminal: the shown shell and its scrollbar. -->
            <Grid x:Name="TerminalPane" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="TerminalHost" Focusable="False" />
                <ScrollBar x:Name="TerminalScroll" Grid.Column="1" Orientation="Vertical" SmallChange="1"
                           ValueChanged="TerminalScroll_ValueChanged" />
                <TextBlock x:Name="NoTerminal" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource LogMuted}" Text="No terminal open - + starts one." Visibility="Collapsed" />
            </Grid>

            <!-- Search (Ctrl+F): over the top right of the shown tab, like VS Code's. -->
            <Border x:Name="SearchBar" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,20,0" Padding="4"
                    Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4"
                    Panel.ZIndex="10" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <!-- The text, with the three options inside the box on its right, as in VS Code. -->
                    <Grid>
                        <TextBox x:Name="SearchBox" Width="260" MinHeight="{StaticResource SearchHeight}" Padding="6,2,78,2" TextChanged="SearchBox_TextChanged"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown" ToolTip="Find" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0">
                            <ToggleButton x:Name="MatchCase" Style="{StaticResource SearchOption}" ToolTip="Match Case (Alt+C)"
                                          Click="SearchOption_Click">
                                <TextBlock Text="Aa" />
                            </ToggleButton>
                            <ToggleButton x:Name="WholeWord" Style="{StaticResource SearchOption}" ToolTip="Match Whole Word (Alt+W)"
                                          Click="SearchOption_Click">
                                <TextBlock Text="ab" TextDecorations="Underline" />
                            </ToggleButton>
                            <ToggleButton x:Name="UseRegex" Style="{StaticResource SearchOption}" ToolTip="Use Regular Expression (Alt+R)"
                                          Click="SearchOption_Click">
                                <TextBlock Text=".*" FontWeight="Bold" />
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="SearchCount" MinWidth="70" Margin="8,0,4,0" VerticalAlignment="Center" FontSize="{DynamicResource TextCaption}"
                               Foreground="{DynamicResource TextMuted}" Text="No results" />
                    <Button Style="{StaticResource PanelButton}" Content="&#xE70E;" ToolTip="Previous match (Shift+Enter)" Click="SearchPrevious_Click" />
                    <Button Style="{StaticResource PanelButton}" Content="&#xE70D;" ToolTip="Next match (Enter)" Click="SearchNext_Click" />
                    <Button Style="{StaticResource PanelButton}" FontSize="10" Content="&#xE8BB;" ToolTip="Close (Esc)" Click="SearchClose_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>