<Window x:Class="DnnManager.Presentation.Controls.GuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Getting started with DNN Manager" Icon="pack://application:,,,/DnnManager;component/src/DnnManager.Presentation/Assets/dnn.ico"
        Width="900" Height="660" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <!-- A step in the list on the left: its number (a tick once seen) and short name, the current one highlighted. -->
        <Style x:Key="StepItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="8,7,10,7" Margin="0,1" CornerRadius="{StaticResource ControlRadius}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The getting started guide, a page's help, or the pages a new version added - one page at a time (GuideDialog.xaml.cs
         builds each from Services/Onboarding). -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BackButton" Content="Back" MinWidth="84" Click="Back_Click" ToolTip="The previous page" />
                    <Button x:Name="TourButton" Content="Take the tour" Margin="8,0,0,0" Visibility="Collapsed" Click="Tour_Click"
                            ToolTip="Close this guide and point at each part of the window" />
                    <Button x:Name="NextButton" Style="{StaticResource Primary}" Content="Next" MinWidth="84" Margin="8,0,0,0" IsDefault="True"
                            Click="Next_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Esc does the same: the guide can always be left. -->
                    <Button x:Name="SkipButton" Style="{StaticResource LinkButton}" Content="Skip guide" IsCancel="True" Click="Skip_Click"
                            ToolTip="Close the guide (Esc) - the ? at the top right opens it again" />
                    <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The steps - only when there is more than one. -->
        <Border x:Name="StepsPane" DockPanel.Dock="Left" Width="230" Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,14">
                <TextBlock x:Name="StepsTitle" DockPanel.Dock="Top" Text="Getting started" FontWeight="SemiBold" FontSize="{DynamicResource TextMedium}"
                           Margin="8,0,0,12" />
                <ListBox x:Name="StepList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource StepItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="StepList_SelectionChanged"
                         AutomationProperties.Name="Steps" />
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="Body" Margin="34,28,34,28" MaxWidth="720" HorizontalAlignment="Left" />
        </ScrollViewer>
    </DockPanel>
</Window>
