<Window x:Class="DnnManager.Presentation.Controls.HostPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DnnManager.Presentation.Controls"
        Title="Change host password" Icon="pack://application:,,,/DnnManager;component/src/DnnManager.Presentation/Assets/dnn.ico" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}">
    <!-- A new password for one of the site's host accounts: typed twice (or generated, and shown), never kept anywhere. -->
    <StackPanel Margin="20">
        <TextBlock x:Name="Intro" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
        <!-- Only when there is a choice: a site with one host account names it in the intro instead. -->
        <StackPanel x:Name="UserPanel">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Host account" />
            <ComboBox x:Name="UserBox" IsEditable="True" />
        </StackPanel>
        <DockPanel Margin="0,8,0,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Generate" FontSize="{DynamicResource TextCaption}"
                    ToolTip="Generate password" Click="Generate_Click" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="New password" Margin="0" />
        </DockPanel>
        <c:PasswordInput x:Name="NewPassword" PasswordChanged="Password_Changed" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="New password again" />
        <c:PasswordInput x:Name="Confirm" PasswordChanged="Password_Changed" />
        <TextBlock x:Name="Problem" Style="{StaticResource ErrorLine}" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="Change password" Style="{StaticResource Primary}" MinWidth="80" IsDefault="True" IsEnabled="False" Click="Ok_Click"
                    ToolTip="Change password (Enter)" />
            <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" ToolTip="Cancel (Esc)" />
        </StackPanel>
    </StackPanel>
</Window>