<UserControl x:Class="DnnManager.Presentation.Controls.PipelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DnnManager.Presentation.Controls"
             xmlns:s="clr-namespace:DnnManager.Presentation.Services"
             FontSize="{DynamicResource TextCaption}">
    <!-- The Output tab, the "Pipeline Rail": the newest operation's status, title and times on top; its stages - and
         the sites kept warm, and its summary - on the left; on the right the log of every operation, grouped by stage.
         Read-only: the log's text can be selected and copied. The header and the rail are the panel's own (its font
         and colours, like the Terminal tab's list); only the log is a terminal - monospaced, the Out* brushes. -->
    <UserControl.Resources>
        <!-- The stage icons (Step… in Themes\Icons.xaml), 14 x 14, drawn with a 2px stroke. -->
        <Style x:Key="Glyph" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>

        <!-- A turning arc while the condition holds and it can be seen (EfficiencyMode.WhileSeen). -->
        <Style x:Key="Spinner" TargetType="Path" BasedOn="{StaticResource Glyph}">
            <Setter Property="Data" Value="{StaticResource StepSpinner}" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{x:Static s:EfficiencyMode.WhileSeen}">
                            <Binding Path="IsVisible" RelativeSource="{RelativeSource Self}" />
                            <Binding Path="IsVisible" RelativeSource="{RelativeSource Self}" />
                            <Binding Path="(s:EfficiencyMode.IsSaving)" RelativeSource="{RelativeSource Self}" />
                            <Binding Path="(s:Motion.Off)" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Turn">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:0.9" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Turn" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource TextSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource LogMuted}" />
            <Setter Property="Margin" Value="10,0,10,6" />
        </Style>

        <!-- A stage in the rail: its icon, name and duration, coloured by how it went - laid out like the Terminal tab's
             list, the running one highlighted. Its content 10 from the rail's edges (margin and padding), as the header's,
             the labels' and the summary's. -->
        <!-- A stage is a button: clicked (or Enter / Space), the log scrolls to it. One still to come isn't in the log yet,
             so it can't be clicked. Flat - the row inside draws it. -->
        <Style x:Key="StageButton" TargetType="Button">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="StageRow" DataType="{x:Type s:OutputStage}">
            <Button Style="{StaticResource StageButton}" IsEnabled="{Binding IsShownInLog}" Click="Stage_Click"
                    AutomationProperties.Name="{Binding Title}">
            <Border x:Name="Row" Padding="6,4,6,4" Margin="4,1" CornerRadius="{StaticResource ControlRadius}" Background="Transparent"
                    ToolTip="{Binding Title}">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,10,0">
                        <Path x:Name="Icon" Style="{StaticResource Glyph}" Data="{StaticResource StepCircle}"
                              Stroke="{DynamicResource OutDim}" StrokeThickness="1.5" />
                        <Path x:Name="Spin" Style="{StaticResource Spinner}" Stroke="{DynamicResource OutActive}" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="Duration" DockPanel.Dock="Right" Text="{Binding DurationText}" Margin="10,0,0,0"
                               Foreground="{DynamicResource LogMuted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="Name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{DynamicResource LogFg}" />
                </DockPanel>
            </Border>
            </Button>
            <DataTemplate.Triggers>
                <!-- Under the mouse, a stage that can be clicked is lit; how it went (below) still colours it. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True" />
                        <Condition Binding="{Binding IsShownInLog}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBg}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static s:StageStatus.Pending}">
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource OutDim}" />
                    <Setter TargetName="Duration" Property="Foreground" Value="{DynamicResource OutDim}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static s:StageStatus.Running}">
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Spin" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBg}" />
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource LogHeaderFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static s:StageStatus.Ok}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource StepCheck}" />
                    <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource OutOk}" />
                    <Setter TargetName="Icon" Property="StrokeThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static s:StageStatus.Warning}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource StepTriangle}" />
                    <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource OutWarn}" />
                    <Setter TargetName="Icon" Property="StrokeThickness" Value="1.6" />
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource OutWarnRowBg}" />
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource OutWarnText}" />
                    <Setter TargetName="Duration" Property="Foreground" Value="{DynamicResource OutWarn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static s:StageStatus.Failed}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource StepCross}" />
                    <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource OutError}" />
                    <Setter TargetName="Icon" Property="StrokeThickness" Value="2" />
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource OutErrorBg}" />
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource OutErrorText}" />
                    <Setter TargetName="Duration" Property="Foreground" Value="{DynamicResource OutErrorSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static s:StageStatus.Skipped}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource StepDash}" />
                    <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource OutSkippedIcon}" />
                    <Setter TargetName="Icon" Property="StrokeThickness" Value="2" />
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource OutDim}" />
                    <Setter TargetName="Duration" Property="Foreground" Value="{DynamicResource OutDim}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static s:StageStatus.Cancelled}">
                    <Setter TargetName="Icon" Property="Data" Value="{StaticResource StepCross}" />
                    <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource OutMuted}" />
                    <Setter TargetName="Icon" Property="StrokeThickness" Value="2" />
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource OutMuted}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A site kept warm: its dot (teal warm or warming up, grey paused, red failing), name and last answer. -->
        <DataTemplate x:Key="BackgroundRow">
            <DockPanel Margin="10,4,10,4" ToolTip="{Binding KeepWarmText}">
                <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="8" Height="8" Margin="3,0,13,0" VerticalAlignment="Center"
                         Fill="{DynamicResource OutActive}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding KeepWarmAnswerText}" Foreground="{DynamicResource LogMuted}"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource LogFg}">
                    <Run Text="Keep warm · " /><Run Text="{Binding Name, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding KeepWarmLook}" Value="Paused">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource OutDim}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding KeepWarmLook}" Value="Problem">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource OutError}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A line of the summary: its name, and its value on the right. -->
        <Style x:Key="SummaryKey" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LogMuted}" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LogFg}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="12,3,0,3" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ─── Header strip: status, title, what it works with; issues, times, duration ─── -->
        <Border x:Name="Header" Background="{DynamicResource LogBg}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1" Padding="10,0">
            <Grid>
                <TextBlock x:Name="NoRun" Text="No operation has run yet - what DNN Manager does shows here, stage by stage."
                           Foreground="{DynamicResource LogMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <DockPanel x:Name="RunHeader" DataContext="{x:Null}" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="Issues" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Path x:Name="IssueIcon" Style="{StaticResource Glyph}" StrokeThickness="1.5" Margin="0,0,6,0" />
                            <TextBlock x:Name="IssueText" Text="{Binding IssueText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding TimeRange}" Foreground="{DynamicResource LogMuted}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DurationText}" Foreground="{DynamicResource LogHeaderFg}" FontWeight="SemiBold" Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- The status pill. -->
                    <Border x:Name="Pill" DockPanel.Dock="Left" CornerRadius="10" Padding="8,2,10,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="12" Height="12" Margin="0,0,6,0">
                                <Path x:Name="PillIcon" Style="{StaticResource Glyph}" Width="14" Height="14" StrokeThickness="2">
                                    <Path.LayoutTransform>
                                        <ScaleTransform ScaleX="0.86" ScaleY="0.86" />
                                    </Path.LayoutTransform>
                                </Path>
                                <!-- Drawn at 12 px (not the 14 px one scaled down): it turns round its own centre, without wobbling. -->
                                <Path x:Name="PillSpin" Style="{StaticResource Spinner}" Width="12" Height="12" StrokeThickness="1.8"
                                      Data="{StaticResource StepSmallSpinner}" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock x:Name="PillText" FontSize="{DynamicResource TextSmall}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="RunTitle" DockPanel.Dock="Left" Text="{Binding Title}" FontSize="{DynamicResource TextBody}" FontWeight="SemiBold"
                               Margin="12,0,0,0" Foreground="{DynamicResource LogHeaderFg}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource LogMuted}" Margin="12,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- The stage rail: 220 wide at first - drag its right edge to make it wider or narrower. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="150" MaxWidth="560" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ─── Stage rail: the stages at the top (they scroll); the background activity and the summary at the bottom ─── -->
            <Border Background="{DynamicResource LogBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Last, so lowest: warnings and errors. 10 round it, as at the sides (its lines' own 3, SummaryKey /
                         SummaryValue, count towards it). -->
                    <Border x:Name="Summary" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0"
                            Margin="10,10,10,7" Padding="0,7,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <ItemsControl x:Name="Facts" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type s:OutputFact}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource SummaryValue}" Text="{Binding Value}" />
                                            <TextBlock Style="{StaticResource SummaryKey}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel>
                                <TextBlock x:Name="WarningCount" DockPanel.Dock="Right" Style="{StaticResource SummaryValue}" />
                                <TextBlock Style="{StaticResource SummaryKey}" Text="Warnings" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock x:Name="ErrorCount" DockPanel.Dock="Right" Style="{StaticResource SummaryValue}" />
                                <TextBlock Style="{StaticResource SummaryKey}" Text="Errors" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <!-- Above it: what runs in the background (sites kept warm). -->
                    <StackPanel x:Name="BackgroundPart" DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="BackgroundLabel" Style="{StaticResource SectionLabel}" Text="Background" />
                        <ItemsControl x:Name="BackgroundList" Focusable="False" ItemTemplate="{StaticResource BackgroundRow}" />
                        <!-- One line, cut short when the rail is narrow - the whole of it on hover. -->
                        <TextBlock x:Name="BackgroundNote" FontSize="{DynamicResource TextSmall}" Foreground="{DynamicResource LogMuted}" Margin="34,2,10,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                    <!-- The rest: the stages, scrolling when there are more than fit. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="StagesPart" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="StagesLabel" Style="{StaticResource SectionLabel}" />
                            <ItemsControl x:Name="Stages" Focusable="False" ItemTemplate="{StaticResource StageRow}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- The rail's right edge: drag it; lit while the mouse is on it. Over the rail's own border, so nothing moves. -->
            <GridSplitter Grid.Column="0" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch" ResizeDirection="Columns"
                          ResizeBehavior="CurrentAndNext" Focusable="False" Panel.ZIndex="5" ToolTip="Drag to resize the stages">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="Bd" Background="Transparent" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- ─── The log: every operation, grouped by stage ─── -->
            <Grid Grid.Column="1" Background="{DynamicResource OutLogBg}">
                <c:PipelineLog x:Name="Log" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource OutText}"
                               FontFamily="JetBrains Mono, Cascadia Mono, Consolas, Courier New" FontSize="12.5"
                               SelectionBrush="{DynamicResource Accent}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
