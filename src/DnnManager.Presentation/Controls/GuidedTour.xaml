<UserControl x:Class="DnnManager.Presentation.Controls.GuidedTour"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="True" FocusVisualStyle="{x:Null}" KeyboardNavigation.TabNavigation="Cycle"
             AutomationProperties.Name="Tour">
    <!-- Over the whole window: dimmed, with a hole around the part the stop is about, and a card beside it that says what
         it is. Transparent, not empty: a click anywhere lands here, not on the window under it. -->
    <Grid Background="Transparent">
        <Path x:Name="Backdrop" Fill="{DynamicResource TourBackdrop}" IsHitTestVisible="False" />
        <Canvas x:Name="Stage">
            <Border x:Name="Ring" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="6" IsHitTestVisible="False" />
            <!-- Over the title bar too: its buttons take the click there, not the window's drag. The shadow is a layer of its
                 own behind the card: an effect on the card itself would draw its text as a bitmap, without ClearType - soft. -->
            <Grid x:Name="Callout" Width="340" WindowChrome.IsHitTestVisibleInChrome="True" UseLayoutRounding="True">
                <Border Background="{DynamicResource CardBg}" CornerRadius="8" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" />
                    </Border.Effect>
                </Border>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="18,14,18,14">
                <StackPanel>
                    <TextBlock x:Name="CountText" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextCaption}" />
                    <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TextMedium}" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock x:Name="BodyText" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0" />
                    <DockPanel Margin="0,14,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BackButton" Content="Back" MinWidth="70" Click="Back_Click" ToolTip="The previous part (←)" />
                            <Button x:Name="NextButton" Style="{StaticResource Primary}" Content="Next" MinWidth="70" Margin="8,0,0,0" Click="Next_Click" />
                        </StackPanel>
                        <Button x:Name="SkipButton" Style="{StaticResource LinkButton}" Content="Skip tour" VerticalAlignment="Center"
                                Click="Skip_Click" ToolTip="End the tour (Esc) - Help opens it again" />
                    </DockPanel>
                </StackPanel>
                </Border>
            </Grid>
        </Canvas>
    </Grid>
</UserControl>
