<Window x:Class="DnnManager.Presentation.Controls.DeploymentExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DnnManager.Presentation.Controls"
        Title="Export for deployment" Icon="pack://application:,,,/DnnManager;component/src/DnnManager.Presentation/Assets/dnn.ico" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}">
    <!-- What the package for the live server is made for: its domains, HTTPS, its database and where it goes. -->
    <StackPanel Margin="20">
        <TextBlock x:Name="Intro" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="Live domain(s)" Margin="0,12,0,4" />
        <TextBox AutomationProperties.Name="Live domain(s)" x:Name="DomainsBox" TextChanged="Field_Changed" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="Comma- or space-separated host names, e.g. www.example.com, example.com - the first is the primary portal alias. Left empty, the portal aliases stay as they are." />
        <CheckBox x:Name="HttpsBox" Content="The live site uses HTTPS" IsChecked="True" Margin="0,14,0,0" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="Switches DNN's SSL setting on, and turns the HTTPS redirect rules DNN Manager switched off back on." />
        <TextBlock Style="{StaticResource FieldLabel}" Text="Live database connection string (optional)" Margin="0,14,0,4" />
        <TextBox AutomationProperties.Name="Live database connection string (optional)" x:Name="ConnectionBox" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="44" MaxHeight="88"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
        <TextBlock Style="{StaticResource Hint}" Text="Left empty, web.config gets a placeholder to fill in on the server." />
        <CheckBox x:Name="IncludeDatabaseBox" Content="Include the database (.bacpac)" Margin="0,14,0,0" />
        <TextBlock x:Name="NoDatabaseHint" Style="{StaticResource Hint}" Text="The site's web.config names no database that can be exported."
                   Visibility="Collapsed" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="Folder" Margin="0,14,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" MinWidth="80" Margin="8,0,0,0" ToolTip="Browse…" Click="Browse_Click" />
            <TextBox AutomationProperties.Name="Folder" x:Name="FolderBox" TextChanged="Field_Changed" />
        </DockPanel>
        <TextBlock x:Name="FolderHint" Style="{StaticResource Hint}" />
        <TextBlock x:Name="Problem" Style="{StaticResource ErrorLine}" c:FieldError.For="{Binding ElementName=OkButton}" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="Export" Style="{StaticResource Primary}" MinWidth="80" IsDefault="True" IsEnabled="False" Click="Ok_Click"
                    ToolTip="Export (Enter)" />
            <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" ToolTip="Cancel (Esc)" />
        </StackPanel>
    </StackPanel>
</Window>
