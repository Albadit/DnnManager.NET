<UserControl x:Class="DnnManager.Presentation.Controls.ToastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" MaxWidth="480" MinWidth="260">
    <!-- A short message over the bottom-right corner of the page - e.g. "Settings saved" - that fades out by itself. -->
    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            CornerRadius="6" Padding="14,10,8,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.3" />
        </Border.Effect>
        <DockPanel>
            <Button AutomationProperties.Name="Close" DockPanel.Dock="Right" ToolTip="Close" Click="Close_Click" VerticalAlignment="Center" Margin="6,0,0,0"
                    Foreground="{DynamicResource TextMuted}" Cursor="Hand" Width="26" Height="26">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="{StaticResource GlyphCancel}" FontFamily="{StaticResource IconFont}" FontSize="11" />
            </Button>
            <Button DockPanel.Dock="Right" x:Name="ActionButton" Style="{StaticResource Primary}" Visibility="Collapsed"
                    ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}"
                    VerticalAlignment="Center" Margin="12,0,0,0" Click="Action_Click" />
            <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" FontSize="16"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Message" TextWrapping="Wrap" />
                <!-- Others waiting their turn (ToastQueue): they show when this one is closed. -->
                <TextBlock x:Name="More" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextCaption}"
                           Margin="0,2,0,0" Visibility="Collapsed" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
