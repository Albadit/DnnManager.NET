<UserControl x:Class="DnnManager.Presentation.Controls.IisCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" x:Name="TestButton" Content="Test" MinWidth="80" Margin="8,0,0,0"
                        ToolTip="Test"
                        VerticalAlignment="Center" Click="Test_Click" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CardTitle}" Text="IIS" Margin="0" />
                    <TextBlock x:Name="Summary" Style="{StaticResource Hint}" Margin="0,2,0,0" Text="Windows features: not tested yet - press Test." />
                </StackPanel>
            </DockPanel>

            <!-- A plain table (a DataGrid here would swallow the page's mouse-wheel scrolling). -->
            <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4" Grid.IsSharedSizeScope="True">
                <StackPanel>
                    <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1"
                            CornerRadius="4,4,0,0" Padding="12,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Feature" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="FeatureStatus" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Feature" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Grid.Column="2" Text="Status" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Grid.Column="4" Text="Windows feature name" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="FeatureList" AlternationCount="100000">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" BorderBrush="{DynamicResource GridLine}" BorderThickness="0,1,0,0" Padding="12,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Feature" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FeatureStatus" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" />
                                        <TextBlock x:Name="State" Grid.Column="2" Text="{Binding Status}" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Name}" Foreground="{DynamicResource TextMuted}"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="{DynamicResource TextCaption}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- No divider above the first row - the header already has one. -->
                                    <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                                        <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Enabled">
                                        <Setter TargetName="State" Property="Foreground" Value="{DynamicResource SuccessText}" />
                                        <Setter TargetName="State" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Missing">
                                        <Setter TargetName="State" Property="Foreground" Value="{DynamicResource ErrorText}" />
                                        <Setter TargetName="State" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,10,0,0">
                <Button x:Name="SetupButton" Style="{StaticResource Primary}" Content="Set up IIS" Click="Setup_Click"
                        ToolTip="Set up IIS" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
