<UserControl x:Class="DnnManager.Presentation.Pages.SourceControlPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:DnnManager.Presentation.Pages"
             xmlns:c="clr-namespace:DnnManager.Presentation.Controls">
    <!-- Source Control, laid out as VS Code's: in the window's primary side bar (SideGrid - taken out of the page as it is
         made, see SideBar) the servers (its repositories), the message and Push, the changes in groups - staged, to push,
         to pull, conflicts - each with its status letter, and the history (its graph); in the page the chosen file's diff,
         or the chosen operation of the history. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- A section's title, as VS Code writes it: small capitals, muted, with its chevron. -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource TextSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SmallIcon" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- A row's buttons show while the pointer is on it, or it is chosen - VS Code's inline actions. Collapsed, not
             hidden, the rest of the time: the name has the row's whole width. -->
        <Style x:Key="RowActions" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- VS Code's status letters and their colours: M modified, A added, D deleted, ! conflict. -->
        <Style x:Key="Letter" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="16" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Text" Value="{Binding Letter}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Letter}" Value="M"><Setter Property="Foreground" Value="{DynamicResource LogWarn}" /></DataTrigger>
                <DataTrigger Binding="{Binding Letter}" Value="A"><Setter Property="Foreground" Value="{DynamicResource SuccessText}" /></DataTrigger>
                <DataTrigger Binding="{Binding Letter}" Value="D"><Setter Property="Foreground" Value="{DynamicResource ErrorText}" /></DataTrigger>
                <DataTrigger Binding="{Binding Letter}" Value="!"><Setter Property="Foreground" Value="{DynamicResource DeployConflict}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A group's header: chevron, title, count - and stage or unstage all of it. -->
        <DataTemplate x:Key="HeaderRow" DataType="{x:Type p:ChangeRow}">
            <DockPanel Background="Transparent" MinHeight="24" MouseLeftButtonUp="Header_Click" Cursor="Hand"
                       ToolTip="Open or close the group">
                <Border DockPanel.Dock="Right" Background="{DynamicResource HoverBg}" CornerRadius="8" Padding="6,0" Margin="4,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Count}" FontSize="{DynamicResource TextSmall}" />
                </Border>
                <StackPanel DockPanel.Dock="Right" Style="{StaticResource RowActions}">
                    <Button Style="{StaticResource SmallIcon}" Content="{StaticResource GlyphAdd}" Click="StageGroup_Click" Tag="{Binding}"
                            ToolTip="Stage all" Visibility="{Binding CanStageAll, Converter={StaticResource Visible}}" />
                    <Button Style="{StaticResource SmallIcon}" Content="{StaticResource GlyphDash}" Click="UnstageGroup_Click" Tag="{Binding}"
                            ToolTip="Unstage all" Visibility="{Binding CanUnstageAll, Converter={StaticResource Visible}}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Glyph}" FontSize="9" Width="16" Text="{Binding Chevron}" Foreground="{DynamicResource TextMuted}" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>
        <!-- A file: its name, its folder (muted), its buttons, its letter - its icon under the group's chevron, as VS Code
             indents it. A click opens it in the preview tab, a double-click keeps it open (Changes_DoubleClick). -->
        <DataTemplate x:Key="FileRow" DataType="{x:Type p:ChangeRow}">
            <DockPanel Background="Transparent" MinHeight="24" ToolTip="{Binding Tip}">
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Letter}" />
                <StackPanel DockPanel.Dock="Right" Style="{StaticResource RowActions}">
                    <Button Style="{StaticResource SmallIcon}" Content="{StaticResource GlyphAdd}" Click="Stage_Click" Tag="{Binding}"
                            ToolTip="Stage - to push or pull it with the others staged" Visibility="{Binding CanStage, Converter={StaticResource Visible}}" />
                    <Button Style="{StaticResource SmallIcon}" Content="{StaticResource GlyphDash}" Click="Unstage_Click" Tag="{Binding}"
                            ToolTip="Unstage" Visibility="{Binding IsStaged, Converter={StaticResource Visible}}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{Binding Icon}" Foreground="{Binding IconBrush}" Width="16"
                           TextAlignment="Center" Margin="0,0,6,0" />
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Arrow, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" /><Run Text="{Binding Name, Mode=OneWay}" />
                    <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextSmall}" />
                </TextBlock>
            </DockPanel>
        </DataTemplate>
        <p:ChangeRowTemplates x:Key="RowTemplates" Header="{StaticResource HeaderRow}" File="{StaticResource FileRow}" />
        <!-- A part of the Push bar: VS Code's Commit button is one blue bar, its ▾ a part of it behind a thin line. -->
        <Style x:Key="SplitPart" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding Tag}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The side bar's views, as VS Code's activity bar on top: an icon each, the one shown with a line under it. The
             icons as tall as the medium text, so they grow with the font size chosen in Settings. -->
        <Style x:Key="ViewTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="9,8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="Line" Height="2" VerticalAlignment="Bottom" Margin="6,0" Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ViewIcon" TargetType="Viewbox">
            <Setter Property="Height" Value="{DynamicResource TextMedium}" />
            <Setter Property="Width" Value="{Binding Height, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="ViewPath" TargetType="Path" BasedOn="{StaticResource IconStroke}">
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </Style>
        <!-- A tab's ×: there while the pointer is on its row, or it is chosen - hidden, not collapsed, so nothing moves. -->
        <Style x:Key="HoverClose" TargetType="Button" BasedOn="{StaticResource SmallIcon}">
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A small toggle in the search box - Match Case, Match Whole Word, Use Regular Expression - as VS Code's. -->
        <Style x:Key="FindToggle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggleButton}">
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Height" Value="NaN" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="{DynamicResource TextSmall}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        </Style>

        <!-- A file or folder of the project in the Explorer: indented by its depth; a folder's chevron, a file's icon; a
             changed file's letter. A click opens a file in the preview tab, a double-click keeps it; a click on a folder
             opens or closes it. -->
        <DataTemplate x:Key="ExplorerItem" DataType="{x:Type p:ExplorerRow}">
            <DockPanel Background="Transparent" MinHeight="22" ToolTip="{Binding Path}">
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Letter}" />
                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="9" Width="16" Text="{Binding Chevron}" Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Icon}" Foreground="{Binding IconBrush}" Width="16" TextAlignment="Center" Margin="0,0,4,0" />
                </StackPanel>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <!-- A search result's file: chevron, icon, name, folder, how many matches. A click opens or closes it. -->
        <DataTemplate x:Key="SearchFileRow" DataType="{x:Type p:SearchRow}">
            <DockPanel Background="Transparent" MinHeight="22" ToolTip="{Binding Tip}">
                <Border DockPanel.Dock="Right" Background="{DynamicResource HoverBg}" CornerRadius="8" Padding="6,0" Margin="4,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Count}" FontSize="{DynamicResource TextSmall}" />
                </Border>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" FontSize="9" Width="16" Text="{Binding Chevron}" Foreground="{DynamicResource TextMuted}" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{Binding Icon}" Foreground="{Binding IconBrush}" Width="16" TextAlignment="Center" Margin="0,0,4,0" />
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Name, Mode=OneWay}" />
                    <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextSmall}" />
                </TextBlock>
            </DockPanel>
        </DataTemplate>
        <!-- A match: a little of the line before it, the match marked - struck through, the replacement after it, while
             Replace has text - and the rest of the line. A click opens the file there. -->
        <DataTemplate x:Key="SearchMatchRow" DataType="{x:Type p:SearchRow}">
            <TextBlock Margin="32,0,0,0" MinHeight="20" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tip}" Background="Transparent">
                <Run Text="{Binding Before, Mode=OneWay}" /><Run Text="{Binding Text, Mode=OneWay}" Background="{DynamicResource SearchMatchBg}"
                     TextDecorations="{Binding Strike, Mode=OneWay}" /><Run Text="{Binding Replacement, Mode=OneWay}" Background="{DynamicResource DiffAddedBg}" /><Run
                     Text="{Binding After, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>
        <p:SearchRowTemplates x:Key="SearchTemplates" File="{StaticResource SearchFileRow}" Match="{StaticResource SearchMatchRow}" />
    </UserControl.Resources>

    <Grid x:Name="Root">
        <!-- ─── The side bar's views - the window's primary side bar shows them ─── -->
        <!-- Source Control, Explorer and Search, as VS Code's: an icon each across the top (Ctrl+Shift+G, Ctrl+Shift+E,
             Ctrl+Shift+F), the chosen view under them. -->
        <DockPanel x:Name="SideGrid" PreviewKeyDown="SideGrid_PreviewKeyDown">
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="7,0">
                <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <RadioButton x:Name="ScmTab" Style="{StaticResource ViewTab}" GroupName="SideView" IsChecked="True" Checked="View_Checked"
                                 AutomationProperties.Name="Source Control" ToolTip="Source Control (Ctrl+Shift+G)">
                        <Grid>
                            <Viewbox Style="{StaticResource ViewIcon}"><Grid Width="16" Height="16"><Path Style="{StaticResource ViewPath}" Data="{StaticResource SourceControlGeometry}" /></Grid></Viewbox>
                            <!-- How many files differ - VS Code's badge. -->
                            <Border x:Name="ChangeBadge" Background="{DynamicResource Accent}" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-9,-5" Visibility="Collapsed">
                                <TextBlock x:Name="ChangeBadgeText" Foreground="{DynamicResource OnAccent}" FontSize="9" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="ExplorerTab" Style="{StaticResource ViewTab}" GroupName="SideView" Checked="View_Checked"
                                 AutomationProperties.Name="Explorer" ToolTip="Explorer - the project's files and the open editors (Ctrl+Shift+E)">
                        <Viewbox Style="{StaticResource ViewIcon}"><Grid Width="16" Height="16"><Path Style="{StaticResource ViewPath}" Data="{StaticResource ExplorerGeometry}" /></Grid></Viewbox>
                    </RadioButton>
                    <RadioButton x:Name="SearchTab" Style="{StaticResource ViewTab}" GroupName="SideView" Checked="View_Checked"
                                 AutomationProperties.Name="Search" ToolTip="Search - find and replace in the project's files (Ctrl+Shift+F)">
                        <Viewbox Style="{StaticResource ViewIcon}"><Grid Width="16" Height="16"><Path Style="{StaticResource ViewPath}" Data="{StaticResource SearchGeometry}" /></Grid></Viewbox>
                    </RadioButton>
                </StackPanel>
            </Border>
            <Grid>
            <Grid x:Name="ScmView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="HistoryRow" Height="220" MinHeight="32" />
                </Grid.RowDefinitions>
                <!-- DEPLOY, and what VS Code has on its title: compare (refresh), add, more. -->
                <DockPanel Margin="16,10,8,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="ScanButton" Style="{StaticResource SmallIcon}" Content="{StaticResource GlyphRefresh}" Click="Scan_Click"
                                ToolTip="Compare with the server (F5) - what changed in the project, on the server, or in both" />
                        <Button Style="{StaticResource SmallIcon}" Content="{StaticResource GlyphAdd}" Click="Add_Click"
                                ToolTip="Add a server to a project" />
                        <Button x:Name="MoreButton" Style="{StaticResource SmallIcon}" Content="{StaticResource GlyphMore}" Click="More_Click"
                                ToolTip="More actions: stage all, unstage all, edit, test or remove the server" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="SOURCE CONTROL" />
                </DockPanel>
                <ProgressBar x:Name="ProgressBar" Grid.Row="1" Height="2" Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0"
                             Visibility="Hidden" AutomationProperties.Name="Progress" />

                <!-- SERVERS - every project's, VS Code's repositories. -->
                <StackPanel Grid.Row="2">
                    <DockPanel Margin="4,2,8,0">
                        <ToggleButton x:Name="ServersToggle" DockPanel.Dock="Left" Style="{StaticResource ExpandToggle}" IsChecked="True" Focusable="True"
                                      Foreground="{DynamicResource TextMuted}" AutomationProperties.Name="Servers" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="SERVERS" Margin="2,0,0,0" />
                    </DockPanel>
                    <!-- Ctrl+click or Shift+click chooses more than one: each is compared, one is shown (CHANGES' header). -->
                    <ListBox x:Name="ServersList" MaxHeight="190" Margin="8,0,8,4" BorderThickness="0" Background="Transparent"
                             SelectionMode="Extended" SelectionChanged="Server_Changed" AutomationProperties.Name="Servers" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding IsChecked, ElementName=ServersToggle, Converter={StaticResource Visible}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type p:ServerRow}">
                                <DockPanel ToolTip="{Binding Tip}" Background="Transparent">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Counts}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                               Margin="8,0,0,0" FontSize="{DynamicResource TextSmall}" />
                                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Health}" />
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Site, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextSmall}" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Compare" Click="Scan_Click" InputGestureText="F5" />
                                <MenuItem Header="Edit connection…" Click="Edit_Click" />
                                <MenuItem Header="Test connection" Click="Test_Click" />
                                <Separator />
                                <MenuItem Header="Remove connection…" Click="Remove_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </StackPanel>

                <!-- CHANGES - the message, Push (its ▾ the rest), and the groups. -->
                <Border Grid.Row="3" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="4,4,8,0">
                    <DockPanel>
                        <TextBlock x:Name="ScanSummary" DockPanel.Dock="Right" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextSmall}"
                                   VerticalAlignment="Center" />
                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource ExpandToggle}" IsChecked="True" IsEnabled="False"
                                      Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="CHANGES" Margin="2,0,0,0" />
                        <!-- Several servers chosen: which one's changes these are - a click shows another's. -->
                        <Button x:Name="ChangesServer" Style="{StaticResource LinkButton}" Margin="8,0,8,0" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Visibility="Collapsed" Click="ChangesServer_Click" ToolTip="Several servers are chosen - show another one's changes"
                                AutomationProperties.Name="Show another chosen server's changes">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ChangesServerText" FontSize="{DynamicResource TextSmall}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource GlyphChevronDown}" FontSize="9" Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>
                <StackPanel x:Name="CommitArea" Grid.Row="4" Margin="16,6,12,6">
                    <TextBox x:Name="CommitMessage" Style="{StaticResource SearchBox}" Tag="Message (Ctrl+Enter to push)" AutomationProperties.Name="Message"
                             MaxLength="500" PreviewKeyDown="CommitMessage_KeyDown" />
                    <!-- One blue bar as tall as the message box: Push, a thin line, its ▾ - VS Code's Commit button. -->
                    <Border x:Name="PushBar" Margin="0,6,0,0" Height="{StaticResource SearchHeight}" CornerRadius="4" Background="{DynamicResource Accent}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PrimaryButton" Style="{StaticResource SplitPart}" Tag="4,0,0,4" Click="Primary_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PrimaryGlyph" Style="{StaticResource Glyph}" Text="{StaticResource GlyphUpload}" Margin="0,0,6,0" />
                                    <TextBlock x:Name="PrimaryLabel" Text="Push" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border Grid.Column="1" Background="{DynamicResource OnAccent}" Opacity="0.35" Margin="0,5" />
                            <Button x:Name="ActionsButton" Grid.Column="2" Style="{StaticResource SplitPart}" Tag="0,4,4,0" Click="Actions_Click"
                                    ToolTip="More: pull, pull into a review folder, compare" AutomationProperties.Name="More push and pull actions">
                                <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource GlyphChevronDown}" FontSize="10" />
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" Margin="0,4,0,0" />
                </StackPanel>
                <Grid Grid.Row="5">
                    <ListBox x:Name="Changes" BorderThickness="0" Background="Transparent" Margin="0,0,0,4"
                             ItemTemplateSelector="{StaticResource RowTemplates}" SelectionChanged="Change_Changed" KeyDown="Changes_KeyDown"
                             MouseDoubleClick="Changes_DoubleClick"
                             ScrollViewer.ScrollChanged="Changes_ScrollChanged" AutomationProperties.Name="Changes" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="4,1" />
                                <Setter Property="Margin" Value="4,0" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ContextMenu>
                            <ContextMenu Opened="ChangesMenu_Opened">
                                <MenuItem x:Name="StageFolderItem" Click="StageFolder_Click" />
                                <MenuItem x:Name="UnstageFolderItem" Click="UnstageFolder_Click" />
                                <Separator />
                                <MenuItem Header="Copy path" Click="CopyPath_Click" />
                                <MenuItem Header="Open in File Explorer" Click="Reveal_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock x:Name="ChangesMessage" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="16,8" VerticalAlignment="Top" />
                    <!-- The header of the group scrolled through, over the list's top: closed from here without scrolling up. -->
                    <ContentControl x:Name="StickyHeader" VerticalAlignment="Top" Margin="4,0,4,0" Padding="4,1" Visibility="Collapsed"
                                    ContentTemplate="{StaticResource HeaderRow}" Focusable="False" Background="{DynamicResource WindowBg}">
                        <ContentControl.Template>
                            <ControlTemplate TargetType="ContentControl">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="0,0,0,1">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </ContentControl.Template>
                    </ContentControl>
                </Grid>

                <!-- Dragged up or down: the history bigger or smaller, as VS Code's views. -->
                <c:Sash x:Name="HistorySash" Grid.Row="6" Orientation="Horizontal" Height="6" Cursor="SizeNS" Margin="0,-3,0,-3"
                        DragStarted="HistorySash_DragStarted" DragDelta="HistorySash_DragDelta" Panel.ZIndex="1" />
                <!-- HISTORY - VS Code's graph, at the bottom. -->
                <DockPanel Grid.Row="7">
                    <!-- Its chevron as far from the side as from the bottom, where it is when folded - as the other titles' from the side. -->
                    <Border x:Name="HistoryHeader" DockPanel.Dock="Top" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="4,4,8,4">
                        <DockPanel>
                            <ToggleButton x:Name="HistoryToggle" DockPanel.Dock="Left" Style="{StaticResource ExpandToggle}" IsChecked="True" Focusable="True"
                                          Foreground="{DynamicResource TextMuted}" AutomationProperties.Name="History" Click="HistoryToggle_Click" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="HISTORY" Margin="2,0,0,0" />
                        </DockPanel>
                    </Border>
                    <Grid x:Name="HistoryBody">
                        <ListBox x:Name="HistoryList" BorderThickness="0" Background="Transparent" Margin="8,0,8,8" SelectionChanged="Operation_Changed"
                                 AutomationProperties.Name="History" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type p:OperationRow}">
                                    <DockPanel ToolTip="{Binding Tip}" Background="Transparent">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Foreground="{DynamicResource TextMuted}"
                                                   FontSize="{DynamicResource TextSmall}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Arrow}" Width="18" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Opacity="{Binding Opacity}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="HistoryMessage" Style="{StaticResource Hint}" Margin="16,8" TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="Nothing pushed or pulled with this server yet." />
                    </Grid>
                </DockPanel>
            </Grid>

            <!-- EXPLORER - the open editors, and the project's files as a push sees them (the server's ignore rules). -->
            <DockPanel x:Name="ExplorerView" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="16,10,8,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource SmallIcon}" Content="{StaticResource GlyphRefresh}" Click="ExplorerRefresh_Click"
                                ToolTip="Refresh Explorer" AutomationProperties.Name="Refresh Explorer" />
                        <Button Style="{StaticResource SmallIcon}" Content="{StaticResource GlyphChevronUp}" Click="ExplorerCollapse_Click"
                                ToolTip="Collapse folders in Explorer" AutomationProperties.Name="Collapse folders in Explorer" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="EXPLORER" />
                </DockPanel>
                <!-- OPEN EDITORS - the tabs: a click shows one, its × closes it. -->
                <DockPanel DockPanel.Dock="Top" Margin="4,2,8,0">
                    <ToggleButton x:Name="OpenEditorsToggle" DockPanel.Dock="Left" Style="{StaticResource ExpandToggle}" IsChecked="True" Focusable="True"
                                  Foreground="{DynamicResource TextMuted}" AutomationProperties.Name="Open editors" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="OPEN EDITORS" Margin="2,0,0,0" />
                </DockPanel>
                <Grid DockPanel.Dock="Top" Visibility="{Binding IsChecked, ElementName=OpenEditorsToggle, Converter={StaticResource Visible}}">
                    <ListBox x:Name="OpenEditors" MaxHeight="200" Margin="0,0,0,4" BorderThickness="0" Background="Transparent"
                             SelectionChanged="OpenEditors_Changed" AutomationProperties.Name="Open editors" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="4,1" />
                                <Setter Property="Margin" Value="4,0" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type p:EditorTab}">
                                <DockPanel Background="Transparent" MinHeight="22" ToolTip="{Binding Tip}" MouseDown="Tab_MouseDown">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Letter}" />
                                    <!-- Its × in front, as VS Code's: there while the pointer is on the row, or it is chosen - its
                                         place kept the rest of the time, so the names don't move. -->
                                    <Grid DockPanel.Dock="Left" Width="20">
                                        <Button Style="{StaticResource HoverClose}" Width="18" Height="18" FontSize="10" Content="{StaticResource GlyphClose}"
                                                Click="CloseTab_Click" Tag="{Binding}" ToolTip="Close" AutomationProperties.Name="Close" />
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{Binding Icon}" Foreground="{Binding IconBrush}" Width="16"
                                               TextAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontStyle="{Binding NameStyle, Mode=OneWay}" />
                                        <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextSmall}" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="OpenEditorsMessage" Style="{StaticResource Hint}" Margin="24,2,8,6" Text="No file is open." />
                </Grid>
                <!-- The project's folder, by its name: its files, folders first. -->
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="4,4,8,2">
                    <DockPanel>
                        <ToggleButton x:Name="ProjectFilesToggle" DockPanel.Dock="Left" Style="{StaticResource ExpandToggle}" IsChecked="True" Focusable="True"
                                      Foreground="{DynamicResource TextMuted}" AutomationProperties.Name="Project files" />
                        <TextBlock x:Name="ProjectFilesTitle" Style="{StaticResource SectionTitle}" Text="PROJECT" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
                <Grid Visibility="{Binding IsChecked, ElementName=ProjectFilesToggle, Converter={StaticResource Visible}}">
                    <ListBox x:Name="ExplorerTree" BorderThickness="0" Background="Transparent" Margin="0,0,0,4" KeyDown="ExplorerTree_KeyDown"
                             ItemTemplate="{StaticResource ExplorerItem}" AutomationProperties.Name="Project files" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="Margin" Value="4,0" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                                <EventSetter Event="MouseLeftButtonUp" Handler="ExplorerItem_Click" />
                                <EventSetter Event="MouseDoubleClick" Handler="ExplorerItem_DoubleClick" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy path" Click="ExplorerCopyPath_Click" />
                                <MenuItem Header="Open in File Explorer" Click="ExplorerReveal_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock x:Name="ExplorerMessage" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="16,8" VerticalAlignment="Top" Visibility="Collapsed" />
                </Grid>
            </DockPanel>

            <!-- SEARCH - find in the project's files, and replace: VS Code's search view. -->
            <DockPanel x:Name="SearchView" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="16,10,8,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource SmallIcon}" Content="{StaticResource GlyphRefresh}" Click="SearchRefresh_Click"
                                ToolTip="Search again" AutomationProperties.Name="Search again" />
                        <Button Style="{StaticResource SmallIcon}" Content="{StaticResource GlyphCancel}" Click="SearchClear_Click"
                                ToolTip="Clear search results" AutomationProperties.Name="Clear search results" />
                        <Button x:Name="SearchCollapseButton" Style="{StaticResource SmallIcon}" Content="{StaticResource GlyphChevronUp}" Click="SearchCollapse_Click"
                                ToolTip="Collapse all" AutomationProperties.Name="Collapse all" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="SEARCH" />
                </DockPanel>
                <Grid DockPanel.Dock="Top" Margin="4,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Replace shown or hidden, as VS Code's chevron beside the boxes. -->
                    <ToggleButton x:Name="ReplaceToggle" Grid.RowSpan="2" Style="{StaticResource ExpandToggle}" IsChecked="False" Focusable="True" VerticalAlignment="Top"
                                  Margin="0,5,0,0" Foreground="{DynamicResource TextMuted}" Click="ReplaceToggle_Click" AutomationProperties.Name="Toggle Replace"
                                  ToolTip="Toggle Replace" />
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchText" Style="{StaticResource SearchBox}" Tag="Search" AutomationProperties.Name="Search" Padding="6,3,78,3"
                                 TextChanged="SearchText_Changed" PreviewKeyDown="SearchText_KeyDown" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0">
                            <ToggleButton x:Name="MatchCase" Style="{StaticResource FindToggle}" Click="FindOption_Click" ToolTip="Match Case (Alt+C)"
                                          AutomationProperties.Name="Match Case" Content="Aa" />
                            <ToggleButton x:Name="WholeWord" Style="{StaticResource FindToggle}" Click="FindOption_Click" ToolTip="Match Whole Word (Alt+W)"
                                          AutomationProperties.Name="Match Whole Word">
                                <TextBlock Text="ab" TextDecorations="Underline" />
                            </ToggleButton>
                            <ToggleButton x:Name="UseRegex" Style="{StaticResource FindToggle}" Click="FindOption_Click" ToolTip="Use Regular Expression (Alt+R)"
                                          AutomationProperties.Name="Use Regular Expression" Content=".*" />
                        </StackPanel>
                    </Grid>
                    <!-- Replace, and Replace All beside it (Ctrl+Alt+Enter). -->
                    <DockPanel x:Name="ReplaceRow" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Visibility="Collapsed">
                        <Button x:Name="ReplaceAllButton" DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,0" MinHeight="{StaticResource SearchHeight}" Content="Replace all"
                                Click="ReplaceAll_Click" IsEnabled="False" ToolTip="Replace every match shown, in the project's files (Ctrl+Alt+Enter)" />
                        <TextBox x:Name="ReplaceText" Style="{StaticResource SearchBox}" Tag="Replace" AutomationProperties.Name="Replace"
                                 TextChanged="ReplaceText_Changed" PreviewKeyDown="SearchText_KeyDown" />
                    </DockPanel>
                    <TextBlock x:Name="SearchSummary" Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,4" />
                </Grid>
                <ListBox x:Name="SearchResults" BorderThickness="0" Background="Transparent" Margin="0,0,0,4" KeyDown="SearchResults_KeyDown"
                         ItemTemplateSelector="{StaticResource SearchTemplates}" AutomationProperties.Name="Search results"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="4,0" />
                            <Setter Property="Margin" Value="4,0" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                            <EventSetter Event="MouseLeftButtonUp" Handler="SearchItem_Click" />
                            <EventSetter Event="MouseDoubleClick" Handler="SearchItem_DoubleClick" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
            </Grid>
        </DockPanel>

        <!-- ─── The editor: a file's diff, or an operation of the history ── -->
        <Grid x:Name="EditorGrid">
            <!-- No server yet. -->
            <Border x:Name="EmptyState" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="16,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Connect a server" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Add a project's live, staging or development server (SFTP, FTPS or FTP). DNN Manager then compares it with the project like git compares with a remote: what changed here is yours to push, what changed there - someone edited the live site - yours to pull, file by file, each with its diff, never overwriting anything unseen. Every push and pull is kept, and can be rolled back." />
                    <Button HorizontalAlignment="Left" Style="{StaticResource Primary}" Content="Add server…" Click="Add_Click" />
                </StackPanel>
            </Border>

            <!-- A file. -->
            <DockPanel x:Name="FileView">
                <!-- The open files, as VS Code's tabs: the chosen one on the editor's colour with a line along its top, a preview's
                     name in italics; × closes one (a middle-click too), a double-click keeps a preview open. -->
                <Border x:Name="TabStrip" DockPanel.Dock="Top" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="0,0,0,1" Visibility="Collapsed">
                    <!-- A tab dragged to another place moves there, as in VS Code (Ctrl+Shift+PageUp / PageDown from the keyboard). -->
                    <Grid>
                    <ListBox x:Name="Tabs" Background="Transparent" BorderThickness="0" SelectionChanged="Tab_Changed" AutomationProperties.Name="Open files"
                             PreviewMouseLeftButtonDown="Tabs_PreviewMouseLeftButtonDown" PreviewMouseMove="Tabs_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="Tabs_PreviewMouseLeftButtonUp" AllowDrop="True" DragOver="Tabs_DragOver" DragLeave="Tabs_DragLeave" Drop="Tabs_Drop"
                             PreviewKeyDown="Tabs_PreviewKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Path}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
                                                <Grid>
                                                    <Border x:Name="Line" Height="1" VerticalAlignment="Top" Background="Transparent" />
                                                    <ContentPresenter Margin="10,0,4,0" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" /></Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WindowBg}" />
                                                    <Setter TargetName="Line" Property="Background" Value="{DynamicResource Accent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type p:EditorTab}">
                                <StackPanel Orientation="Horizontal" Height="34" Background="Transparent" ToolTip="{Binding Tip}" MouseDown="Tab_MouseDown">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Icon}" Foreground="{Binding IconBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" FontStyle="{Binding NameStyle}" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource Letter}" Margin="4,0,0,0" />
                                    <Button Width="22" Height="22" FontSize="10" Content="{StaticResource GlyphClose}" Click="CloseTab_Click"
                                            Tag="{Binding}" ToolTip="Close" AutomationProperties.Name="Close" Margin="2,0,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SmallIcon}">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Dragging a tab: a line where it will go when it is dropped - the tabs stay where they are till then. -->
                    <Canvas IsHitTestVisible="False">
                        <Border x:Name="TabDropLine" Width="2" Background="{DynamicResource Accent}" Visibility="Collapsed"
                                Height="{Binding ActualHeight, ElementName=Tabs}" />
                    </Canvas>
                    </Grid>
                </Border>
                <!-- Where the file is, and what happened to it - VS Code's breadcrumbs. -->
                <TextBlock x:Name="Breadcrumb" DockPanel.Dock="Top" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextSmall}"
                           Margin="12,6,12,2" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                <Border x:Name="ConflictBar" DockPanel.Dock="Top" Style="{StaticResource WarnBanner}" Margin="12,4,12,4" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ConflictText" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button Content="Keep the project's" Margin="0,0,8,0" Click="KeepLocal_Click"
                                    ToolTip="Keep the project's version - the server's change is set aside; push it to replace the server's" />
                            <Button Content="Take the server's" Margin="0,0,8,0" Click="TakeRemote_Click"
                                    ToolTip="Take the server's version - it replaces the project's, which is kept to roll back to" />
                            <Button x:Name="MergeButton" Content="Merge…" Click="Merge_Click"
                                    ToolTip="Merge - what only one side changed is merged; you edit what both changed" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <c:DiffView x:Name="Diff" />
            </DockPanel>

            <!-- An operation of the history. -->
            <DockPanel x:Name="OperationView" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="16,12,12,8">
                    <WrapPanel DockPanel.Dock="Right">
                        <Button x:Name="RollbackButton" Margin="6,0,0,0" Click="Rollback_Click"
                                ToolTip="Roll back - put every file of this operation back as it was before it">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="{StaticResource GlyphUndo}" Margin="0,0,6,0" /><TextBlock Text="Roll back…" /></StackPanel>
                        </Button>
                        <Button x:Name="RestoreButton" Margin="6,0,0,0" Click="Restore_Click" Content="Restore the version before"
                                ToolTip="Restore into the project - the chosen file as it was before this operation; push it to send it on" />
                        <Button x:Name="OpenReviewButton" Margin="6,0,0,0" Content="Open review folder" Click="OpenReview_Click" Visibility="Collapsed" />
                    </WrapPanel>
                    <StackPanel>
                        <TextBlock x:Name="OperationTitle" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" Margin="0" />
                        <TextBlock x:Name="OperationText" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
                <ListBox x:Name="OperationFiles" DockPanel.Dock="Top" MaxHeight="160" Margin="16,0,12,4" SelectionChanged="OperationFile_Changed"
                         AutomationProperties.Name="Files of the operation" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type p:OperationFileRow}">
                            <DockPanel Background="Transparent">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Letter}" />
                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextSmall}" />
                                    <Run Text="{Binding Where, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextSmall}" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <c:DiffView x:Name="HistoryDiff" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
