<UserControl x:Class="DnnManager.Presentation.Pages.ProjectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:DnnManager.Presentation.Services"
             xmlns:pages="clr-namespace:DnnManager.Presentation.Pages"
             xmlns:projects="clr-namespace:DnnManager.Presentation.Pages.Projects"
             Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{x:Null}" Background="Transparent"
             PreviewMouseLeftButtonDown="Page_PreviewMouseLeftButtonDown">
    <!-- Focusable (not a tab stop): a click outside the table puts the keyboard here, out of the table
         (Page_PreviewMouseLeftButtonDown). Transparent, not empty: a click on the empty space between its parts (the
         toolbar's, the title's) has to reach it - without a background it would hit nothing. -->
    <UserControl.Resources>
        <!-- "Live" green, "Offline" red, anything else ("(none)") in the normal colour. -->
        <Style x:Key="SqlText" TargetType="TextBlock">
            <Setter Property="ToolTip" Value="{Binding SqlTip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Sql}" Value="Live">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Sql}" Value="Offline">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The database from web.config - "not set" in amber when it names none, why in the tooltip. -->
        <Style x:Key="DatabaseText" TargetType="TextBlock">
            <Setter Property="ToolTip" Value="{Binding DatabaseTip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasDatabaseProblem}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource LogWarn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTransitioning}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource LogWarn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Numeric" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>

        <!-- Running: a green dot. Stopped: a hollow ring. Changing: amber, pulsing. No IIS site: a faint dash. -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Stroke" Value="{DynamicResource TextMuted}" />
            <Setter Property="Fill" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Stroke" Value="{DynamicResource SuccessText}" />
                    <Setter Property="Fill" Value="{DynamicResource SuccessText}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsTransitioning}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource LogWarn}" />
                    <Setter Property="Fill" Value="{DynamicResource LogWarn}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- The pulse - only while it can be seen: while it runs WPF draws about 60 frames a second. Not while
                     the window is minimized (EfficiencyMode), and not on a dot that isn't on screen - the page not shown,
                     or a row the table has let go of (bound to its site until it is garbage collected, it would pulse
                     unseen). Shown again, a site still changing pulses again. One binding (EfficiencyMode.WhileSeen),
                     not a MultiDataTrigger: that starts the storyboard once per condition, and each copy it replaces
                     goes on ticking until it is garbage collected. -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{x:Static s:EfficiencyMode.WhileSeen}">
                            <Binding Path="IsTransitioning" />
                            <Binding Path="IsVisible" RelativeSource="{RelativeSource Self}" />
                            <Binding Path="(s:EfficiencyMode.IsSaving)" RelativeSource="{RelativeSource Self}" />
                            <Binding Path="(s:Motion.Off)" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Pulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.6" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Pulse" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A row's progress bar: moving only while it is shown - and not while the window is minimized
             (EfficiencyMode), where its animation would keep WPF drawing frames nobody sees. -->
        <Style x:Key="RowProgress" TargetType="ProgressBar">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ShowProgress}" Value="True" />
                        <Condition Binding="{Binding (s:EfficiencyMode.IsSaving), RelativeSource={RelativeSource Self}}" Value="False" />
                        <Condition Binding="{Binding (s:Motion.Off), RelativeSource={RelativeSource Self}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsIndeterminate" Value="True" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A checked row is highlighted like a selected one. (Its details are opened from code - the grid overrides
             a DetailsVisibility set by a style.) -->
        <Style x:Key="ProjectRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBg}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The check box, chevron and status dot: no cell padding, their columns are just wide enough. -->
        <Style x:Key="IconCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Every Actions cell and its header move left by as much as the table is scrolled short of its right end, so
             Actions stays at the right edge while the other columns scroll under it: the page's ActionsShift, set in
             code. (Bound, not a resource: a style would freeze it.) -->
        <Style x:Key="ActionsCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="RenderTransform" Value="{Binding ActionsShift, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <!-- Opaque, in the row's colour (checked, hover), so the columns scrolling under it don't show through. -->
            <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1,0,0,0" Padding="10,0,8,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionsHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="RenderTransform" Value="{Binding ActionsShift, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Padding" Value="11,6,8,6" />
        </Style>

        <!-- A row's buttons aren't tab stops: the row has keys of its own (Enter, Del, F5, Shift+F5, Ctrl+Shift+R, the arrows,
             Space) and everything is on its menu (Shift+F10) and in the command palette - a Tab per button would make the
             table a long way through. LinkFg: 3:1 for the icon on a selected row too (WCAG 1.4.11). -->
        <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{DynamicResource LinkFg}" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <!-- One of the bulk actions: an icon in the group's frame (its name and what it will do are in its tooltip,
             also while it can't be pressed). -->
        <Style x:Key="GroupButton" TargetType="Button">
            <!-- An icon says nothing to a screen reader: it reads the tooltip. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- Reached with Tab, pressed with Enter or Space; the focus ring shows which one has the keyboard. -->
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GroupDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="2,4" />
            <Setter Property="Background" Value="{DynamicResource InputBorder}" />
        </Style>
    </UserControl.Resources>

    <Grid>
    <!-- The table; while a site is open, its overview (ProjectView) takes the page instead - the table keeps its state. -->
    <DockPanel x:Name="TableView" Margin="28,24,28,12">
        <!-- Title. The table keeps itself up to date (ServerStore), so there is nothing to press and, while that works,
             nothing to say: top right only shows when it doesn't - "Reconnecting…", with the reason in its tooltip. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel x:Name="LiveIndicator" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                        Margin="0,10,2,0" Background="Transparent" ToolTip="Reconnecting" ToolTipService.ShowDuration="30000"
                        ToolTipOpening="LiveIndicator_ToolTipOpening" Visibility="Collapsed">
                <Ellipse x:Name="LiveDot" Width="8" Height="8" StrokeThickness="1.5" VerticalAlignment="Center" />
                <TextBlock x:Name="LiveText" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextCaption}" Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Projects" />
                <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"
                           Text="Every DNN website in IIS - its state, bindings, DNN install and database." />
            </StackPanel>
        </DockPanel>

        <!-- Search, columns and "only running" on the left; the bulk actions on the right, only while rows are checked. -->
        <DockPanel x:Name="Toolbar" DockPanel.Dock="Top" Margin="0,0,0,10">
            <!-- For the checked rows: one group of icons in the order of a row's Actions - Start, Stop, Restart and keep warm,
                 then Remove on the right. -->
            <Border x:Name="BulkActions" DockPanel.Dock="Right" Visibility="Collapsed" VerticalAlignment="Center" Padding="2" CornerRadius="5"
                    Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BulkStartButton" AutomationProperties.Name="Start the selected websites" Style="{StaticResource GroupButton}" Content="{StaticResource GlyphPlay}" Click="BulkStart_Click" />
                    <Button x:Name="BulkStopButton" AutomationProperties.Name="Stop the selected websites" Style="{StaticResource GroupButton}" Content="{StaticResource GlyphStop}" Click="BulkStop_Click" />
                    <Button x:Name="BulkRestartButton" AutomationProperties.Name="Restart the selected websites" Style="{StaticResource GroupButton}" Content="{StaticResource GlyphRefresh}" Click="BulkRestart_Click" />
                    <!-- The flame, as in the rows: outlined - keep them warm; filled - they all are, stop it (UpdateSelection). -->
                    <Button x:Name="BulkKeepWarmButton" AutomationProperties.Name="Keep the selected websites warm" Style="{StaticResource GroupButton}" Click="BulkKeepWarm_Click">
                        <Path x:Name="BulkKeepWarmIcon" Data="{StaticResource FlameOutline}" Fill="{DynamicResource TextPrimary}"
                              Stretch="Uniform" Width="14" Height="14" />
                    </Button>
                    <Border Style="{StaticResource GroupDivider}" />
                    <Button x:Name="BulkRemoveButton" AutomationProperties.Name="Remove the selected websites" Style="{StaticResource GroupButton}" Content="{StaticResource GlyphDelete}"
                            Foreground="{DynamicResource ErrorText}" Click="BulkRemove_Click" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="Search projects" AutomationProperties.Name="Search projects" Width="280"
                         TextChanged="Search_TextChanged" PreviewKeyDown="Search_PreviewKeyDown"
                         ToolTip="Search projects"
                         s:CommandTip.Command="projects.search" />
                <ToggleButton AutomationProperties.Name="Choose which columns the list shows" x:Name="ColumnsButton" Style="{StaticResource IconToggleButton}" Focusable="True" Margin="8,0,0,0" ToolTip="Choose which columns the list shows"
                              IsChecked="{Binding IsOpen, ElementName=ColumnsPopup, Mode=TwoWay}">
                    <!-- Three columns, like a table header. -->
                    <Path Style="{StaticResource IconStroke}" Data="{StaticResource Columns}" StrokeThickness="1.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                </ToggleButton>
                <!-- While open, the button ignores the mouse, so clicking it closes the menu instead of reopening it. -->
                <Popup x:Name="ColumnsPopup" PlacementTarget="{Binding ElementName=ColumnsButton}" Placement="Bottom"
                       VerticalOffset="4" StaysOpen="False" AllowsTransparency="True"
                       PopupAnimation="{Binding (s:Motion.Off), RelativeSource={RelativeSource Self}, Converter={x:Static s:Motion.PopupFade}}"
                       Opened="ColumnsPopup_Opened" Closed="ColumnsPopup_Closed">
                    <Grid Margin="0,0,8,8" MinWidth="220" LayoutTransform="{DynamicResource UiScale}">
                    <!-- The shadow a layer of its own: an effect on the menu would draw its text as a bitmap, without ClearType. -->
                    <Border Background="{DynamicResource CardBg}" CornerRadius="6" IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                        </Border.Effect>
                    </Border>
                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            CornerRadius="6" Padding="14,10">
                        <StackPanel>
                            <ItemsControl x:Name="ColumnList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" Content="{Binding Header}" Margin="0,4"
                                                  IsChecked="{Binding IsVisible, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Show all" Click="ShowAllColumns_Click"
                                        ToolTip="Show all" />
                                <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Content="Hide all" Click="HideAllColumns_Click"
                                        ToolTip="Hide all" />
                                <Button Style="{StaticResource LinkButton}" Content="Default" HorizontalAlignment="Center" Click="DefaultColumns_Click"
                                        ToolTip="Default columns" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    </Grid>
                </Popup>
                <!-- Only the projects whose site runs - a row comes and goes as its site starts and stops. -->
                <CheckBox x:Name="OnlyRunning" Style="{StaticResource ToggleSwitch}" Content="Only show running" Margin="14,0,0,0"
                          VerticalAlignment="Center" Click="OnlyRunning_Click" ToolTip="Hide the websites that are stopped" />
            </StackPanel>
        </DockPanel>

        <!-- How many rows there are, are shown and are checked. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="2,8,2,0">
            <TextBlock x:Name="SelectedText" DockPanel.Dock="Right" Foreground="{DynamicResource TextPrimary}" />
            <TextBlock x:Name="CountText" Foreground="{DynamicResource TextMuted}" />
        </DockPanel>

        <Grid>
            <!-- Rounded, like the cards; the table's own square border off - its rows are clipped to the corners
                 (Grid_SizeChanged). -->
            <Border CornerRadius="{StaticResource CardRadius}" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}"
                    Background="{DynamicResource CardBg}">
                <!-- The check box, chevron, status and name stay put while the rest scrolls sideways (scrollbar or
                     Shift + wheel). A filler column takes the room left over, so Actions sits at the right edge.
                     Only the rows on screen are made, and a row that scrolls out (or a search hides) is reused for the
                     next one: filtering and sorting don't build every row again. Scrolled by pixels, not by rows. -->
                <projects:ProjectsTable x:Name="ProjectsGrid" Style="{StaticResource {x:Type DataGrid}}" FrozenColumnCount="4" RowHeight="38" RowStyle="{StaticResource ProjectRowStyle}"
                          BorderThickness="0" Background="Transparent" SizeChanged="Grid_SizeChanged"
                          IsKeyboardFocusWithinChanged="Grid_IsKeyboardFocusWithinChanged"
                          RowDetailsVisibilityMode="Collapsed" AreRowDetailsFrozen="True" HeadersVisibility="Column"
                          LoadingRow="Grid_LoadingRow" LayoutUpdated="Grid_LayoutUpdated" ScrollViewer.ScrollChanged="Grid_ScrollChanged" Sorting="Grid_Sorting"
                          MouseDoubleClick="Grid_MouseDoubleClick" PreviewKeyDown="Grid_PreviewKeyDown"
                          PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                          KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Projects"
                          PreviewMouseWheel="Grid_PreviewMouseWheel" PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                          ContextMenuOpening="Grid_ContextMenuOpening"
                          ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                          EnableRowVirtualization="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.PanningMode="Both">
                    <projects:ProjectsTable.ContextMenu>
                        <!-- Filled in Grid_ContextMenuOpening (Pages/Projects/ProjectMenu). -->
                        <ContextMenu />
                    </projects:ProjectsTable.ContextMenu>
                    <projects:ProjectsTable.Columns>
                        <!-- Header: the select-all check box, made in code. -->
                        <DataGridTemplateColumn x:Name="SelectColumn" Width="40" MinWidth="40" CanUserResize="False" CanUserSort="False"
                                                CellStyle="{StaticResource IconCell}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource TableCheckBox}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="32" MinWidth="32" CanUserResize="False" CanUserSort="False" CellStyle="{StaticResource IconCell}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton AutomationProperties.Name="Show a few facts under the row" Style="{StaticResource ExpandToggle}" ToolTip="Show a few facts under the row"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="24" MinWidth="24" CanUserResize="False" SortMemberPath="State" CellStyle="{StaticResource IconCell}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" ToolTip="{Binding StateText}">
                                        <Ellipse Style="{StaticResource StatusDot}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- The site's name opens its overview (so does a double-click on the row, or Enter). -->
                        <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="Auto" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button AutomationProperties.Name="Show everything about this website" Style="{StaticResource LinkButton}" Content="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Left"
                                            VerticalAlignment="Center" Focusable="False" Click="RowOpen_Click" ToolTip="Show everything about this website" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- The optional columns, the ones most looked at first - the order of the Columns menu too
                             (ProjectColumns.All). -->
                        <!-- The address opens the site in the browser; "-" for a site without a web binding. -->
                        <DataGridTemplateColumn x:Name="UrlColumn" Header="Site" SortMemberPath="Url" Width="Auto" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Button AutomationProperties.Name="Open the website in your browser" Style="{StaticResource LinkButton}" Content="{Binding Url}" HorizontalAlignment="Left" Focusable="False"
                                                Click="OpenSite_Click" ToolTip="Open the website in your browser" s:CommandTip.Command="project.openWebsite"
                                                Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Url}" Foreground="{DynamicResource TextMuted}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasUrl}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="DnnColumn" Header="DNN" Binding="{Binding Dnn}" Width="Auto" MinWidth="70" />
                        <DataGridTextColumn x:Name="DatabaseColumn" Header="Database" Binding="{Binding Database}" Width="Auto" MinWidth="120"
                                            ElementStyle="{StaticResource DatabaseText}" />
                        <!-- Live (green) / Offline (red) / (none) - asked with the site's web.config connection, see ProjectRow.Sql. -->
                        <DataGridTextColumn x:Name="SqlColumn" Header="SQL" Binding="{Binding Sql}" Width="Auto" MinWidth="64"
                                            ElementStyle="{StaticResource SqlText}" />
                        <DataGridTextColumn x:Name="CpuColumn" Header="CPU (%)" Binding="{Binding CpuText}" SortMemberPath="CpuSort" Width="Auto" MinWidth="70"
                                            ElementStyle="{StaticResource Numeric}" />
                        <DataGridTextColumn x:Name="MemoryColumn" Header="Memory" Binding="{Binding MemoryText}" SortMemberPath="MemorySort" Width="Auto" MinWidth="84"
                                            ElementStyle="{StaticResource Numeric}" />
                        <DataGridTextColumn x:Name="PidColumn" Header="PID" Binding="{Binding PidText}" Width="Auto" MinWidth="60" />
                        <DataGridTemplateColumn x:Name="LastStartedColumn" Header="Last started" SortMemberPath="LastStartedSort" Width="Auto" MinWidth="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastStartedText}" ToolTip="{Binding LastStartedTip}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="StatusColumn" Header="Status" Binding="{Binding StateText}" SortMemberPath="State" Width="Auto" MinWidth="90"
                                            ElementStyle="{StaticResource StateText}" />
                        <DataGridTextColumn x:Name="PortsColumn" Header="Port(s)" Binding="{Binding PortsText}" Width="Auto" MinWidth="70" />
                        <DataGridTextColumn x:Name="IdColumn" Header="Site ID" Binding="{Binding IdText}" SortMemberPath="IdSort" Width="Auto" MinWidth="64"
                                            ElementStyle="{StaticResource Muted}" />
                        <DataGridTextColumn x:Name="SizeColumn" Header="Size" Binding="{Binding Size}" SortMemberPath="SizeBytes" Width="Auto" MinWidth="80"
                                            ElementStyle="{StaticResource Numeric}" />
                        <DataGridTextColumn x:Name="MemoryPercentColumn" Header="Memory (%)" Binding="{Binding MemoryPercentText}" SortMemberPath="MemorySort"
                                            Width="Auto" MinWidth="84" ElementStyle="{StaticResource Numeric}" />
                        <!-- What the worker process read / wrote since it started, and what the site received / sent over HTTP
                             since IIS started. -->
                        <DataGridTextColumn x:Name="DiskColumn" Header="Disk read/write" Binding="{Binding DiskText}" SortMemberPath="DiskSort"
                                            Width="Auto" MinWidth="130" ElementStyle="{StaticResource Numeric}" />
                        <DataGridTextColumn x:Name="NetworkColumn" Header="Network I/O" Binding="{Binding NetworkText}" SortMemberPath="NetworkSort"
                                            Width="Auto" MinWidth="130" ElementStyle="{StaticResource Numeric}" />
                        <!-- The folder opens in Explorer. -->
                        <DataGridTemplateColumn x:Name="PathColumn" Header="Path" SortMemberPath="Path" Width="Auto" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button AutomationProperties.Name="Open the website's files in File Explorer" Style="{StaticResource LinkButton}" Content="{Binding Path}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Focusable="False" Click="OpenFolder_Click" ToolTip="Open the website's files in File Explorer" s:CommandTip.Command="project.openFolder" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Sized in code (FitFiller): a star width would make the grid squeeze the other columns instead of scrolling. -->
                        <DataGridTemplateColumn x:Name="FillerColumn" Width="0" MinWidth="0" CanUserResize="False" CanUserSort="False" />
                        <!-- Running: Stop and Restart. Stopped: Start. Changing: a progress bar. Always: keep warm (the flame) and Remove
                             (the rest is on the right-click menu). Stays at the right edge while the table scrolls sideways (ActionsShift). -->
                        <DataGridTemplateColumn Header="Actions" Width="Auto" MinWidth="120" CanUserResize="False" CanUserSort="False"
                                                CellStyle="{StaticResource ActionsCell}" HeaderStyle="{StaticResource ActionsHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="56">
                                            <StackPanel Orientation="Horizontal">
                                                <Button AutomationProperties.Name="Start" Style="{StaticResource RowAction}" Content="{StaticResource GlyphPlay}" ToolTip="Start - turn the website on so it can be opened" s:CommandTip.Command="project.start" Click="RowStart_Click"
                                                        IsEnabled="{Binding CanStart}" Visibility="{Binding ShowStart, Converter={StaticResource BoolToVis}}" />
                                                <Button AutomationProperties.Name="Stop" Style="{StaticResource RowAction}" Content="{StaticResource GlyphStop}" ToolTip="Stop - turn the website off until you start it again; nothing is deleted" s:CommandTip.Command="project.stop" Click="RowStop_Click"
                                                        IsEnabled="{Binding CanStop}" Visibility="{Binding ShowStop, Converter={StaticResource BoolToVis}}" />
                                                <Button AutomationProperties.Name="Restart the website's background process" Style="{StaticResource RowAction}" Content="{StaticResource GlyphRefresh}" ToolTip="Restart the website's background process - can fix problems; it is unavailable for a few seconds" s:CommandTip.Command="project.restart" Click="RowRestart_Click"
                                                        IsEnabled="{Binding CanRestart}" Visibility="{Binding ShowStop, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <!-- Only moving while it is shown (RowProgress): hidden, its animation would run on for nothing. -->
                                            <ProgressBar Style="{StaticResource RowProgress}" Height="3" Margin="4,0" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource Accent}" Background="{DynamicResource GridLine}" BorderThickness="0"
                                                         ToolTip="{Binding StateText}" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                        <!-- Keep warm: the flame switches it; its look and tooltip say how it is going (ProjectRow.KeepWarmLook),
                                             its name what pressing it does - "Keep warm" or "Stop keeping warm". -->
                                        <Button Style="{StaticResource RowAction}" AutomationProperties.Name="{Binding KeepWarmAction}" Click="RowKeepWarm_Click" IsEnabled="{Binding CanToggleKeepWarm}"
                                                ToolTip="{Binding KeepWarmTip}" ToolTipService.ShowOnDisabled="True">
                                            <ContentControl Style="{StaticResource KeepWarmFlame}" />
                                        </Button>

                                        <Border Width="1" Height="18" Margin="8,0" Background="{DynamicResource CardBorder}" />
                                        <Button Style="{StaticResource IconButton}" Content="{StaticResource GlyphDelete}" Foreground="{DynamicResource ErrorText}" Focusable="False"
                                                ToolTip="Remove - delete the website, its folder and its database from this computer; asks first (Del)" Click="RowRemove_Click" IsEnabled="{Binding CanRemove}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </projects:ProjectsTable.Columns>

                    <projects:ProjectsTable.RowDetailsTemplate>
                        <DataTemplate>
                            <!-- As wide as the visible table, so the facts wrap instead of widening what scrolls
                                 (DetailsWidth). -->
                            <Border Padding="20,4,16,12" BorderBrush="{DynamicResource GridLine}" BorderThickness="0,1,0,0" HorizontalAlignment="Left"
                                    Width="{Binding Path=(pages:ProjectsPage.DetailsWidth)}">
                                <ItemsControl ItemsSource="{Binding Details}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="250" Margin="0,8,16,0">
                                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextHint}" />
                                                <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Value}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </DataTemplate>
                    </projects:ProjectsTable.RowDetailsTemplate>
                </projects:ProjectsTable>
            </Border>
            <!-- Only shown while the table is empty (the first snapshot, no projects, or no match) - never over rows. -->
            <Border x:Name="Overlay" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,10" CornerRadius="6"
                    Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Visibility="Collapsed">
                <TextBlock x:Name="OverlayText" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TextMedium}" TextWrapping="Wrap" MaxWidth="520" />
            </Border>
        </Grid>
    </DockPanel>
    <ContentControl x:Name="ProjectHost" Focusable="False" Visibility="Collapsed" />
    </Grid>
</UserControl>
