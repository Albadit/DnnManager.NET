<UserControl x:Class="DnnManager.Presentation.Pages.ProjectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Status cells: "Live" green, "Offline" red, anything else ("(none)") in the normal colour. -->
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Sql}" Value="Live">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessText}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Sql}" Value="Offline">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorText}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IisStatusText" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Iis}" Value="Live">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessText}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Iis}" Value="Offline">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorText}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="28,24,28,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource PageTitle}" Text="Projects" />
            <TextBlock Style="{StaticResource PageSubtitle}" x:Name="Subtitle" Text="Every project folder, its IIS site and its database." />
        </StackPanel>

        <!-- Actions on the selected project on the left, Refresh on the right - lined up with the table's edges. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="Refresh" MinWidth="104" Click="Refresh_Click" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="OpenSiteButton"   Content="Open site"   Style="{StaticResource Primary}" Click="OpenSite_Click" IsEnabled="False" />
                <Button x:Name="RemoveButton"     Content="Remove…"     Margin="8,0,0,0" Style="{StaticResource Danger}" Click="Remove_Click" IsEnabled="False" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <!-- Pixel (not row-by-row) scrolling; the list is small enough that virtualization isn't needed. -->
            <!-- Columns size to their content (nothing cut off); a wider table scrolls sideways - scrollbar or Shift + wheel. -->
            <DataGrid x:Name="ProjectsGrid" SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick"
                      PreviewMouseWheel="Grid_PreviewMouseWheel" PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                      ContextMenuOpening="Grid_ContextMenuOpening"
                      ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.PanningMode="Both">
                <DataGrid.ContextMenu>
                    <!-- Filled in Grid_ContextMenuOpening: the IDE entries depend on what is installed. -->
                    <ContextMenu />
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"     Binding="{Binding Name}" FontWeight="SemiBold" Width="Auto" MinWidth="140" />
                    <DataGridTextColumn Header="Site"     Binding="{Binding Url}" Width="Auto" MinWidth="180" />
                    <DataGridTextColumn Header="DNN"      Binding="{Binding Dnn}" Width="Auto" MinWidth="70" />
                    <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="Auto" MinWidth="150" />
                    <!-- Live (green) / Offline (red) / (none) - see Row.SqlState and Row.IisState. -->
                    <DataGridTextColumn Header="SQL"      Binding="{Binding Sql}" Width="Auto" MinWidth="70"
                                        ElementStyle="{StaticResource StatusText}" />
                    <DataGridTextColumn Header="IIS"      Binding="{Binding Iis}" Width="Auto" MinWidth="70"
                                        ElementStyle="{StaticResource IisStatusText}" />
                    <DataGridTextColumn Header="Size"     Binding="{Binding Size}" Width="Auto" MinWidth="80" />
                    <DataGridTextColumn Header="Path"     Binding="{Binding Path}" Width="Auto" MinWidth="200" />
                </DataGrid.Columns>
            </DataGrid>
            <!-- Runs along the top edge of the table while the list is (re)loading. -->
            <ProgressBar x:Name="LoadingBar" VerticalAlignment="Top" Height="3" Margin="1,1,1,0" IsIndeterminate="True"
                         Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0" Visibility="Collapsed" />
            <!-- Only shown while the table is empty (first load, no projects, or an error). -->
            <Border x:Name="Overlay" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,10" CornerRadius="6"
                    Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Visibility="Collapsed">
                <TextBlock x:Name="OverlayText" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextWrapping="Wrap" MaxWidth="520" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
