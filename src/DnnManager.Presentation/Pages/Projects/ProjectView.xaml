<UserControl x:Class="DnnManager.Presentation.Pages.Projects.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:DnnManager.Presentation.Pages.Projects"
             xmlns:s="clr-namespace:DnnManager.Presentation.Services"
             xmlns:c="clr-namespace:DnnManager.Presentation.Controls">
    <!-- One IIS site, in tabs - what was detected about it, as an environment inspector: General (the project, its health,
         this PC), IIS (site, bindings, app pool, worker processes, keep warm), DNN (installation, portals, extensions,
         configuration, host accounts), Database (connection, SQL Server, database, DNN's tables, health) and Advanced
         (configuration, limits, filesystem, assemblies, every detected issue). DataContext: the table's ProjectRow. -->
    <UserControl.Resources>
        <!-- Running: a green dot. Stopped: a hollow ring. Changing: amber. -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Stroke" Value="{DynamicResource TextMuted}" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Stroke" Value="{DynamicResource SuccessText}" />
                    <Setter Property="Fill" Value="{DynamicResource SuccessText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTransitioning}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource LogWarn}" />
                    <Setter Property="Fill" Value="{DynamicResource LogWarn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A tab's Edit buttons (one operation at a time: ProjectEdits does nothing while another runs). -->
        <Style x:Key="EditButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <!-- A tab of the overview: its name, underlined while shown. -->
        <Style x:Key="SectionTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" Padding="2,6,2,8" Margin="0,0,22,0" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A label and its value (selectable), or a section heading - the keep-warm and host-account cards. The label
             column is as wide as the inspector's cards around them (Inspector.cs), so the values line up. -->
        <DataTemplate x:Key="FactTemplate" DataType="{x:Type p:ProjectFact}">
            <Grid x:Name="Row" Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Label" Text="{Binding Label}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,12,0" />
                <!-- Read-only text box so a value (a path, a database name…) can be selected and copied. -->
                <TextBox x:Name="Value" Grid.Column="2" AutomationProperties.Name="{Binding Label}" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0" VerticalContentAlignment="Top" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static p:FactKind.Section}">
                    <Setter TargetName="Row" Property="Margin" Value="0,12,0,4" />
                    <Setter TargetName="Label" Property="Grid.ColumnSpan" Value="3" />
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                    <Setter TargetName="Value" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static p:FactKind.Good}">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource SuccessText}" />
                    <Setter TargetName="Value" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static p:FactKind.Bad}">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource ErrorText}" />
                    <Setter TargetName="Value" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static p:FactKind.Warning}">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource LogWarn}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- Moving while the site's operation runs - not while the window is minimized (EfficiencyMode), where its
             animation would keep WPF drawing frames nobody sees. -->
        <Style x:Key="SiteProgress" TargetType="ProgressBar">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ShowProgress}" Value="True" />
                        <Condition Binding="{Binding (s:EfficiencyMode.IsSaving), RelativeSource={RelativeSource Self}}" Value="False" />
                        <Condition Binding="{Binding (s:Motion.Off), RelativeSource={RelativeSource Self}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsIndeterminate" Value="True" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Centred: as wide as there is room, up to 1100 - its header and tabs as wide as what they are for. -->
    <DockPanel Margin="28,20,28,12" MaxWidth="1100">
        <!-- Back, the site's name and state; its actions on the right. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="{StaticResource GlyphBack}" Width="32" Height="32" Margin="0,2,10,0"
                    VerticalAlignment="Top" ToolTip="Back (Esc)" Click="Back_Click" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                <Button AutomationProperties.Name="Start" Style="{StaticResource HeaderButton}" Click="Start_Click" IsEnabled="{Binding CanStart}"
                        ToolTip="Start - turn the website on so it can be opened" s:CommandTip.Command="project.start"
                        Visibility="{Binding ShowStart, Converter={StaticResource Visible}}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="{StaticResource GlyphPlay}" /><TextBlock Text="Start" /></StackPanel>
                </Button>
                <Button AutomationProperties.Name="Stop" Style="{StaticResource HeaderButton}" Click="Stop_Click" IsEnabled="{Binding CanStop}"
                        ToolTip="Stop - turn the website off until you start it again; nothing is deleted" s:CommandTip.Command="project.stop"
                        Visibility="{Binding ShowStop, Converter={StaticResource Visible}}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="{StaticResource GlyphStop}" /><TextBlock Text="Stop" /></StackPanel>
                </Button>
                <Button AutomationProperties.Name="Restart the website's background process" Style="{StaticResource HeaderButton}" Click="Restart_Click" IsEnabled="{Binding CanRestart}"
                        Visibility="{Binding ShowStop, Converter={StaticResource Visible}}" ToolTip="Restart the website's background process - can fix problems; it is unavailable for a few seconds"
                        s:CommandTip.Command="project.restart">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="{StaticResource GlyphRefresh}" /><TextBlock Text="Restart" /></StackPanel>
                </Button>
                <Button AutomationProperties.Name="Open the website in your browser" Style="{StaticResource HeaderButton}" Click="OpenSite_Click" IsEnabled="{Binding HasUrl}"
                        ToolTip="Open the website in your browser" s:CommandTip.Command="project.openWebsite">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="{StaticResource GlyphGlobe}" /><TextBlock Text="Open site" /></StackPanel>
                </Button>
                <Button AutomationProperties.Name="Open the website's files in File Explorer" Style="{StaticResource HeaderButton}" Click="OpenFolder_Click" ToolTip="Open the website's files in File Explorer"
                        s:CommandTip.Command="project.openFolder">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="{StaticResource GlyphFolderOpen}" /><TextBlock Text="Open folder" /></StackPanel>
                </Button>
                <Button AutomationProperties.Name="More actions" x:Name="MoreButton" Style="{StaticResource HeaderButton}" Click="More_Click" ToolTip="More actions: logs, clear cache, export, backups, upgrade">
                    <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource GlyphMore}" Margin="0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="90" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Ellipse Style="{StaticResource StatusDot}" />
                    <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="·" Foreground="{DynamicResource TextMuted}" Margin="8,0" VerticalAlignment="Center"
                               Visibility="{Binding HasUrl, Converter={StaticResource Visible}}" />
                    <Button AutomationProperties.Name="Open site" Style="{StaticResource LinkButton}" Content="{Binding Url}" Tag="{Binding Url}" Click="Link_Click" VerticalAlignment="Center"
                            ToolTip="Open site" s:CommandTip.Command="project.openWebsite"
                            Visibility="{Binding HasUrl, Converter={StaticResource Visible}}" />
                    <ProgressBar Style="{StaticResource SiteProgress}" Width="60" Height="3" Margin="12,0,0,0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource GridLine}" BorderThickness="0"
                                 Visibility="{Binding ShowProgress, Converter={StaticResource Visible}}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- The tabs. -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="GeneralTab" Style="{StaticResource SectionTab}" GroupName="Sections" Content="General" IsChecked="True" Checked="Section_Checked" />
                <RadioButton x:Name="IisTab" Style="{StaticResource SectionTab}" GroupName="Sections" Content="IIS" Checked="Section_Checked" />
                <RadioButton x:Name="DnnTab" Style="{StaticResource SectionTab}" GroupName="Sections" Content="DNN" Checked="Section_Checked" />
                <RadioButton x:Name="DatabaseTab" Style="{StaticResource SectionTab}" GroupName="Sections" Content="Database" Checked="Section_Checked" />
                <RadioButton x:Name="AdvancedTab" Style="{StaticResource SectionTab}" GroupName="Sections" Content="Advanced" Checked="Section_Checked" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1100" />
                </Grid.ColumnDefinitions>
                <!-- What was detected about the site, tab by tab (ProjectDiagnostics) - an environment inspector. -->
                <!-- Each tab's changes start with its Edit buttons (ProjectEdits) - the facts below show what they changed. -->
                <StackPanel x:Name="GeneralSection">
                    <WrapPanel Margin="0,0,0,12">
                        <Button Style="{StaticResource EditButton}" Content="Rename…" Click="Rename_Click" ToolTip="Rename the project: its folder, IIS site and app pool - and its host name and database if you like"
                                s:CommandTip.Command="project.rename" />
                    </WrapPanel>
                    <p:InspectorPanel x:Name="GeneralPanel" />
                </StackPanel>

                <StackPanel x:Name="IisSection" Visibility="Collapsed">
                    <WrapPanel Margin="0,0,0,12">
                        <Button Style="{StaticResource EditButton}" Content="Edit host names…" Click="EditBindings_Click"
                                ToolTip="The host names and ports the site answers on - DNN's portal aliases follow" s:CommandTip.Command="project.editBindings" />
                        <Button Style="{StaticResource EditButton}" Content="Edit app pool…" Click="EditAppPool_Click"
                                ToolTip=".NET CLR version, pipeline, 32-bit, identity, idle time-out, start mode" s:CommandTip.Command="project.editAppPool" />
                    </WrapPanel>
                    <p:InspectorPanel x:Name="IisPanel" />
                    <!-- Keep warm: switched here too; how it is going and how it is done. -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox x:Name="KeepWarmSwitch" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top"
                                          IsChecked="{Binding KeepWarmOn, Mode=OneWay}" IsEnabled="{Binding CanToggleKeepWarm}"
                                          ToolTip="{Binding KeepWarmTip}" ToolTipService.ShowOnDisabled="True" Click="KeepWarmSwitch_Click" />
                                <TextBlock Style="{StaticResource CardTitle}" Text="Keep warm" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="While DNN Manager runs - minimized too - it requests the site before IIS would shut it down for being idle, and warms it up again after a recycle, so its next page opens at once instead of after DNN starting up (3 to 10 seconds). No browser: a small request DNN answers in milliseconds, none while the site is in use." />
                            <DockPanel>
                                <Button x:Name="KeepWarmCheckButton" DockPanel.Dock="Right" Content="Check now" Margin="12,0,0,0" VerticalAlignment="Center"
                                        IsEnabled="{Binding KeepWarmOn}" Click="KeepWarmCheck_Click"
                                        ToolTip="Check now" />
                                <ContentControl Style="{StaticResource KeepWarmFlame}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding KeepWarmText}" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl x:Name="KeepWarmFacts" ItemTemplate="{StaticResource FactTemplate}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DnnSection" Visibility="Collapsed">
                    <WrapPanel Margin="0,0,0,12" Visibility="{Binding IsDnn, Converter={StaticResource Visible}}">
                        <Button Style="{StaticResource EditButton}" Content="Upgrade DNN…" Click="UpgradeDnn_Click"
                                ToolTip="To a newer DNN, with a backup before each step"
                                s:CommandTip.Command="project.upgradeDnn" />
                    </WrapPanel>
                    <p:InspectorPanel x:Name="DnnPanel" />
                    <!-- The host accounts in the database - and changing their password, which only happens here. -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding IsDnn, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Host accounts" />
                            <ItemsControl x:Name="HostFacts" ItemTemplate="{StaticResource FactTemplate}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="ChangePasswordButton" Content="Change host password…" IsEnabled="False" Click="ChangePassword_Click"
                                        ToolTip="Change host password" />
                            </StackPanel>
                            <TextBlock x:Name="PasswordHint" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DatabaseSection" Visibility="Collapsed">
                    <WrapPanel Margin="0,0,0,12">
                        <Button Style="{StaticResource EditButton}" Content="Change connection…" Click="ChangeDatabase_Click"
                                ToolTip="Point web.config at another server, database or sign-in" s:CommandTip.Command="project.editDatabase" />
                    </WrapPanel>
                    <p:InspectorPanel x:Name="DatabasePanel" />
                </StackPanel>

                <StackPanel x:Name="AdvancedSection" Visibility="Collapsed">
                    <p:InspectorPanel x:Name="AdvancedPanel" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>