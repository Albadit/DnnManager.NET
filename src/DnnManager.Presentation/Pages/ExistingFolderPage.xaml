<UserControl x:Class="DnnManager.Presentation.Pages.ExistingFolderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DnnManager.Presentation.Controls">
    <!-- Centred: as wide as there is room, up to the folder list and the 640 of the options beside it. -->
    <DockPanel Margin="28,24,28,20" MaxWidth="960">
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource PageTitle}" Text="Host project" />
                <!-- Explains what setting up the website does to HTTPS redirect rules in web.config. -->
                <TextBlock Text="{StaticResource GlyphInfo}" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="10,4,0,0"
                           Cursor="Help" Background="Transparent" ToolTipService.InitialShowDelay="200"
                           ToolTipService.ShowDuration="60000">
                    <TextBlock.ToolTip>
                        <StackPanel MaxWidth="440">
                            <TextBlock Text="HTTPS redirects in web.config" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Setting up the IIS website also checks web.config for URL Rewrite rules that redirect every request to https:// - common on a production site. The local site has no HTTPS, so such a rule would make it unreachable." />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Those rules are switched off (enabled=&quot;false&quot;), not deleted, with a &quot;Disabled by DNN Manager&quot; comment above each one in web.config." />
                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource LogWarn}"
                                       Text="&#x26A0; The Output tab then warns you: switch them back on before deploying the site to production." />
                        </StackPanel>
                    </TextBlock.ToolTip>
                </TextBlock>
            </StackPanel>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Host a project folder that already exists: set up its IIS website and/or its database." />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0" Margin="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,8,10,4">
                        <Button AutomationProperties.Name="Look at the folders again" DockPanel.Dock="Right" x:Name="RefreshButton" Padding="10,0" VerticalAlignment="Center"
                                ToolTip="Look at the folders again" Click="Refresh_Click">
                            <TextBlock Text="{StaticResource GlyphRefresh}" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                        </Button>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Project folders" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="FolderList" BorderThickness="0" SelectionChanged="FolderList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal">
                                        <!-- As wide as its widest text, hidden underneath: the DB line starts at the same place in every row. -->
                                        <Grid>
                                            <TextBlock Text="IIS: Offline" FontWeight="SemiBold" FontSize="{DynamicResource TextCaption}" Visibility="Hidden" />
                                            <TextBlock Text="no IIS site" FontSize="{DynamicResource TextCaption}" Visibility="Hidden" />
                                            <TextBlock x:Name="IisText" Text="{Binding Iis}" Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextCaption}" />
                                        </Grid>
                                        <TextBlock x:Name="DbText" Text="{Binding Database}" ToolTip="{Binding DatabaseTip}" Margin="12,0,0,0"
                                                   Foreground="{DynamicResource TextMuted}" FontSize="{DynamicResource TextCaption}" />
                                    </StackPanel>
                                </StackPanel>
                                <!-- Same colours as the Projects table: Live green, Offline red, no site or database muted. -->
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding DatabaseState}" Value="Live">
                                        <Setter TargetName="DbText" Property="Foreground" Value="{DynamicResource SuccessText}" />
                                        <Setter TargetName="DbText" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DatabaseState}" Value="Offline">
                                        <Setter TargetName="DbText" Property="Foreground" Value="{DynamicResource ErrorText}" />
                                        <Setter TargetName="DbText" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Live">
                                        <Setter TargetName="IisText" Property="Foreground" Value="{DynamicResource SuccessText}" />
                                        <Setter TargetName="IisText" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Offline">
                                        <Setter TargetName="IisText" Property="Foreground" Value="{DynamicResource ErrorText}" />
                                        <Setter TargetName="IisText" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <!-- As wide as there is room, up to 640 - enough for the choices and a backup's name. -->
                <StackPanel MaxWidth="640">
                    <TextBlock x:Name="EmptyText" Foreground="{DynamicResource TextMuted}" Text="Select a folder on the left." Margin="0,6,0,0" />
                    <Border x:Name="OptionsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" x:Name="OptionsTitle" />
                            <TextBlock x:Name="NameError" Style="{StaticResource ErrorLine}" Visibility="Collapsed" Margin="0,0,0,8" />
                            <c:ExistingFolderOptions x:Name="FolderOptions" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RunButton" Style="{StaticResource Primary}" Content="Set up" IsEnabled="False" Click="Run_Click"
                                ToolTip="Create what is missing for the chosen folder - its files aren't overwritten" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
