<UserControl x:Class="DnnManager.Presentation.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DnnManager.Presentation.Controls">
    <UserControl.Resources>
        <Style x:Key="CategoryTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <!-- A group of settings within a category, e.g. "Theme". -->
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,22,0,8" />
        </Style>
        <!-- The categories on the left: icon and name, the selected one highlighted. -->
        <Style x:Key="CategoryItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="22,8,12,8">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CategoryGlyph" TargetType="TextBlock" BasedOn="{StaticResource NavGlyph}">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style x:Key="FolderPath" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- "Settings" and the way back to the page it was opened from. -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="28,14,20,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="12"
                        Foreground="{DynamicResource Accent}" ToolTip="Close settings" Click="Close_Click" />
                <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Close, and Save once something changed. -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="28,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="DiscardButton" Content="Discard changes" Visibility="Collapsed" Click="Discard_Click" />
                    <Button Content="Close" MinWidth="84" Margin="8,0,0,0" Click="Close_Click" />
                    <Button x:Name="SaveButton" Style="{StaticResource Primary}" Content="Save" MinWidth="84"
                            Margin="8,0,0,0" IsEnabled="False" Click="Save_Click"
                            ToolTip="Saves the settings - they apply at once, without a restart" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid Margin="28,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Search and the categories. -->
            <DockPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="Search settings" MinHeight="36"
                         Margin="0,0,0,20" TextChanged="Search_TextChanged" />
                <TextBlock x:Name="NoMatch" DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="No setting matches." Visibility="Collapsed" />
                <ListBox x:Name="Categories" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CategoryItem}"
                         SelectionChanged="Categories_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Tag="General">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CategoryGlyph}" Text="&#xE713;" /><TextBlock Text="General" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Projects">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CategoryGlyph}" Text="&#xE8B7;" /><TextBlock Text="Projects" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Releases">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CategoryGlyph}" Text="&#xE896;" /><TextBlock Text="DNN releases" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Sql">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CategoryGlyph}" Text="&#xE8F1;" /><TextBlock Text="SQL Server" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Docker">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CategoryGlyph}" Text="&#xE7B8;" /><TextBlock Text="Docker container" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Iis">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CategoryGlyph}" Text="&#xE774;" /><TextBlock Text="IIS" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="About">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource CategoryGlyph}" Text="&#xE946;" /><TextBlock Text="About" /></StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <!-- The selected category. -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <!-- The same width for every category: as wide as there is room, up to 860. -->
                <Grid Margin="0,0,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="860" />
                </Grid.ColumnDefinitions>
                <StackPanel>

                    <Border x:Name="EnvWarning" Style="{StaticResource WarnBanner}" Visibility="Collapsed">
                        <TextBlock x:Name="EnvWarningText" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorLine}" Visibility="Collapsed" Margin="0,0,0,14" />

                    <StackPanel x:Name="Form">
                        <StackPanel x:Name="GeneralPanel">
                            <TextBlock Style="{StaticResource CategoryTitle}" Text="General" />

                            <CheckBox x:Name="StartAtSignIn" Content="Start DNN Manager when you sign in to your computer" Margin="0,18,0,0"
                                      IsEnabled="False" Click="StartAtSignIn_Click" />
                            <TextBlock x:Name="StartAtSignInHint" Style="{StaticResource Hint}" Margin="22,2,0,0"
                                       Text="With its Administrator rights, without Windows asking for them at every sign-in (a scheduled task)." />

                            <TextBlock Style="{StaticResource GroupLabel}" Text="Choose theme for DNN Manager" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Light" Tag="light" Checked="Theme_Checked" />
                                <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Dark" Tag="dark" Margin="20,4,0,4" Checked="Theme_Checked" />
                                <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Use system settings" Tag="system" Margin="20,4,0,4" Checked="Theme_Checked" />
                            </StackPanel>


                            <TextBlock Style="{StaticResource GroupLabel}" Text="Terminal" />
                            <CheckBox x:Name="TerminalEnabled" Content="Enable the terminal" Click="Terminal_Changed" />
                            <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,0"
                                       Text="Shells in the panel at the bottom of the window, next to the activity log - opened with its + button. They run with Administrator rights, like DNN Manager. Off: the panel only shows the activity log." />
                            <StackPanel x:Name="TerminalOptions" Margin="22,4,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Default shell" />
                                <ComboBox x:Name="DefaultShell" Width="240" HorizontalAlignment="Left" SelectionChanged="Terminal_Changed" />
                                <TextBlock Style="{StaticResource Hint}" Text="What + opens; the arrow next to it offers the other shells installed on this PC." />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Font family" />
                                        <ComboBox x:Name="TerminalFont" Width="240" SelectionChanged="Terminal_Changed" />
                                    </StackPanel>
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Font size" />
                                        <ComboBox x:Name="TerminalFontSize" Width="90" SelectionChanged="Terminal_Changed" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="Also the font of the activity log." />
                            </StackPanel>

                            <TextBlock Style="{StaticResource GroupLabel}" Text="Settings file" />
                            <TextBlock x:Name="SettingsFileText" Style="{StaticResource FolderPath}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="The settings are stored in this file. Save writes it and applies the changes at once; a change made in the file itself applies the next time DNN Manager starts." />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Open settings.json" Click="OpenFile_Click" />
                                <Button Content="Open settings folder" Margin="8,0,0,0" Click="OpenFolder_Click" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="ProjectsPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource CategoryTitle}" Text="Projects" />
                            <TextBlock Style="{StaticResource GroupLabel}" Text="Projects folder" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseBaseDir_Click" />
                                <TextBox x:Name="BaseDirectory" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Every project is a folder in here." />

                            <TextBlock Style="{StaticResource GroupLabel}" Text="Site address" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Hostname suffix" Margin="0,0,0,4" />
                                    <TextBox x:Name="HostnameSuffix" TextChanged="Preview_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Site port" Margin="0,0,0,4" />
                                    <TextBox x:Name="SitePort" TextChanged="Preview_Changed" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="UrlPreview" Style="{StaticResource Hint}" />
                        </StackPanel>

                        <StackPanel x:Name="ReleasesPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource CategoryTitle}" Text="DNN releases" />
                            <TextBlock Style="{StaticResource GroupLabel}" Text="Repositories" />
                            <TextBox x:Name="ReleaseApis" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="90"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Style="{StaticResource Hint}" Text="GitHub releases API URLs, one per line - the repositories New project offers, with their versions." />

                            <TextBlock Style="{StaticResource GroupLabel}" Text="Install packages" />
                            <CheckBox x:Name="KeepDnnPackages" Content="Keep downloaded DNN install packages for next time" />
                            <TextBlock x:Name="KeepDnnPackagesHint" Style="{StaticResource Hint}" Margin="22,2,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="SqlPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource CategoryTitle}" Text="SQL Server" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0"
                                       Text="The SQL Server DNN Manager connects to. The Docker container publishes it on this port, with this SA password. Test the connection on the Environment page." />
                            <TextBlock Style="{StaticResource GroupLabel}" Text="Connection" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Server host" Margin="0,0,0,4" />
                                    <TextBox x:Name="ContainerIp" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Port" Margin="0,0,0,4" />
                                    <TextBox x:Name="DefaultPort" />
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="SA password" />
                                    <c:PasswordInput x:Name="SaPassword" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource GroupLabel}" Text="SQL Server Management Studio" />
                            <CheckBox x:Name="SsmsRememberPassword" Content="Remember the password in SQL Server Management Studio" />
                            <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,0"
                                       Text="When a project's right-click menu signs SSMS in, tick its 'Remember Password' - SSMS then keeps the password and connects straight away next time." />
                        </StackPanel>

                        <StackPanel x:Name="DockerPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource CategoryTitle}" Text="Docker container" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0"
                                       Text="The SQL Server container. After a change, apply it with Set up docker-compose on the Environment page." />
                            <TextBlock Style="{StaticResource GroupLabel}" Text="Container" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Container name" Margin="0,0,0,4" />
                                    <TextBox x:Name="ContainerName" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Volume name" Margin="0,0,0,4" />
                                    <TextBox x:Name="VolumeName" />
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Edition (MSSQL_PID)" />
                                    <TextBox x:Name="MssqlPid" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Collation" />
                                    <TextBox x:Name="Collation" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="IisPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource CategoryTitle}" Text="IIS" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0"
                                       Text="The Windows features the Environment page checks and can enable. The list is edited in settings.json (iis.requiredFeatures)." />
                            <TextBlock Style="{StaticResource GroupLabel}" Text="Required Windows features" />
                            <ItemsControl x:Name="IisFeatures">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextMuted}" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Open settings.json" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OpenFile_Click" />
                        </StackPanel>

                        <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource CategoryTitle}" Text="About" />
                            <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource GroupLabel}" Text="Your files" />
                            <ItemsControl x:Name="Folders">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource FolderPath}" Text="{Binding Value}" ToolTip="{Binding Value}" />
                                            <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Open" Margin="16,0,0,0"
                                                    Tag="{Binding Value}" Click="OpenListedFolder_Click" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="Kept apart from the program: updating or uninstalling DNN Manager leaves these folders alone." />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
