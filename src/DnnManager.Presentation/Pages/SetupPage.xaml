<UserControl x:Class="DnnManager.Presentation.Pages.SetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DnnManager.Presentation.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Centred: as wide as there is room, up to 860 - the width of the settings. -->
        <StackPanel Margin="28,24,28,20" MaxWidth="860">
            <TextBlock Style="{StaticResource PageTitle}" Text="New project" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Creates a project from a fresh DNN download - installed for you, so the first visit shows your new site - or from a .zip of an existing site (with its .bacpac / .bak), with its IIS website, hostname and database." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Project" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Project name" Margin="0,0,0,4" />
                    <TextBox AutomationProperties.Name="Project name" x:Name="NameBox" TextChanged="NameBox_TextChanged" />
                    <TextBlock x:Name="NameError" Style="{StaticResource ErrorLine}" Visibility="Collapsed" />
                    <TextBlock x:Name="NameHint" Style="{StaticResource Hint}" />
                </StackPanel>
            </Border>

            <Border x:Name="StartCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Start from" />
                    <RadioButton x:Name="FromScratch" GroupName="Start" Content="A new site - download a DNN release" IsChecked="True" Checked="Start_Checked" />
                    <RadioButton x:Name="FromZip"     GroupName="Start" Content="An existing site - import a .zip of its files and its .bacpac" Checked="Start_Checked" />
                </StackPanel>
            </Border>

            <Border x:Name="ImportCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Import" />
                    <!-- Only when a project has a backup to start from. -->
                    <StackPanel x:Name="BackupPickPanel">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="From a project backup" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="BackupProjectCombo" AutomationProperties.Name="Project with backups" SelectionChanged="BackupProject_Changed" />
                            <ComboBox x:Name="ProjectBackupCombo" Grid.Column="2" AutomationProperties.Name="Backup" DisplayMemberPath="Label" IsEnabled="False" SelectionChanged="ProjectBackup_Changed" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="A project and one of its backups (Documents\DnnManager\backups) - or choose the files anywhere on this PC below." />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Site .zip" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseZip_Click" ToolTip="Browse" />
                        <TextBox AutomationProperties.Name="Site .zip" x:Name="ZipBox" TextChanged="ImportField_Changed" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="The site's files - web.config at the top of the zip or in one folder inside it." />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Database .bacpac" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseBackup_Click" ToolTip="Browse" />
                        <TextBox AutomationProperties.Name="Database .bacpac" x:Name="BackupBox" TextChanged="ImportField_Changed" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="The site's database - restored into the project's database. A .bak works too." />
                    <TextBlock x:Name="ImportError" Style="{StaticResource ErrorLine}" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border x:Name="PackageCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="DNN package" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Repository" Margin="0,0,0,4" />
                            <ComboBox AutomationProperties.Name="Repository" x:Name="SourceCombo" DisplayMemberPath="Label" SelectionChanged="SourceCombo_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Version" Margin="0,0,0,4" />
                            <ComboBox AutomationProperties.Name="Version" x:Name="VersionCombo" DisplayMemberPath="Label" SelectionChanged="VersionCombo_SelectionChanged" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="VersionHint" Style="{StaticResource Hint}"
                               Text="The repository's DNN releases, highest version first - the latest is selected." />
                </StackPanel>
            </Border>

            <Border x:Name="IisCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="IIS" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Host name" Margin="0,0,0,4" />
                            <TextBox AutomationProperties.Name="Host name" x:Name="HostNameBox" TextChanged="HostName_TextChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Port" Margin="0,0,0,4" />
                            <TextBox AutomationProperties.Name="Port" x:Name="PortBox" TextChanged="Field_Changed" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="IisHint" Style="{StaticResource Hint}" />
                </StackPanel>
            </Border>

            <Border x:Name="InstallCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="DNN installation" />
                    <RadioButton x:Name="AutomaticInstall" GroupName="Install" Checked="Install_Checked">
                        <StackPanel>
                            <TextBlock Text="Automatic setup (recommended)" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="DNN Manager installs DNN with the account and website below - the first visit shows your new site, not DNN's installation wizard." />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ManualInstall" GroupName="Install" Checked="Install_Checked" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Manual DNN setup" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="DNN's own installation wizard opens on the first visit, for you to fill in." />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Border x:Name="AccountCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="DNN account and website" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Host username" Margin="0,0,0,4" />
                            <TextBox AutomationProperties.Name="Host username" x:Name="HostUserBox" TextChanged="Field_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Generate" FontSize="{DynamicResource TextCaption}"
                                        ToolTip="Generate password" Click="GeneratePassword_Click" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Host password" Margin="0" />
                            </DockPanel>
                            <c:PasswordInput AutomationProperties.Name="Host password" x:Name="HostPasswordBox" PasswordChanged="Password_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Host e-mail" />
                            <TextBox AutomationProperties.Name="Host e-mail" x:Name="HostEmailBox" TextChanged="Field_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Website name" />
                            <TextBox AutomationProperties.Name="Website name" x:Name="WebsiteNameBox" TextChanged="WebsiteName_TextChanged" />
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Language" />
                            <ComboBox AutomationProperties.Name="Language" x:Name="LanguageCombo" SelectionChanged="Selection_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Site template" />
                            <ComboBox AutomationProperties.Name="Site template" x:Name="TemplateCombo" SelectionChanged="Selection_Changed" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="AccountError" Style="{StaticResource ErrorLine}" Visibility="Collapsed" />
                    <TextBlock x:Name="AccountHint" Style="{StaticResource Hint}" />
                </StackPanel>
            </Border>

            <!-- The database: filled in from Settings → Database server - changed here, for this project only. -->
            <Border x:Name="DatabaseCard" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="ResetDatabaseButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Use the settings"
                                FontSize="{DynamicResource TextCaption}" VerticalAlignment="Top" Visibility="Collapsed"
                                ToolTip="Use the settings" Click="ResetDatabase_Click" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="Database" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Connection type" Margin="0,0,0,4" />
                    <WrapPanel>
                        <RadioButton x:Name="DbContainer" GroupName="DbType" Content="Local SQL container (Docker)" Margin="0,0,20,4" Checked="DbType_Checked" />
                        <RadioButton x:Name="DbSqlServer" GroupName="DbType" Content="SQL Server / SQL Server Express" Margin="0,0,20,4" Checked="DbType_Checked" />
                        <RadioButton x:Name="DbLocalDb" GroupName="DbType" Content="LocalDB file" Margin="0,0,0,4" Checked="DbType_Checked" />
                    </WrapPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="DbServerLabel" Style="{StaticResource FieldLabel}" Text="Server" />
                            <TextBox AutomationProperties.Name="Server" x:Name="DbServerBox" TextChanged="DbField_Changed" />
                        </StackPanel>
                        <StackPanel x:Name="DbNamePanel" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Database name" />
                            <TextBox AutomationProperties.Name="Database name" x:Name="DbNameBox" TextChanged="DbName_Changed" />
                        </StackPanel>
                        <StackPanel x:Name="DbAuthPanel" Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton x:Name="DbWindowsAuth" GroupName="DbAuth" Content="Windows authentication" Margin="0,0,20,0" Checked="DbAuth_Checked" />
                            <RadioButton x:Name="DbSqlAuth" GroupName="DbAuth" Content="SQL Server authentication" Checked="DbAuth_Checked" />
                        </StackPanel>
                        <StackPanel x:Name="DbUserPanel" Grid.Row="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Username" />
                            <TextBox AutomationProperties.Name="Username" x:Name="DbUserBox" TextChanged="DbField_Changed" />
                        </StackPanel>
                        <StackPanel x:Name="DbPasswordPanel" Grid.Row="2" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Password" />
                            <c:PasswordInput AutomationProperties.Name="Password" x:Name="DbPasswordBox" PasswordChanged="DbPassword_Changed" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="DatabaseError" Style="{StaticResource ErrorLine}" Visibility="Collapsed" />
                    <TextBlock x:Name="DatabaseHint" Style="{StaticResource Hint}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="RunButton" Style="{StaticResource Primary}" Content="Create project" IsEnabled="False" Click="Run_Click"
                        ToolTip="Create the website with these choices - the panel at the bottom shows each step, Cancel undoes it" />
                <!-- Why the button can't be clicked yet: a disabled button says nothing, and can't even show its tooltip. -->
                <TextBlock x:Name="StillNeeded" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextWrapping="Wrap" MaxWidth="520" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
