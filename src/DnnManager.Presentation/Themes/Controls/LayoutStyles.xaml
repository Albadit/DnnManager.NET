<ResourceDictionary x:Class="DnnManager.Presentation.Themes.LayoutStyles"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:DnnManager.Presentation.Controls">
    <!-- Page building blocks: the text styles (PageTitle, PageSubtitle, CardTitle, FieldLabel, Hint, ErrorLine) and the
         boxes around content (Card, InfoBanner, WarnBanner), each used as Style="{StaticResource …}". And every Sash. -->

    <!-- A bar to drag between the window's parts (Controls/Sash), as VS Code's: three dots in its middle (brighter under the
         pointer); while it is dragged - or its corner is (IsActive) - a 4 px blue line along it instead, its ends rounded.
         The line and the dots keep within its Padding: a sash reaching across the gaps beside the cards draws only as long
         as the cards. -->
    <Style TargetType="c:Sash">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Sash">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Border x:Name="Line" Width="4" HorizontalAlignment="Center" CornerRadius="2"
                                    Background="{DynamicResource Accent}" Visibility="Hidden" />
                            <Path x:Name="Grip" Data="{StaticResource SashGripVertical}" Fill="{DynamicResource TextMuted}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="Line" Property="Width" Value="Auto" />
                            <Setter TargetName="Line" Property="Height" Value="4" />
                            <Setter TargetName="Line" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="Line" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="Grip" Property="Data" Value="{StaticResource SashGripHorizontal}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Fill" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsGripVisible" Value="False">
                            <Setter TargetName="Grip" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Grip" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Grip" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Cursor" Value="SizeNS" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Where the keyboard is: an accent ring around the control, shown only when the keyboard moved there (Services/FocusRing
         puts it on every control that would show Windows' faint dotted rectangle). -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-1" RadiusX="4" RadiusY="4" StrokeThickness="2" Stroke="{DynamicResource Accent}"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBlock" x:Key="PageTitle">
        <Setter Property="FontSize" Value="{DynamicResource TextDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="PageSubtitle">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,16" />
    </Style>
    <Style TargetType="TextBlock" x:Key="CardTitle">
        <Setter Property="FontSize" Value="{DynamicResource TextHeading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style TargetType="TextBlock" x:Key="FieldLabel">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Hint">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="{DynamicResource TextCaption}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style TargetType="TextBlock" x:Key="ErrorLine">
        <Setter Property="Foreground" Value="{DynamicResource ErrorText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style TargetType="Border" x:Key="Card">
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style TargetType="Border" x:Key="InfoBanner" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource InfoBannerBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InfoBannerBorder}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style TargetType="Border" x:Key="WarnBanner" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource WarnBannerBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarnBannerBorder}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
</ResourceDictionary>
