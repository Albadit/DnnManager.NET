    <sys:String x:Key="GlyphChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="GlyphChevronRight">&#xE76C;</sys:String>

    <!-- Marks and states. -->
    <sys:String x:Key="GlyphCheck">&#xE73E;</sys:String>
    <sys:String x:Key="GlyphDash">&#xE738;</sys:String>
    <sys:String x:Key="GlyphCancel">&#xE711;</sys:String>
    <sys:String x:Key="GlyphInfo">&#xE946;</sys:String>
    <sys:String x:Key="GlyphQuestion">&#xE9CE;</sys:String>
    <sys:String x:Key="GlyphWarning">&#xE7BA;</sys:String>
    <sys:String x:Key="GlyphError">&#xEA39;</sys:String>

    <!-- ═══ Drawn icons ══════════════════════════════════════════════════════════════════════════════════════════ -->

    <!-- How a line icon is stroked: <Path Style="{StaticResource IconStroke}" Data="…" Stroke="…" />. -->
    <Style x:Key="IconStroke" TargetType="Path">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

