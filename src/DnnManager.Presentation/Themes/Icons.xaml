<ResourceDictionary x:Class="DnnManager.Presentation.Themes.Icons"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Every icon the app shows, in one place: change one here and every place that shows it follows. Two kinds:
           Glyph…  a character of the icon font (IconFont) - <TextBlock Text="{StaticResource GlyphClose}"
                   FontFamily="{StaticResource IconFont}" />, or a button's Content in an icon style (IconButton…);
           the rest  a drawn path (Geometry) - <Path Data="{StaticResource LayoutPanel}" … />.
         In code: (string)FindResource("GlyphClose"), (Geometry)FindResource("LayoutPanel"). -->

    <!-- ═══ Font icons ═══════════════════════════════════════════════════════════════════════════════════════════ -->

    <!-- Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets (the same code points) on Windows 10. Each glyph is named
         after what it shows - https://learn.microsoft.com/windows/apps/design/style/segoe-fluent-icons-font -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The window's caption buttons. -->
    <sys:String x:Key="GlyphMinimize">&#xE921;</sys:String>
    <sys:String x:Key="GlyphMaximize">&#xE922;</sys:String>
    <sys:String x:Key="GlyphRestore">&#xE923;</sys:String>
    <sys:String x:Key="GlyphClose">&#xE8BB;</sys:String>

    <!-- Navigation and settings categories. -->
    <sys:String x:Key="GlyphSettings">&#xE713;</sys:String>
    <sys:String x:Key="GlyphList">&#xE8FD;</sys:String>
    <sys:String x:Key="GlyphFolder">&#xE8B7;</sys:String>
    <sys:String x:Key="GlyphFolderOpen">&#xE838;</sys:String>
    <sys:String x:Key="GlyphDownload">&#xE896;</sys:String>
    <sys:String x:Key="GlyphDatabase">&#xE8F1;</sys:String>
    <sys:String x:Key="GlyphContainer">&#xE7B8;</sys:String>
    <sys:String x:Key="GlyphGlobe">&#xE774;</sys:String>
    <sys:String x:Key="GlyphKeyboard">&#xE765;</sys:String>
    <sys:String x:Key="GlyphBack">&#xE72B;</sys:String>

    <!-- Actions. -->
    <sys:String x:Key="GlyphAdd">&#xE710;</sys:String>
    <sys:String x:Key="GlyphPlay">&#xE768;</sys:String>
    <sys:String x:Key="GlyphStop">&#xE71A;</sys:String>
    <sys:String x:Key="GlyphRefresh">&#xE72C;</sys:String>
    <sys:String x:Key="GlyphDelete">&#xE74D;</sys:String>
    <sys:String x:Key="GlyphCopy">&#xE8C8;</sys:String>
    <sys:String x:Key="GlyphSearch">&#xE721;</sys:String>
    <sys:String x:Key="GlyphReset">&#xE7A7;</sys:String>
    <sys:String x:Key="GlyphMore">&#xE712;</sys:String>
    <sys:String x:Key="GlyphShow">&#xE7B3;</sys:String>
    <sys:String x:Key="GlyphHide">&#xED1A;</sys:String>

