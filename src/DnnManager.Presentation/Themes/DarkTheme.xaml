<ResourceDictionary x:Class="DnnManager.Presentation.Themes.DarkTheme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Same keys as LightTheme.xaml. -->
    <SolidColorBrush x:Key="WindowBg"         Color="#1A1C22" />
    <SolidColorBrush x:Key="CardBg"           Color="#23262E" />
    <SolidColorBrush x:Key="CardBorder"       Color="#32363F" />
    <SolidColorBrush x:Key="InputBg"          Color="#1C1E25" />
    <SolidColorBrush x:Key="InputBorder"      Color="#3E434D" />
    <SolidColorBrush x:Key="HoverBg"          Color="#2D313A" />
    <SolidColorBrush x:Key="SelectionBg"      Color="#27395A" />
    <SolidColorBrush x:Key="HeaderBg"         Color="#282B33" />
    <SolidColorBrush x:Key="GridLine"         Color="#2E323A" />
    <SolidColorBrush x:Key="ScrollThumb"      Color="#474C57" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#5D636F" />

    <SolidColorBrush x:Key="TextPrimary"      Color="#E6E8EC" />
    <SolidColorBrush x:Key="TextMuted"        Color="#9CA3AF" />
    <SolidColorBrush x:Key="ErrorText"        Color="#F28B82" />
    <SolidColorBrush x:Key="SuccessText"      Color="#6BD68A" />
    <!-- Keep warm's flame while a site is kept warm. -->
    <SolidColorBrush x:Key="KeepWarmFg"       Color="#FF8A3D" />

    <SolidColorBrush x:Key="Accent"           Color="#3B7CF0" />
    <SolidColorBrush x:Key="AccentHover"      Color="#2F69D4" />
    <SolidColorBrush x:Key="DangerBrush"      Color="#D64545" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#BA3636" />

    <SolidColorBrush x:Key="InfoBannerBg"     Color="#1D2B44" />
    <SolidColorBrush x:Key="InfoBannerBorder" Color="#2F4B78" />
    <SolidColorBrush x:Key="WarnBannerBg"     Color="#382F1C" />
    <SolidColorBrush x:Key="WarnBannerBorder" Color="#6E5B2C" />

    <SolidColorBrush x:Key="SidebarBg"        Color="#13151A" />
    <SolidColorBrush x:Key="SidebarBorder"    Color="#1F222A" />
    <SolidColorBrush x:Key="SidebarFg"        Color="#C9CEDB" />
    <SolidColorBrush x:Key="SidebarActiveFg"  Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarHover"     Color="#1E2129" />
    <SolidColorBrush x:Key="SidebarSelected"  Color="#242833" />
    <SolidColorBrush x:Key="SidebarMuted"     Color="#7F879A" />
    <SolidColorBrush x:Key="SidebarDivider"   Color="#262A34" />

    <SolidColorBrush x:Key="StatusBarBg"      Color="#13151A" />

    <SolidColorBrush x:Key="LogBg"            Color="#14161B" />
    <!-- Search (Ctrl+F in the bottom panel): every match, and the current one. -->
    <SolidColorBrush x:Key="SearchMatchBg"    Color="#6B5317" />
    <SolidColorBrush x:Key="SearchCurrentBg"  Color="#C2862B" />
    <SolidColorBrush x:Key="LogHeaderBg"      Color="#1C1F26" />
    <SolidColorBrush x:Key="LogHeaderFg"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="LogFg"            Color="#D4D7DE" />
    <SolidColorBrush x:Key="LogMuted"         Color="#9AA3B5" />
    <SolidColorBrush x:Key="LogFail"          Color="#F28B82" />
    <SolidColorBrush x:Key="LogWarn"          Color="#F2C94C" />
    <SolidColorBrush x:Key="LogTrack"         Color="#2E3445" />
    <!-- Output tab (Controls/PipelineView): the log, the stage icons and the status pills - its header and stage rail use
         the panel's Log* brushes. -->
    <SolidColorBrush x:Key="OutBorder"          Color="#262626" />
    <SolidColorBrush x:Key="OutLogBg"           Color="#141414" />
    <SolidColorBrush x:Key="OutText"            Color="#CCCCCC" />
    <SolidColorBrush x:Key="OutHeading"         Color="#E5E5E5" />
    <SolidColorBrush x:Key="OutHeadingTime"     Color="#8A8A8A" />
    <SolidColorBrush x:Key="OutTime"            Color="#A3A3A3" />
    <SolidColorBrush x:Key="OutMuted"           Color="#7A7A7A" />
    <SolidColorBrush x:Key="OutDim"             Color="#5A5A5A" />
    <SolidColorBrush x:Key="OutSkippedIcon"     Color="#3A3A3A" />
    <SolidColorBrush x:Key="OutValue"           Color="#7DD3C8" />
    <SolidColorBrush x:Key="OutActive"          Color="#4FC1B5" />
    <SolidColorBrush x:Key="OutSuccessText"     Color="#7FD9B0" />
    <SolidColorBrush x:Key="OutOk"              Color="#5FBF7F" />
    <SolidColorBrush x:Key="OutWarn"            Color="#E0A34A" />
    <SolidColorBrush x:Key="OutWarnText"        Color="#F0D9B0" />
    <SolidColorBrush x:Key="OutWarnRowBg"       Color="#221C12" />
    <SolidColorBrush x:Key="OutError"           Color="#F2667A" />
    <SolidColorBrush x:Key="OutErrorSoft"       Color="#FF9AA6" />
    <SolidColorBrush x:Key="OutErrorText"       Color="#FFD6DB" />
    <SolidColorBrush x:Key="OutErrorDetail"     Color="#C08A93" />
    <SolidColorBrush x:Key="OutErrorBg"         Color="#2A161A" />
    <SolidColorBrush x:Key="OutBadgeText"       Color="#1A1A1A" />
    <SolidColorBrush x:Key="OutPillRunningBg"   Color="#12302C" />
    <SolidColorBrush x:Key="OutPillRunningFg"   Color="#7DD3C8" />
    <SolidColorBrush x:Key="OutPillOkBg"        Color="#15332B" />
    <SolidColorBrush x:Key="OutPillOkFg"        Color="#7FD9B0" />
    <SolidColorBrush x:Key="OutPillFailBg"      Color="#3A1A20" />
    <SolidColorBrush x:Key="OutPillFailFg"      Color="#FF9AA6" />
    <SolidColorBrush x:Key="OutPillNeutralBg"   Color="#2A2A2A" />
    <SolidColorBrush x:Key="OutPillNeutralFg"   Color="#BBBBBB" />
</ResourceDictionary>
