<ResourceDictionary x:Class="DnnManager.Presentation.Themes.DarkTheme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- VS Code's Dark Modern - same keys as LightTheme.xaml. Each colour is VS Code's own, named after the key it comes
         from: extensions/theme-defaults/themes/dark_modern.json, and VS Code's built-in defaults (colorRegistry,
         terminalColorRegistry) for what that file leaves out. Only the flame (KeepWarmFg) and the Danger button aren't
         VS Code's - it has neither. -->
    <SolidColorBrush x:Key="WindowBg"         Color="#1F1F1F" />  <!-- editor.background -->
    <SolidColorBrush x:Key="CardBg"           Color="#181818" />  <!-- panel.background -->
    <SolidColorBrush x:Key="CardBorder"       Color="#2B2B2B" />  <!-- panel.border -->
    <SolidColorBrush x:Key="InputBg"          Color="#313131" />  <!-- input.background -->
    <SolidColorBrush x:Key="InputBorder"      Color="#6B6B6B" />  <!-- input.border -->
    <SolidColorBrush x:Key="HoverBg"          Color="#2A2D2E" />  <!-- list.hoverBackground -->
    <SolidColorBrush x:Key="SelectionBg"      Color="#04395E" />  <!-- list.activeSelectionBackground -->
    <SolidColorBrush x:Key="HeaderBg"         Color="#181818" />  <!-- sideBarSectionHeader.background -->
    <SolidColorBrush x:Key="GridLine"         Color="#2B2B2B" />  <!-- tab.border -->
    <SolidColorBrush x:Key="ScrollThumb"      Color="#66797979" /> <!-- scrollbarSlider.background -->
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#B3646464" /> <!-- scrollbarSlider.hoverBackground -->

    <SolidColorBrush x:Key="TextPrimary"      Color="#CCCCCC" />  <!-- foreground -->
    <SolidColorBrush x:Key="TextMuted"        Color="#9D9D9D" />  <!-- descriptionForeground -->
    <SolidColorBrush x:Key="ErrorText"        Color="#FF6B61" />  <!-- errorForeground -->
    <SolidColorBrush x:Key="SuccessText"      Color="#73C991" />  <!-- testing.iconPassed -->
    <!-- Keep warm's flame while a site is kept warm. -->
    <SolidColorBrush x:Key="KeepWarmFg"       Color="#FF8A3D" />

    <SolidColorBrush x:Key="Accent"           Color="#0078D4" />  <!-- button.background, focusBorder -->
    <!-- The border of a field or check box under the mouse or with the focus: 3:1 against the field (WCAG 1.4.11). -->
    <SolidColorBrush x:Key="FocusBorder"      Color="#3794FF" />  <!-- a focusBorder with 3:1 against the fields -->
    <!-- Text and marks on an accent fill: a primary button, a ticked check box, a switch that is on. -->
    <SolidColorBrush x:Key="OnAccent"         Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentHover"      Color="#026EC1" />  <!-- button.hoverBackground -->
    <SolidColorBrush x:Key="DangerBrush"      Color="#C72E0F" />  <!-- statusBarItem.errorBackground -->
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#A8270D" />

    <SolidColorBrush x:Key="InfoBannerBg"     Color="#063B49" />  <!-- inputValidation.infoBackground -->
    <SolidColorBrush x:Key="InfoBannerBorder" Color="#007ACC" />  <!-- inputValidation.infoBorder -->
    <SolidColorBrush x:Key="WarnBannerBg"     Color="#352A05" />  <!-- inputValidation.warningBackground -->
    <SolidColorBrush x:Key="WarnBannerBorder" Color="#B89500" />  <!-- inputValidation.warningBorder -->

    <SolidColorBrush x:Key="SidebarBg"        Color="#181818" />  <!-- sideBar.background, titleBar.activeBackground -->
    <SolidColorBrush x:Key="SidebarBorder"    Color="#2B2B2B" />  <!-- sideBar.border -->
    <SolidColorBrush x:Key="SidebarFg"        Color="#CCCCCC" />  <!-- sideBar.foreground -->
    <SolidColorBrush x:Key="SidebarActiveFg"  Color="#FFFFFF" />  <!-- list.activeSelectionForeground -->
    <SolidColorBrush x:Key="SidebarHover"     Color="#2A2D2E" />  <!-- list.hoverBackground -->
    <SolidColorBrush x:Key="SidebarSelected"  Color="#37373D" />  <!-- list.inactiveSelectionBackground -->
    <SolidColorBrush x:Key="SidebarMuted"     Color="#9D9D9D" />  <!-- descriptionForeground -->
    <SolidColorBrush x:Key="SidebarDivider"   Color="#2B2B2B" />  <!-- sideBarSectionHeader.border -->

    <SolidColorBrush x:Key="StatusBarBg"      Color="#181818" />  <!-- statusBar.background -->
    <!-- A search option (Aa, ab, .*) in the panel's search box, under the mouse. -->
    <SolidColorBrush x:Key="InputOptionHoverBg"       Color="#805A5D5E" /> <!-- inputOption.hoverBackground -->
    <!-- The line between groups of the command palette (Customize Layout). -->
    <SolidColorBrush x:Key="PickerGroupBorder"        Color="#3C3C3C" />   <!-- pickerGroup.border -->
    <!-- Behind Settings and Troubleshoot, which open over the page: the page dimmed. -->
    <SolidColorBrush x:Key="ModalBackdrop"            Color="#66000000" />
    <!-- The tour's: darker, so the one part it is about stands out. -->
    <SolidColorBrush x:Key="TourBackdrop"             Color="#B3000000" />
    <!-- The search in the middle of the title bar. -->
    <SolidColorBrush x:Key="CommandCenterFg"          Color="#CCCCCC" />   <!-- commandCenter.foreground -->
    <SolidColorBrush x:Key="CommandCenterBg"          Color="#0DFFFFFF" /> <!-- commandCenter.background -->
    <SolidColorBrush x:Key="CommandCenterHoverBg"     Color="#14FFFFFF" /> <!-- commandCenter.activeBackground -->
    <SolidColorBrush x:Key="CommandCenterBorder"      Color="#33CCCCCC" /> <!-- commandCenter.border -->
    <SolidColorBrush x:Key="CommandCenterHoverBorder" Color="#4DCCCCCC" /> <!-- commandCenter.activeBorder -->

    <SolidColorBrush x:Key="LogBg"            Color="#181818" />  <!-- panel.background -->
    <!-- Search (Ctrl+F in the bottom panel): every match, and the current one. -->
    <SolidColorBrush x:Key="SearchMatchBg"    Color="#55EA5C00" /> <!-- editor.findMatchHighlightBackground -->
    <SolidColorBrush x:Key="SearchCurrentBg"  Color="#9E6A03" />  <!-- editor.findMatchBackground -->
    <SolidColorBrush x:Key="LogHeaderBg"      Color="#181818" />  <!-- panel.background -->
    <SolidColorBrush x:Key="LogHeaderFg"      Color="#FFFFFF" />  <!-- list.activeSelectionForeground -->
    <SolidColorBrush x:Key="LogFg"            Color="#CCCCCC" />  <!-- terminal.foreground -->
    <SolidColorBrush x:Key="LogMuted"         Color="#9D9D9D" />  <!-- panelTitle.inactiveForeground -->
    <SolidColorBrush x:Key="LogFail"          Color="#F14C4C" />  <!-- editorError.foreground -->
    <SolidColorBrush x:Key="LogWarn"          Color="#CCA700" />  <!-- editorWarning.foreground -->
    <SolidColorBrush x:Key="LogTrack"         Color="#2B2B2B" />  <!-- panel.border -->
    <!-- Output tab (Controls/PipelineView): the log, the stage icons and the status pills - its header and stage rail use
         the panel's Log* brushes. -->
    <SolidColorBrush x:Key="OutBorder"          Color="#2B2B2B" />  <!-- panel.border -->
    <SolidColorBrush x:Key="OutLogBg"           Color="#181818" />  <!-- panel.background -->
    <SolidColorBrush x:Key="OutText"            Color="#CCCCCC" />  <!-- foreground -->
    <SolidColorBrush x:Key="OutHeading"         Color="#FFFFFF" />  <!-- settings.headerForeground -->
    <SolidColorBrush x:Key="OutHeadingTime"     Color="#9D9D9D" />  <!-- descriptionForeground -->
    <SolidColorBrush x:Key="OutTime"            Color="#9D9D9D" />  <!-- descriptionForeground -->
    <SolidColorBrush x:Key="OutMuted"           Color="#9D9D9D" />  <!-- descriptionForeground -->
    <SolidColorBrush x:Key="OutDim"             Color="#8B949E" />  <!-- editorLineNumber.foreground -->
    <SolidColorBrush x:Key="OutSkippedIcon"     Color="#6B6B6B" />  <!-- input.border -->
    <SolidColorBrush x:Key="OutValue"           Color="#4DAAFC" />  <!-- textLink.foreground -->
    <SolidColorBrush x:Key="OutActive"          Color="#59A4F9" />  <!-- editorInfo.foreground -->
    <SolidColorBrush x:Key="OutSuccessText"     Color="#73C991" />  <!-- testing.iconPassed -->
    <SolidColorBrush x:Key="OutOk"              Color="#73C991" />  <!-- testing.iconPassed -->
    <SolidColorBrush x:Key="OutWarn"            Color="#CCA700" />  <!-- editorWarning.foreground -->
    <SolidColorBrush x:Key="OutWarnText"        Color="#CCA700" />  <!-- list.warningForeground -->
    <SolidColorBrush x:Key="OutWarnRowBg"       Color="#352A05" />  <!-- inputValidation.warningBackground -->
    <SolidColorBrush x:Key="OutError"           Color="#F14C4C" />  <!-- editorError.foreground -->
    <SolidColorBrush x:Key="OutErrorSoft"       Color="#F88070" />  <!-- list.errorForeground -->
    <SolidColorBrush x:Key="OutErrorText"       Color="#F88070" />  <!-- list.errorForeground -->
    <SolidColorBrush x:Key="OutErrorDetail"     Color="#9D9D9D" />  <!-- descriptionForeground -->
    <SolidColorBrush x:Key="OutErrorBg"         Color="#5A1D1D" />  <!-- inputValidation.errorBackground -->
    <SolidColorBrush x:Key="OutBadgeText"       Color="#1F1F1F" />  <!-- editor.background -->
    <SolidColorBrush x:Key="OutPillRunningBg"   Color="#063B49" />  <!-- inputValidation.infoBackground -->
    <SolidColorBrush x:Key="OutPillRunningFg"   Color="#59A4F9" />  <!-- editorInfo.foreground -->
    <SolidColorBrush x:Key="OutPillOkBg"        Color="#2673C991" /> <!-- testing.iconPassed, faint -->
    <SolidColorBrush x:Key="OutPillOkFg"        Color="#73C991" />  <!-- testing.iconPassed -->
    <SolidColorBrush x:Key="OutPillFailBg"      Color="#5A1D1D" />  <!-- inputValidation.errorBackground -->
    <SolidColorBrush x:Key="OutPillFailFg"      Color="#F88070" />  <!-- list.errorForeground -->
    <SolidColorBrush x:Key="OutPillNeutralBg"   Color="#313131" />  <!-- badge (button.secondary) -->
    <SolidColorBrush x:Key="OutPillNeutralFg"   Color="#CCCCCC" />  <!-- foreground -->
</ResourceDictionary>
