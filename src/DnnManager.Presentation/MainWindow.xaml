<Window x:Class="DnnManager.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DnnManager.Presentation.Controls"
        xmlns:s="clr-namespace:DnnManager.Presentation.Services"
        Title="DNN Manager" Icon="pack://application:,,,/DnnManager;component/src/DnnManager.Presentation/Assets/dnn.ico" Width="1180" Height="800" MinWidth="400" MinHeight="270"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        StateChanged="Window_StateChanged">
    <!-- The app draws its own title bar (the search in the middle, the layout buttons next to the window buttons). The
         1px glass edge keeps Windows' shadow and rounded corners. Its height follows the layout density (ApplyLayout). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Minimize / maximize / close. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="{DynamicResource CaptionButtonWidth}" />
            <Setter Property="Height" Value="{DynamicResource TitleBarHeight}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <!-- Set from code while the pointer is over maximize (Windows 11 shows Snap layouts there). -->
                            <Trigger Property="Tag" Value="Hover">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The layout buttons, left of the window buttons. -->
        <Style x:Key="TitleBarButton" TargetType="ButtonBase">
            <!-- An icon says nothing to a screen reader: it reads the tooltip. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="{DynamicResource TitleBarHeight}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS Code's layout buttons: Customize Layout, the sidebar, the panel - small, rounded on hover. -->
        <Style x:Key="LayoutButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Width" Value="{DynamicResource LayoutButtonWidth}" />
            <Setter Property="Height" Value="{DynamicResource LayoutButtonHeight}" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Update, left of the layout buttons: a small primary (blue) button. -->
        <!-- About as tall as the icons beside it, so the title bar's buttons line up. -->
        <Style x:Key="TitleBarUpdate" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{DynamicResource TextSmall}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <!-- The search in the middle of the title bar - VS Code's command center: it opens the command palette. -->
        <Style x:Key="CommandCenter" TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="{DynamicResource CommandCenterFg}" />
            <Setter Property="Background" Value="{DynamicResource CommandCenterBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CommandCenterBorder}" />
            <Setter Property="FontSize" Value="{DynamicResource TextCaption}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CommandCenterHoverBg}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CommandCenterHoverBorder}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar parts only shown while it's wide (see MainWindow.IsCompact). -->
        <Style x:Key="ExpandedOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A page entry, its name and shortcut as its tooltip - on its right. -->
        <Style x:Key="SidebarNav" TargetType="RadioButton" BasedOn="{StaticResource NavItem}">
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <!-- The 30 px icon in the middle of the highlight: 48 (as VS Code's activity bar) less the margins - 40 in
                         the Compact density. -->
                    <Setter Property="Margin" Value="{DynamicResource NavIconMargin}" />
                    <Setter Property="Padding" Value="{DynamicResource NavIconPadding}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Troubleshoot and the gear at the bottom of the sidebar: entries like the pages', but buttons - they open
             something over the page (Troubleshoot) or a menu (the gear). -->
        <Style x:Key="SidebarAction" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SidebarFg}" />
            <Setter Property="FontSize" Value="{DynamicResource TextMedium}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="{DynamicResource NavMargin}" />
            <Setter Property="Padding" Value="{DynamicResource NavPadding}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource CardRadius}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="{DynamicResource NavIconMargin}" />
                    <Setter Property="Padding" Value="{DynamicResource NavIconPadding}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- The title bar, the body (sidebar, page, panel) and the status bar. The body takes what is left, so however
             short the window, the title bar and the status bar keep their room. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: drag it to move the window, double-click to maximize. -->
        <Border Height="{DynamicResource TitleBarHeight}" Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,0,1">
            <Grid x:Name="TitleBar" SizeChanged="TitleBar_SizeChanged">
            <!-- In the middle of the window, as wide as there is room for between the name and the buttons
                 (SizeCommandCenter). -->
            <Button x:Name="CommandCenter" Style="{StaticResource CommandCenter}" Click="CommandCenter_Click"
                    ToolTip="Search projects and commands" s:CommandTip.Command="projects.quickOpen"
                    AutomationProperties.Name="Search projects and commands">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Search projects and commands" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Button>
            <DockPanel>
                <StackPanel x:Name="TitleRight" DockPanel.Dock="Right" Orientation="Horizontal" SizeChanged="TitleBar_SizeChanged">
                    <!-- Only while a newer release is there (AppUpdater): it downloads, installs and restarts on it. -->
                    <Button x:Name="UpdateButton" Style="{StaticResource TitleBarUpdate}" Content="Update" Visibility="Collapsed"
                            s:CommandTip.Command="app.installUpdate" Click="Update_Click" />
                    <!-- The layout, as VS Code's: Customize Layout, the sidebar and the panel shown or hidden - each drawn
                         filled in while it is shown (UpdateLayoutButtons). -->
                    <Button Style="{StaticResource LayoutButton}" ToolTip="Customize Layout…" s:CommandTip.Command="layout.customize"
                            Click="CustomizeLayout_Click">
                        <Path Data="M1.5,2.5 H14.5 V13.5 H1.5 Z M6,2.5 V13.5 M6,8.5 H14.5" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="SidebarToggle" Style="{StaticResource LayoutButton}" s:CommandTip.Command="view.toggleSidebar" Click="ToggleSidebar_Click">
                        <Grid x:Name="SidebarIcon" Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                            <Path x:Name="SidebarIconFill" Data="M1.5,2.5 H6 V13.5 H1.5 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Path Data="M1.5,2.5 H14.5 V13.5 H1.5 Z M6,2.5 V13.5" StrokeThickness="1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="PanelToggle" Style="{StaticResource LayoutButton}" s:CommandTip.Command="panel.toggle" Click="TogglePanel_Click">
                        <Grid Width="16" Height="16">
                            <Path x:Name="PanelIconFill" Data="M1.5,9.5 H14.5 V13.5 H1.5 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Path Data="M1.5,2.5 H14.5 V13.5 H1.5 Z M1.5,9.5 H14.5" StrokeThickness="1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                    </Button>
                    <Border Width="1" Height="16" Margin="6,0" Background="{DynamicResource SidebarDivider}" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize"
                            Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
                </StackPanel>
                <StackPanel x:Name="TitleLeft" Orientation="Horizontal" Margin="12,0,0,0" HorizontalAlignment="Left">
                    <Image Source="pack://application:,,,/DnnManager;component/src/DnnManager.Presentation/Assets/dnn.ico"
                           Width="16" Height="16" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="DNN Manager" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TextCaption}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
            </Grid>
        </Border>

        <!-- Along the bottom, like Docker Desktop: IIS under the sidebar (as wide as it - ApplySidebarWidth), then this
             PC's resources, the running operation and the version. Hidden from Customize Layout. -->
        <DockPanel x:Name="StatusRow" Grid.Row="2">
            <c:IisStatus x:Name="IisStatus" DockPanel.Dock="Left" />
            <c:StatusBar x:Name="StatusBar" />
        </DockPanel>

        <!-- The body: the page, the splitter and the bottom panel, the sidebar beside the page - and beside the panel too,
             unless the panel reaches under it (Customize Layout's Panel Alignment). The panel is never taller than the
             body leaves room for (FitPanel). -->
        <Grid x:Name="Body" Grid.Row="1" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="PageRow" Height="*" MinHeight="60" />
            <RowDefinition x:Name="SplitterRow" Height="5" />
            <RowDefinition x:Name="LogRow" Height="230" MinHeight="90" />
        </Grid.RowDefinitions>
        <!-- The sidebar's column and the page's - which is which follows the sidebar's side (ApplyLayout). The sidebar is
             230 wide, or 48 (icons only) in a narrow window - 190 and 40 in the Compact density - see IsCompact. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="230" />
            <ColumnDefinition x:Name="RightColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: pages; at the bottom the gear's menu (Settings, Keyboard Shortcuts, Themes, Customize Layout,
             Troubleshoot…). In a narrow window only the icons (with their names as tooltips) are left. Ctrl+B hides it. -->
        <Border x:Name="Sidebar" Grid.RowSpan="3" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,1,0">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                <Button x:Name="ManageButton" Style="{StaticResource SidebarAction}" ToolTip="Manage" AutomationProperties.Name="Manage - settings, keyboard shortcuts, themes, layout"
                        Click="Manage_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;" /><TextBlock Style="{StaticResource ExpandedOnly}" Text="Settings" /></StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Margin="0,12,0,0">
                <RadioButton Style="{StaticResource SidebarNav}" GroupName="Nav" Tag="Projects" Checked="Nav_Checked" x:Name="NavProjects" ToolTip="Projects" s:CommandTip.Command="pages.projects">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE8FD;" /><TextBlock Style="{StaticResource ExpandedOnly}" Text="Projects" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SidebarNav}" GroupName="Nav" Tag="Setup" Checked="Nav_Checked" x:Name="NavSetup" ToolTip="New project" s:CommandTip.Command="pages.newProject">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE710;" /><TextBlock Style="{StaticResource ExpandedOnly}" Text="New project" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SidebarNav}" GroupName="Nav" Tag="Existing" Checked="Nav_Checked" x:Name="NavExisting" ToolTip="Host project" s:CommandTip.Command="pages.hostProject">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE838;" /><TextBlock Style="{StaticResource ExpandedOnly}" Text="Host project" /></StackPanel>
                </RadioButton>
            </StackPanel>
        </DockPanel>
        </Border>

        <!-- The page of the sidebar entry chosen. -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False" />

        <GridSplitter x:Name="LogSplitter" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource CardBorder}" />

        <!-- Activity, Logs and Terminal; opened and closed with the title bar's panel button, Ctrl+J, Ctrl+` or its own ✕.
             Maximized (its button, Ctrl+Shift+M) it takes the page's room. -->
        <c:TerminalPanel x:Name="TerminalPanel" Grid.Row="2" Grid.Column="1" />
        </Grid>

        <!-- Settings and Troubleshoot open over the page, as VS Code's modal editors: the page dimmed behind them, a click
             there closes them (ShowModal / CloseModal). Between the title bar and the status bar, which still work - a
             Troubleshoot action's progress and Cancel are in the status bar. -->
        <Grid x:Name="ModalHost" Grid.Row="1" Panel.ZIndex="50" Visibility="Collapsed"
              Background="{DynamicResource ModalBackdrop}" MouseLeftButtonDown="ModalBackdrop_MouseLeftButtonDown">
            <Border x:Name="ModalBox" MaxWidth="1280" Margin="40,20,40,28" Background="{DynamicResource WindowBg}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8"
                    KeyboardNavigation.TabNavigation="Cycle" MouseLeftButtonDown="ModalBox_MouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.4" />
                </Border.Effect>
                <!-- The page's own header (its name and ✕) is the modal's. -->
                <ContentControl x:Name="ModalContent" Focusable="False" />
            </Border>
        </Grid>

        <!-- Toasts float over the bottom-right, above the status bar - over Settings too: the running operation
             (OperationToast), and under it a message (Services/Toast). -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,16" Panel.ZIndex="60">
            <c:OperationToast x:Name="OperationToast" HorizontalAlignment="Right" />
            <c:ToastView x:Name="ToastHost" HorizontalAlignment="Right" />
        </StackPanel>

        <!-- The command palette (Ctrl+P, Ctrl+Shift+P) over everything, title bar included - see MainWindow.Commands. -->
        <c:CommandPalette x:Name="Palette" Grid.RowSpan="3" Panel.ZIndex="100" />
    </Grid>
</Window>
