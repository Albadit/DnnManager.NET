<Window x:Class="DnnManager.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DnnManager.Presentation.Controls"
        Title="DNN Manager" Icon="pack://application:,,,/DnnManager;component/src/DnnManager.Presentation/Assets/dnn.ico" Width="1180" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        StateChanged="Window_StateChanged">
    <!-- The app draws its own title bar (with Settings next to the window buttons). The 1px glass
         edge keeps Windows' shadow and rounded corners. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Minimize / maximize / close. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <!-- Set from code while the pointer is over maximize (Windows 11 shows Snap layouts there). -->
                            <Trigger Property="Tag" Value="Hover">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Troubleshoot and Settings, left of the window buttons. -->
        <Style x:Key="TitleBarButton" TargetType="ButtonBase">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <!-- Troubleshoot and Settings are pages: underlined while shown. -->
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar parts only shown while it's wide (see MainWindow.IsCompact). -->
        <Style x:Key="ExpandedOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A page entry; its name shows as a tooltip only while the sidebar is icons only. -->
        <Style x:Key="SidebarNav" TargetType="RadioButton" BasedOn="{StaticResource NavItem}">
            <Setter Property="ToolTipService.IsEnabled" Value="False" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="ToolTipService.IsEnabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- 230 wide, or 56 (icons only) in a narrow window - see IsCompact. -->
            <ColumnDefinition x:Name="SidebarColumn" Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Title bar: drag it to move the window, double-click to maximize. -->
        <Border Grid.ColumnSpan="2" Height="36" Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <RadioButton x:Name="NavTroubleshoot" Style="{StaticResource TitleBarButton}" GroupName="Nav" Tag="Troubleshoot"
                                 Checked="Nav_Checked" Content="&#xEBE8;" ToolTip="Troubleshoot" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource TitleBarButton}" GroupName="Nav" Tag="Settings"
                                 Checked="Nav_Checked" Content="&#xE713;" ToolTip="Settings" />
                    <Border Width="1" Height="16" Margin="6,0" Background="{DynamicResource SidebarDivider}" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize"
                            Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                    <Image Source="pack://application:,,,/DnnManager;component/src/DnnManager.Presentation/Assets/dnn.ico"
                           Width="16" Height="16" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="DNN Manager" Foreground="{DynamicResource TextPrimary}" FontSize="{DynamicResource TextCaption}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Along the bottom, like Docker Desktop: IIS under the sidebar (as wide as it), then this PC's resources, the
             running operation, the activity switch and the version. -->
        <c:IisStatus x:Name="IisStatus" Grid.Row="2" IsCompact="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" />
        <c:StatusBar x:Name="StatusBar" Grid.Row="2" Grid.Column="1" />

        <!-- Sidebar: pages, and the projects folder at the bottom. In a narrow window only the icons (with their
             names as tooltips) are left. Hidden while Settings - a page with its own sidebar - is open. -->
        <Border x:Name="Sidebar" Grid.Row="1" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,1,0">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                <StackPanel Style="{StaticResource ExpandedOnly}">
                    <Border Height="1" Background="{DynamicResource SidebarDivider}" Margin="18,0,18,0" />
                    <StackPanel Margin="20,10,12,0">
                        <TextBlock Text="Projects folder" Foreground="{DynamicResource SidebarMuted}" FontSize="{DynamicResource TextSmall}" />
                        <TextBlock x:Name="BaseDirText" Foreground="{DynamicResource SidebarFg}" FontSize="{DynamicResource TextCaption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,12,0,0">
                <RadioButton Style="{StaticResource SidebarNav}" GroupName="Nav" Tag="Projects" Checked="Nav_Checked" x:Name="NavProjects" ToolTip="Projects">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE8FD;" /><TextBlock Style="{StaticResource ExpandedOnly}" Text="Projects" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SidebarNav}" GroupName="Nav" Tag="Setup" Checked="Nav_Checked" ToolTip="New project">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE710;" /><TextBlock Style="{StaticResource ExpandedOnly}" Text="New project" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SidebarNav}" GroupName="Nav" Tag="Existing" Checked="Nav_Checked" ToolTip="Host project">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE838;" /><TextBlock Style="{StaticResource ExpandedOnly}" Text="Host project" /></StackPanel>
                </RadioButton>
            </StackPanel>
        </DockPanel>
        </Border>

        <!-- Page + activity log (over the sidebar's column too while Settings is open) -->
        <Grid x:Name="ContentArea" Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PageRow" Height="*" MinHeight="200" />
                <RowDefinition x:Name="SplitterRow" Height="5" />
                <RowDefinition x:Name="LogRow" Height="230" MinHeight="90" />
            </Grid.RowDefinitions>

            <ContentControl x:Name="PageHost" Focusable="False" />
            <!-- Toasts (Services/Toast) float over the bottom-right of the page. -->
            <c:ToastView x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,16" Panel.ZIndex="10" />

            <GridSplitter x:Name="LogSplitter" Grid.Row="1" HorizontalAlignment="Stretch" Background="{DynamicResource CardBorder}" />

            <!-- Activity, Logs and Terminal; opened and closed with the status bar's terminal button, Ctrl+` or its own ✕.
                 Maximized (its button, Ctrl+Shift+M) it takes the page's room. -->
            <c:TerminalPanel x:Name="TerminalPanel" Grid.Row="2" />
        </Grid>
    </Grid>
</Window>
