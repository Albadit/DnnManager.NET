<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DnnManager.Core: the Domain, Application and Infrastructure layers as one library for every OS (net10.0) - the
    Windows app (DnnManager.csproj, WPF) and the cross-platform one (src/DnnManager.Desktop, Avalonia) both build on
    it. The sources stay in their own folders (src/DnnManager.Domain, .Application, .Infrastructure); this project only
    compiles them.

    What only Windows has - IIS, the hosts file, LocalDB, the registry, DPAPI, services - compiles here for every OS
    and is asked for only on Windows: OperatingSystem.IsWindows() guards each use (src/DnnManager.Application/Platform.cs).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DnnManager</RootNamespace>
    <AssemblyName>DnnManager.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CA1416 (a Windows-only API called where any OS may run it) is off here: IIS, the hosts file, LocalDB, the
         registry and DPAPI are used by the features only Windows has, and those are offered only on Windows -
         Application.Platform decides, and the cross-platform app never starts them. Code that macOS and Linux run too
         (Source Control, the settings, the data folder) checks OperatingSystem.IsWindows() itself, as UserCipher does. -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CA1416</NoWarn>
    <!-- As the apps that use it: packages.lock.json, restored in locked mode by CI and the release, for every runtime
         an app is published for - a publish (-r win-x64, -r osx-arm64) restores this project for its runtime too, and
         a lock file without it is refused. The single-file analyzer always, as DnnManager.csproj: a single-file publish
         turns it on, and with it the SDK adds Microsoft.NET.ILLink.Tasks - so a build and a publish agree. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\DnnManager.Domain\**\*.cs" Exclude="..\DnnManager.Domain\obj\**;..\DnnManager.Domain\bin\**" />
    <Compile Include="..\DnnManager.Application\**\*.cs" Exclude="..\DnnManager.Application\obj\**;..\DnnManager.Application\bin\**" />
    <Compile Include="..\DnnManager.Infrastructure\**\*.cs" Exclude="..\DnnManager.Infrastructure\obj\**;..\DnnManager.Infrastructure\bin\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The apps use what the layers keep internal, as they did when everything was one assembly. -->
    <InternalsVisibleTo Include="DnnManager" />
    <InternalsVisibleTo Include="DnnManager.Desktop" />
    <InternalsVisibleTo Include="DnnManager.IntegrationTests" />
    <InternalsVisibleTo Include="DnnManager.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" Version="55.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.Administration" Version="11.1.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <!-- DNN Manager's own data - settings, workspace, project records, keep warm - in Documents\DnnManager\dnnmanager.db. -->
    <!-- It brings SQLitePCLRaw 2.1.12 - SQLite 3.53.3, past the fix for GHSA-2m69-gcr7-jv3q (3.50.2). Upgrading it upgrades SQLite. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- The state of the IIS service (W3SVC) for the status bar - Windows only. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
    <!-- DPAPI, which keeps the deploy secrets on Windows (DeployStore); WPF's framework brought it before. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <!-- Windows' performance counters (an app pool's worker processes) and power events (sleep and resume) - Windows only. -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.12" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.12" />
    <!-- SqlClient brings Pkcs 9.0.11 - GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx, fixed in 10.0.13. The Windows
         Desktop framework gave its own before; outside it, a fixed version is asked for here. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
