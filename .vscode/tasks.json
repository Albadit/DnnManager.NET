{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "detail": "Windows app, Debug",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/DnnManager.csproj"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Build: Release",
            "detail": "Windows app, as a release",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/DnnManager.csproj",
                "-c",
                "Release"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Clean",
            "detail": "Remove bin and obj",
            "type": "process",
            "command": "dotnet",
            "args": [
                "clean",
                "${workspaceFolder}/DnnManager.csproj"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            // Builds DNN Manager on this PC into publish\: pick Portable or Setup, then tick Windows, macOS and/or Linux.
            // Windows: DnnManager-<version>-x64.exe or DnnManager_Setup-<version>-x64.exe (without Visual Studio's
            // C++ build tools, Setup leaves the launcher out - fine to try out, never for a release). macOS and Linux:
            // the cross-platform app - portable from any system, its packages (.app zip, tar.gz) only on a Mac or Linux.
            // .github/scripts/publish-local.ps1, see .docs/releasing.md.
            "label": "Publish",
            "detail": "Portable or Setup, per OS",
            "type": "process",
            "command": "powershell",
            "osx": { "command": "pwsh" },
            "linux": { "command": "pwsh" },
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.github/scripts/publish-local.ps1",
                "-Kind",
                "${input:publishKind}",
                "-Platforms",
                "${input:publishPlatforms}"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            // A portable exe one version below GitHub's newest release (1.6.0 -> 1.5.9), so its Update button installs
            // that release: publish\update-test\DnnManager-<version>-x64.exe. See .docs/releasing.md, The in-app update.
            "label": "Publish: update test",
            "detail": "One version below the latest release",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.github/scripts/build-update-test.ps1"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            // Pick .docs/release-notes/vX.Y.Z.md (its name is the tag and the title), a commit on GitHub, the release label
            // as GitHub names it (None, Pre-release, Latest) and the platforms to build (Windows, macOS, Linux - tick one
            // or more); runs the fast tests on that commit and, after you confirm, pushes the tag with the label and the
            // platforms in its message - GitHub's release workflow (.github/workflows/release.yml) builds what was chosen,
            // attests it and publishes the release with that label. See .docs/releasing.md.
            // The notes, commit and platform pickers are filled by the extension Tasks Shell Input (augustocdias.tasks-shell-input).
            "label": "Release",
            "detail": "Tag a version, GitHub publishes it",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.github/scripts/publish-release.ps1",
                "-NotesFile",
                "${input:releaseNotes}",
                "-Commit",
                "${input:releaseCommit}",
                "-Label",
                "${input:releaseLabel}",
                "-Platforms",
                "${input:releasePlatforms}"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            }
        },
        {
            // Moves the repository to the newest .NET SDK: installs it with winget when this PC doesn't have it, puts it
            // in global.json and updates the lock files with it - then commit and push. See .docs/releasing.md.
            "label": "Update .NET SDK",
            "detail": "Newest SDK and lock files",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.github/scripts/update-sdk.ps1",
                "-Install"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            }
        },
        {
            // Redo the newest release whose tag is made but which isn't published (a published one is refused): pick
            // the commit to release it from (the branch's commits since the tag's, newest first) - the tag is deleted
            // and made again there; nothing is amended or pushed. The label and the platforms are the old tag's ("As
            // before"), or chosen again. Shows the plan and asks before changing anything. See .docs/releasing.md.
            "label": "Release: redo",
            "detail": "Tag an unpublished release again",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.github/scripts/redo-release.ps1",
                "-Commit",
                "${input:redoCommit}",
                "-Label",
                "${input:redoLabel}",
                "-Platforms",
                "${input:redoPlatforms}"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            }
        }
    ],
    "inputs": [
        {
            "id": "publishKind",
            "type": "pickString",
            "description": "What to build",
            "options": [
                { "label": "Portable - one program, nothing to install", "value": "portable" },
                { "label": "Setup - the installer (Windows), the .app zip (macOS), the tar.gz (Linux)", "value": "setup" }
            ],
            "default": "portable"
        },
        {
            "id": "publishPlatforms",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "powershell",
                "commandArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.github/scripts/publish-local.ps1", "-List", "platforms"],
                "cwd": "${workspaceFolder}",
                "fieldSeparator": "||",
                "description": "Platforms to build for - tick one or more",
                "multiselect": true,
                "multiselectSeparator": ",",
                "warnOnStderr": false
            }
        },
        {
            "id": "releaseNotes",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "powershell",
                "commandArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.github/scripts/publish-release.ps1", "-List", "notes"],
                "cwd": "${workspaceFolder}",
                "fieldSeparator": "||",
                "description": "Release notes to publish - the file name is the tag and the release title",
                "warnOnStderr": false
            }
        },
        {
            "id": "releaseLabel",
            "type": "pickString",
            "description": "Release label - Latest is what every DNN Manager's Update button offers",
            "options": [
                { "label": "None - published, but not the latest", "value": "none" },
                { "label": "Pre-release - label it as not ready for production", "value": "prerelease" },
                { "label": "Latest - label it as the latest for this repository", "value": "latest" }
            ],
            "default": "latest"
        },
        {
            "id": "releasePlatforms",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "powershell",
                "commandArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.github/scripts/publish-release.ps1", "-List", "platforms"],
                "cwd": "${workspaceFolder}",
                "fieldSeparator": "||",
                "description": "Platforms to build - tick one or more",
                "multiselect": true,
                "multiselectSeparator": ",",
                "warnOnStderr": false
            }
        },
        {
            "id": "releaseCommit",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "powershell",
                "commandArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.github/scripts/publish-release.ps1", "-List", "commits"],
                "cwd": "${workspaceFolder}",
                "fieldSeparator": "||",
                "description": "Commit to release (newest on GitHub first)",
                "warnOnStderr": false
            }
        },
        {
            "id": "redoCommit",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "powershell",
                "commandArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.github/scripts/redo-release.ps1", "-List", "commits"],
                "cwd": "${workspaceFolder}",
                "fieldSeparator": "||",
                "description": "Commit to redo the newest release from (newest first)",
                "warnOnStderr": false
            }
        },
        {
            "id": "redoLabel",
            "type": "pickString",
            "description": "Release label of the redone release",
            "options": [
                { "label": "As before - the old tag's", "value": "same" },
                { "label": "None - published, but not the latest", "value": "none" },
                { "label": "Pre-release - label it as not ready for production", "value": "prerelease" },
                { "label": "Latest - label it as the latest for this repository", "value": "latest" }
            ],
            "default": "same"
        },
        {
            "id": "redoPlatforms",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "powershell",
                "commandArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.github/scripts/redo-release.ps1", "-List", "platforms"],
                "cwd": "${workspaceFolder}",
                "fieldSeparator": "||",
                "description": "Platforms to build - As before, or tick one or more",
                "multiselect": true,
                "multiselectSeparator": ",",
                "warnOnStderr": false
            }
        }
    ]
}
