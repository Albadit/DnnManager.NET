{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (Debug)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/DnnManager.csproj"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "build (Release)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/DnnManager.csproj",
                "-c",
                "Release"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "clean",
            "type": "process",
            "command": "dotnet",
            "args": [
                "clean",
                "${workspaceFolder}/DnnManager.csproj"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "publish (DnnManager_Portable.exe)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "publish",
                "${workspaceFolder}/DnnManager.csproj",
                "-c",
                "Release",
                "-r",
                "win-x64",
                "--self-contained",
                "true",
                "-p:PublishSingleFile=true",
                "-p:IncludeNativeLibrariesForSelfExtract=true",
                "-p:EnableCompressionInSingleFile=true",
                "-p:PortableExe=true",
                "-o",
                "${workspaceFolder}/publish"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "installer (DnnManager_Setup.exe)",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/src/DnnManager.Installer/build.ps1"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            // DNN Manager as an MSIX package (the release's kind: it elevates as Setup's does), signed with a self-signed
            // test certificate (CurrentUser\My): publish\DnnManager_<version>_x64.msix. See .docs/releasing.md, The MSIX package.
            "label": "package (DnnManager.msix, test-signed)",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/src/DnnManager.Package/build.ps1",
                "-TestCertificate"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            // A portable exe one version below GitHub's newest release (1.6.0 -> 1.5.9), so its Update button installs
            // that release: publish\update-test\DnnManager_Portable-<version>-x64.exe. See .docs/releasing.md, The in-app update.
            "label": "publish (update test, one version below the release)",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.github/scripts/build-update-test.ps1"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            // Pick .docs/release-notes/vX.Y.Z.md (its name is the tag and the title) and a commit on GitHub; builds both
            // exes for that commit and, after you confirm, tags it and publishes the GitHub release. See .docs/releasing.md.
            // The two pickers are filled fresh each time by the extension Tasks Shell Input (augustocdias.tasks-shell-input).
            "label": "release (GitHub)",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.github/scripts/publish-release.ps1",
                "-NotesFile",
                "${input:releaseNotes}",
                "-Commit",
                "${input:releaseCommit}"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            }
        },
        {
            // Pick a release on GitHub (made by "release (GitHub)"); builds its MSIX package from the release's tag, signed with
            // the certificate in DNNMANAGER_SIGNING_THUMBPRINT, and after you confirm uploads it to that release.
            // See .docs/releasing.md, The MSIX package.
            "label": "release: MSIX (GitHub)",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.github/scripts/publish-msix.ps1",
                "-Tag",
                "${input:msixRelease}"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            }
        },
        {
            // Redo a release whose tag is made: folds your changes into the release commit (amend, push), deletes the
            // tag and its GitHub release, and releases it again. Asks for the version (Enter = the newest tag) and the
            // commit message in the terminal, shows the plan and asks before changing anything. See .docs/releasing.md.
            "label": "release: redo (GitHub)",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/.github/scripts/redo-release.ps1"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            }
        }
    ],
    "inputs": [
        {
            "id": "releaseNotes",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "powershell",
                "commandArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.github/scripts/publish-release.ps1", "-List", "notes"],
                "cwd": "${workspaceFolder}",
                "fieldSeparator": "||",
                "description": "Release notes to publish - the file name is the tag and the release title",
                "warnOnStderr": false
            }
        },
        {
            "id": "releaseCommit",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "powershell",
                "commandArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.github/scripts/publish-release.ps1", "-List", "commits"],
                "cwd": "${workspaceFolder}",
                "fieldSeparator": "||",
                "description": "Commit to release (newest on GitHub first)",
                "warnOnStderr": false
            }
        },
        {
            "id": "msixRelease",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "powershell",
                "commandArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/.github/scripts/publish-msix.ps1", "-List", "releases"],
                "cwd": "${workspaceFolder}",
                "fieldSeparator": "||",
                "description": "Release to add the MSIX package to (newest first)",
                "warnOnStderr": false
            }
        }
    ]
}
