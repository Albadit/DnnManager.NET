<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DnnManager</RootNamespace>
    <AssemblyName>DnnManager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>src\DnnManager.Presentation\Assets\dnn.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <!-- The version is the newest release's: see VersionFromGitTag below. A release passes its own (-p:Version). -->
    <VersionFromGitTag Condition="'$(Version)' == ''">true</VersionFromGitTag>
    <!-- Publishing for a runtime (e.g. -r win-x64) precompiles the code (ReadyToRun), so the app starts without
         JIT-compiling everything first. Plain builds and dotnet run are unaffected. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <!-- Program.Main builds the DI host before starting WPF, so App.xaml is a plain Page. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <!-- The packages restored are the ones in packages.lock.json, with their hashes - CI restores in locked mode. The
         runtime the release is published for is in it too. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- The single-file analyzer always: a single-file publish (the portable exe) turns it on, and with it the SDK adds
         Microsoft.NET.ILLink.Tasks to the restore - on for every restore, a build and a publish agree on
         packages.lock.json, and single-file problems show while building. -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- DOTNET_STARTUP_HOOKS is read from the environment - which any program of the user can set - and would load an
         assembly into DNN Manager, which runs with administrator rights. Off in what is shipped; a Debug build keeps
         it for Hot Reload. -->
    <StartupHookSupport Condition="'$(Configuration)' == 'Release'">false</StartupHookSupport>
    <!-- The compiler reads the XML comments: one that documents nothing (CS1587 - left above an attribute or a
         statement) is a warning, and CI builds with warnings as errors. A public member without a comment (CS1591)
         or a comment that names only some parameters (CS1573) isn't one. The .xml file is only for the build - it
         isn't published, so it never reaches Setup. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF drops these two from the implicit usings (name clashes with WPF types); the other layers rely on them. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests and the launcher are projects of their own (tests\DnnManager.IntegrationTests,
         src\DnnManager.Launcher) - not part of the app. -->
    <Compile Remove="tests\**;src\DnnManager.Launcher\**" />
    <Page Remove="tests\**;src\DnnManager.Launcher\**" />
    <None Remove="tests\**;src\DnnManager.Launcher\**" />
    <EmbeddedResource Remove="tests\**;src\DnnManager.Launcher\**" />
    <InternalsVisibleTo Include="DnnManager.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The DNN mark: the exe's icon (ApplicationIcon above) and every window's title-bar icon. -->
    <Resource Include="src\DnnManager.Presentation\Assets\dnn.ico" />
    <!-- Each release's notes, as GitHub shows them - "What's new" after an update reads them from here, offline too
         (src/DnnManager.Presentation/Services/ReleaseNotes.cs). -->
    <EmbeddedResource Include=".docs\release-notes\v*.md" LogicalName="ReleaseNotes.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.Administration" Version="11.1.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <!-- DNN Manager's own data - settings, workspace, project records, keep warm - in Documents\DnnManager\dnnmanager.db. -->
    <!-- It brings SQLitePCLRaw 2.1.12 - SQLite 3.53.3, past the fix for GHSA-2m69-gcr7-jv3q (3.50.2); 10.0.10 and older
         brought 2.1.11, which DNN Manager pinned over until then. Upgrading it upgrades SQLite. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- The state of the IIS service (W3SVC) for the status bar. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
  </ItemGroup>

  <!-- The version of a local build: the newest version tag (v1.7.1 -> 1.7.1) reachable from the commit built - the
       GitHub release it is, or comes after - so there is no version number to raise by hand. The release workflow
       and the VS Code release task pass the tag's version instead (-p:Version), which skips this. Without git or a
       tag (e.g. a source zip) the build is 0.0.0 - with a warning. -->
  <Target Name="VersionFromGitTag" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;RenamePortableExe" Condition="'$(VersionFromGitTag)' == 'true'">
    <Exec Command="git describe --tags --abbrev=0 --match &quot;v[0-9]*&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitVersionTag" />
      <Output TaskParameter="ExitCode" PropertyName="_GitVersionExitCode" />
    </Exec>
    <PropertyGroup>
      <_GitVersion>0.0.0</_GitVersion>
      <_GitVersion Condition="'$(_GitVersionExitCode)' == '0' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitVersionTag)', '^v\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?$'))">$(_GitVersionTag.Substring(1))</_GitVersion>
      <Version>$(_GitVersion)</Version>
    </PropertyGroup>
    <Warning Condition="'$(Version)' == '0.0.0'" Text="No version tag (v1.2.3) found with git - this build is version 0.0.0." />
  </Target>

  <!-- Nothing but the program is published: the settings are created in Documents\DnnManager\dnnmanager.db on first
       run (src/DnnManager.Infrastructure/Settings). -->

  <!-- Portable publish (-p:PortableExe=true, used by the VS Code publish task): the single-file exe is renamed
       DnnManager_Portable-<version>-<arch>.exe, e.g. DnnManager_Portable-1.7.7-x64.exe. Only the file is renamed - the assembly
       stays DnnManager, which the XAML pack URIs refer to. The installer's publish keeps DnnManager.exe. -->
  <Target Name="RenamePortableExe" AfterTargets="Publish" Condition="'$(PortableExe)' == 'true'">
    <PropertyGroup>
      <PortableArch>$(RuntimeIdentifier.Replace('win-', ''))</PortableArch>
      <PortableExePath>$(PublishDir)DnnManager_Portable-$(Version)-$(PortableArch).exe</PortableExePath>
    </PropertyGroup>
    <Error Condition="'$(PublishSingleFile)' != 'true'" Text="PortableExe=true needs a single-file publish (-p:PublishSingleFile=true)." />
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PortableExePath)" />
    <Delete Files="$(PublishDir)$(AssemblyName).exe" />
    <Message Importance="high" Text="Portable exe: $([System.IO.Path]::GetFullPath('$(PortableExePath)'))" />
  </Target>

</Project>
